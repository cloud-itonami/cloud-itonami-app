#!/usr/bin/env bash
set -euo pipefail

# Opens the web surface as an application window.
#
# There used to be a second surface here: a kotoba/dom program rendered by the
# kotoba-lang/shell AppKit host and styled with liquid-glass. It was retired on
# 2026-08-06, because it had become the older of the two user interfaces while
# remaining the one this launcher preferred — so running the app showed the
# older one. The web surface, built on jp-go-dds, is the only surface now.
# kotoba-lang/shell remains a dependency for EventKit and Keychain.
#
# The server is usually already resident under launchd (dev.cloud-itonami.app,
# out of ~/.cloud-itonami/app). A second one only loses the bind on 1338, so
# this starts one only when nothing answers.

app_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
url="http://localhost:1338/"
server_pid=""

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

healthy() { curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1; }

open_window() {
  local chrome="/Applications/Google Chrome.app"
  # An app-mode window has no tab strip and no address bar, so the surface owns
  # the whole frame. The fallback still shows the same page.
  if [[ -d "$chrome" ]]; then
    open -na "$chrome" --args --app="$url" --new-window
  else
    open "$url"
  fi
}

cd "$app_dir"

if healthy; then
  printf 'Using the server already listening on 1338.\n'
  open_window
  exit 0
fi

clojure -M:server >target-server.log 2>&1 &
server_pid=$!

for _ in {1..300}; do
  if healthy; then
    open_window
    wait "$server_pid"
    exit 0
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    printf 'cloud-itonami-app server failed to start; see %s/target-server.log\n' \
      "$app_dir" >&2
    exit 1
  fi
  sleep 0.1
done

printf 'cloud-itonami-app server did not become healthy\n' >&2
exit 1
