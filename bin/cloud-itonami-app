#!/usr/bin/env bash
set -euo pipefail

# Opens the web surface in the native application window.
#
# What the window is called, what it shows in the Dock and how large it opens
# are declared in app.kotoba.edn and nowhere else. This file decides only
# whether a server needs starting first.
#
# There used to be a second surface: a kotoba/dom program rendered by the same
# AppKit host and styled with liquid-glass. It was retired on 2026-08-06,
# because it had become the older of the two user interfaces while remaining the
# one this launcher preferred — so running the app showed the older one. The web
# surface, built on jp-go-dds, is the only surface now; the native host carries
# it, which is also where EventKit and Keychain come from.
#
# The server is usually already resident under launchd (dev.cloud-itonami.app,
# out of ~/.cloud-itonami/app). A second one only loses the bind on 1338, so
# this starts one only when nothing answers.

app_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
url="http://localhost:1338/"
server_pid=""

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

healthy() { curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1; }

shell_dir="${CLOUD_ITONAMI_SHELL_DIR:-}"
if [[ -z "$shell_dir" && -d "$app_dir/../../kotoba-lang/shell" ]]; then
  shell_dir="$(CDPATH= cd -- "$app_dir/../../kotoba-lang/shell" && pwd)"
fi
if [[ -z "$shell_dir" && -n "${CLOUD_ITONAMI_WORKSPACE_ROOT:-}" &&
      -d "$CLOUD_ITONAMI_WORKSPACE_ROOT/orgs/kotoba-lang/shell" ]]; then
  shell_dir="$(CDPATH= cd -- \
    "$CLOUD_ITONAMI_WORKSPACE_ROOT/orgs/kotoba-lang/shell" && pwd)"
fi

# Read-only launcher diagnosis. This deliberately happens before server or GUI
# startup so packaging and LaunchAgent checks can verify the exact shell the
# launcher resolved without opening a window.
if [[ "${1:-}" == "--print-shell-dir" ]]; then
  printf '%s\n' "$shell_dir"
  exit 0
fi

open_window() {
  # The native host is the application window: app.kotoba.edn gives it the name,
  # the icon and the window, so the Dock shows Cloud Itonami rather than a
  # browser. The manifest is the only place any of that is written down.
  if [[ -n "$shell_dir" && -x "$shell_dir/bin/kotoba-shell" ]]; then
    "$shell_dir/bin/kotoba-shell" app run --target macos \
      --manifest "$app_dir/app.kotoba.edn" --execute
    return
  fi
  # Without a shell checkout the surface is still reachable, but as a browser
  # window: same page, no application identity.
  printf 'kotoba-lang/shell not found; opening %s in the browser instead.\n' "$url"
  local chrome="/Applications/Google Chrome.app"
  if [[ -d "$chrome" ]]; then
    open -na "$chrome" --args --app="$url" --new-window --window-size=1100,760
  else
    open "$url"
  fi
}

cd "$app_dir"

if healthy; then
  printf 'Using the server already listening on 1338.\n'
  open_window
  exit 0
fi

# nbb host adapter. The leftover JVM server alias is not the run path.
if ! command -v nbb >/dev/null 2>&1; then
  printf 'cloud-itonami-app: nbb is required to start the host adapter\n' >&2
  exit 127
fi
nbb --classpath bin "$app_dir/bin/cloud-itonami-server" >target-server.log 2>&1 &
server_pid=$!

for _ in {1..300}; do
  if healthy; then
    open_window
    wait "$server_pid"
    exit 0
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    printf 'cloud-itonami-app server failed to start; see %s/target-server.log\n' \
      "$app_dir" >&2
    exit 1
  fi
  sleep 0.1
done

printf 'cloud-itonami-app server did not become healthy\n' >&2
exit 1
