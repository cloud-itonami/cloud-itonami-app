#!/usr/bin/env bash
set -euo pipefail

app_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
shell_dir="${CLOUD_ITONAMI_SHELL_DIR:-}"
if [[ -z "$shell_dir" && -d "$app_dir/../../kotoba-lang/shell" ]]; then
  shell_dir="$(CDPATH= cd -- "$app_dir/../../kotoba-lang/shell" && pwd)"
fi
server_pid=""

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

cd "$app_dir"
clojure -M:server >target-server.log 2>&1 &
server_pid=$!
server_ready=0

for _ in {1..300}; do
  if curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1; then
    server_ready=1
    break
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    printf 'cloud-itonami-app server failed to start\n' >&2
    exit 1
  fi
  sleep 0.1
done
if [[ "$server_ready" -ne 1 ]]; then
  printf 'cloud-itonami-app server did not become healthy\n' >&2
  exit 1
fi

export KOTOBA_SHELL_APP_DIR="$app_dir"
export KOTOBA_SHELL_MANIFEST="$app_dir/app.kotoba.edn"
export KOTOBA_SHELL_ACTION_BIN="$app_dir/bin/cloud-itonami-app-action"
export KOTOBA_SHELL_TITLE="Cloud Itonami"
export KOTOBA_SHELL_WIDTH=760
export KOTOBA_SHELL_HEIGHT=820
export KOTOBA_SHELL_WEB_URL="http://localhost:1338/"
if [[ -n "$shell_dir" && -x "$shell_dir/bin/kotoba-shell-app-runtime" ]]; then
  "$shell_dir/bin/kotoba-shell-app-runtime"
else
  printf 'Native shell not found; opening http://localhost:1338 in the browser.\n'
  open http://localhost:1338/
  wait "$server_pid"
fi
