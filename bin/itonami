(register-slash!
 "/handoff" "<to> <task>" "別 Bot への引き継ぎ"
 (fn [args _]
   (let [to (first args) task (str/join " " (rest args))]
     (if (or (str/blank? (str to)) (str/blank? task))
       (do (println "使い方: /handoff <to-bot-id> <task>") :handled)
       (request-or-refuse!
        {:method :post :path (str "/api/agent-bots/" to "/handoff")
         :body {:to to :task task} :timeout-seconds 660}
        (fn [body] (println (pr-edn body))))))))

(register-slash!
 "/tools" "[term …]" "MCP tool 一覧 / 検索"
 (fn [args _]
   (-> (request! {:method :post :path "/mcp"
                  :body {:jsonrpc "2.0" :id 1 :method "tools/list" :params {}}
                  :headers {"accept" "application/json, text/event-stream"}
                  :timeout-seconds 15}
                 (require-token!))
       (.then (fn [{:keys [body]}]
                (let [tools (get-in body [:result :tools] [])
                      match? (fn [{:keys [name description]}]
                               (or (empty? args)
                                   (some #(str/includes?
                                           (str/lower-case (str name " " description))
                                           (str/lower-case %))
                                         args)))]
                  (if (empty? tools)
                    (println (str "MCP tool が取得できません: " (pr-edn body)))
                    (doseq [{:keys [name description] :as t} tools
                            :when (match? t)]
                      (println (str "  " name " — " (or description ""))))))))
       (.catch (fn [e] (println (str "error: " (ex-message e))))))))

;; --- the REPL's own knobs ------------------------------------------------

(defn- toggle! [a label args]
  (let [v (case (some-> args first str/lower-case)
            "on" true "off" false (not @a))]
    (reset! a v)
    (println (str label ": " (if v "on" "off")))
    :handled))

(register-slash! "/verbose" "[on|off]" "tool 進捗の表示切替"
                 (fn [args _] (toggle! (:verbose ctx-chat) "verbose" args)))
(register-slash! "/timestamps" "[on|off]" "時刻表示の切替"
                 (fn [args _] (toggle! (:timestamps ctx-chat) "timestamps" args)))

(register-slash!
 "/retry" "" "直前の入力を再送"
 (fn [_ _]
   (let [prev @(:last-input ctx-chat)]
     (if (str/blank? (str prev))
       (do (println "再送できる直前の入力がありません") :handled)
       :resend))))

(register-slash!
 "/prompt" "[message …]" "$EDITOR で入力して送信"
 (fn [args _]
   (let [editor (or (some-> (aget js/process.env "ITONAMI_PROMPT_EDITOR") str/trim not-empty)
                    (some-> (aget js/process.env "VISUAL") str/trim not-empty)
                    (some-> (aget js/process.env "EDITOR") str/trim not-empty)
                    "vi")
         tmp (path/join (os/tmpdir) (str "itonami-prompt-" (js/Date.now) ".md"))
         prefill (str/join " " args)]
     (fs/writeFileSync tmp (if (str/blank? prefill) "" (str prefill "\n")))
     (cp/spawnSync editor (clj->js [tmp]) #js {:stdio "inherit"})
     (let [text (str/trim (str (slurp-file tmp)))]
       (try (fs/unlinkSync tmp) (catch :default _ nil))
       (if (str/blank? text)
         (do (println "空のまま終了しました") :handled)
         (do (reset! (:last-input ctx-chat) text) :resend))))))

(register-slash!
 "/hermes" "" "hermes の import 元 (~/.hermes) を見る"
 (fn [_ _]
   (let [home (or (some-> (aget js/process.env "HERMES_HOME") str/trim not-empty)
                  (path/join (os/homedir) ".hermes"))
         skills (path/join home "skills")]
     (println (str "hermes home: " home))
     (println (str "  config.yaml: "
                   (if (fs/existsSync (path/join home "config.yaml")) "あり" "なし")))
     (if (fs/existsSync skills)
       (let [es (fs/readdirSync skills)]
         (println (str "  skills: " (count es) " エントリ"))
         (doseq [e (take 10 es)] (println (str "    - " e))))
       (println "  skills: なし"))
     :handled)))


;; ---------------------------------------------------------------------------
;; the start screen (ADR-2609062240)
;; ---------------------------------------------------------------------------

(defn- tty? []
  (boolean (.-isTTY js/process.stdout)))

(defn- colour? []
  (and (tty?)
       (str/blank? (str (aget js/process.env "NO_COLOR")))
       (not= "dumb" (aget js/process.env "TERM"))))

(defn- session-origin
  "Where the session token came from, or that there is none.

  `auth login` writes the Keychain and the environment variable overrides it.
  An operator who cannot see which one answered cannot tell a stale export
  from a fresh login -- the two produce an identical working CLI right up to
  the moment the exported one expires."
  []
  (let [env-name (or (get-in configuration [:mcp :session-token-env])
                     "CLOUD_ITONAMI_MCP_SESSION")]
    (cond
      (not (str/blank? (str (aget js/process.env env-name)))) env-name
      (keychain-get) (str "keychain " keychain-service)
      :else "なし — itonami auth login")))

(defn- print-splash!
  "The start screen, then the two facts that had to be measured to be said.

  The frame is drawn from tables this process already read; `/health` is one
  request with a short timeout. It is awaited rather than printed late,
  because a warning that arrives after the prompt lands in the middle of the
  operator's first line. Resolves once the screen is written."
  []
  (-> (health)
      (.then
       (fn [h]
         (let [colour (colour?)
               cmds (commands/all)
               aliases (commands/alias-commands)
               slash ((:commands ctx-chat))
               warn (fn [text] (println (splash/paint colour "38;5;203" text)))]
           (println
            ((:render ctx-splash)
             {:color? colour
              :columns (or (.-columns js/process.stdout) 88)
              :version app-version
              :base-url (base-url)
              :profile @chat-profile
              :profile-source (profile-source)
              :cwd (js/process.cwd)
              :home home-directory
              :session (session-origin)
              :groups (splash/summarise cmds 5)
              :named (splash/summarise aliases 3)
              :slash ((:commands ctx-chat))
              ;; joined by the skin's accent glyph inside the splash, so
              ;; the separator is one the theme owns
              :counts [(str (count cmds) " commands")
                       (str (count aliases) " named")
                       (str (count slash) " slash")
                       "/help for commands"]}))
           ;; Below the frame: a glyph whose width a terminal disagrees about
           ;; cannot push a border off down here, and these two lines are the
           ;; ones an operator acts on.
           (if (:answering? h)
             (println (splash/paint colour splash/dim-code
                                    (str "· server: answering · store: "
                                         (or (get-in h [:health :store]) "?"))))
             (warn (str "! server が応答しません: " (base-url)
                        " — 常駐: launchctl kickstart -k gui/$(id -u)/dev.cloud-itonami.app")))
           (when-not (session-token)
             (warn "! agent session がありません — itonami auth login"))
           (println)
           (println (splash/paint colour splash/accent-code
                                  "Itonami へようこそ。メッセージを入力するか /help を打ってください。"))
           (println (splash/paint colour splash/dim-code
                                  (str "Tip: 対話先の Bot はリポジトリの .itonami/profile.edn が選びます"
                                       " (itonami profile explain)")))
           (println))))
      (.catch (fn [e]
                ;; The screen is decoration; failing to draw it must not cost
                ;; the operator their REPL. Say what happened and continue.
                (err (str "itonami: start screen を描けませんでした: " (ex-message e)))))))


(defn- chat-repl!
  "The prompt loop: one message per turn, each on its own run, streaming
  deltas. A line beginning with `/` is a command (see chat-slash!)."
  []
  (let [rl (js/require "node:readline/promises")
        iface (.createInterface rl #js {:input js/process.stdin
                                        :output js/process.stdout})
        prompt (fn [] (str ((:stamp ctx-chat)) (:prompt ((:skin ctx-theme)))))
        ;; Ctrl+D rejects the pending question. That is how a REPL is left,
        ;; and letting the rejection go unhandled -- which is what happened
        ;; here until the argless entry made Ctrl+D the ordinary way out --
        ;; printed an AbortError and an nbb stack trace over the operator's
        ;; last screen, reporting a crash where nothing had gone wrong.
        ask (fn []
              (-> (.question iface (prompt))
                  (.catch (fn [_] (println) (js/process.exit exit-answered)))))
        closed? (fn [e] (= "readline was closed" (ex-message e)))]
    (letfn [(die [e]
              (if (closed? e)
                (js/process.exit exit-answered)
                (do (chat-emit (str "error: " (ex-message e) "\n"))
                    (js/process.exit exit-cannot-answer))))

            (send! [text]
              ;; Remembered before the run starts, so /retry can resend a turn
              ;; that failed -- which is the turn most worth resending.
              (reset! (:last-input ctx-chat) text)
              (-> (request! {:method :post :path "/v1/runs"
                             :body {:input text :profile @chat-profile}
                             :timeout-seconds 30}
                            (require-token!))
                  (.then (fn [{:keys [status body]}]
                           (if (<= 200 status 299)
                             (chat-poll-events! (or (:run_id body) (:run-id body)))
                             (refuse! (str "run を開始できません: HTTP " status)
                                      (select-keys body [:error])))))
                  (.then (fn [out]
                           (when-let [usage (:usage out)]
                             (chat-emit (str "· tokens: "
                                             (or (:prompt_tokens usage) "?") " in / "
                                             (or (:completion_tokens usage) "?") " out")))
                           (println)
                           ;; A failed turn is a refusal, not a prompt for the
                           ;; next one.
                           (if (= "completed" (:status out))
                             (turn)
                             (js/process.exit exit-refused))))
                  (.catch die)))

            (act [r text]
              (cond
                (= :exit r) (js/process.exit exit-answered)
                (= :handled r) (turn)
                ;; /retry and /prompt: the command decided what to send, and
                ;; left it where the next turn reads it.
                (= :resend r) (let [prev (str @(:last-input ctx-chat))]
                                (if (str/blank? prev)
                                  (turn)
                                  (do (println (str "↻ " (subs prev 0 (min 120 (count prev)))))
                                      (send! prev))))
                (instance? js/Promise r)
                (-> r (.then (fn [v] (if (keyword? v) (act v text) (turn)))) (.catch die))
                :else (send! text)))

            (turn []
              (-> (ask)
                  (.then (fn [line]
                           (let [text (str/trim (str line))]
                             (cond
                               (empty? text) (turn)
                               (contains? #{"exit" "quit"} text)
                               (js/process.exit exit-answered)
                               :else (act (chat-slash! text) text)))))))]
      (turn))))

(defn- chat-prompt-loop!
  "Open the REPL: resolve the profile, draw the start screen, then prompt."
  []
  ;; The REPL resolves its starting profile the same way the one-shot entry
  ;; does. Without this the screen would print `default` while `itonami chat
  ;; "..."` in the same directory used the repository's -- one command, two
  ;; answers, and the screen would be the one that lied.
  (when-let [id (or (some-> (aget js/process.env "ITONAMI_PROFILE") str/trim not-empty)
                    (:profile/id (repo-profile!)))]
    (reset! chat-profile id))
  ;; The start screen is for a terminal. Under a pipe there is nobody to read
  ;; a frame, the width is a guess, and the colour would be bytes in somebody's
  ;; log -- so that case keeps the one line it had.
  (if (tty?)
    (-> (print-splash!) (.then chat-repl!))
    (do (println (str (:banner ((:skin ctx-theme)))
                      "  profile: " @chat-profile " (" (profile-source) ")"
                      " — /help で一覧、exit で終了"))
        (chat-repl!))))

(defn- chat!
  "Entry: `itonami chat [--profile <p>] [first message]`. A message on the
  command line runs one turn and exits; without one, the REPL starts."
  [argv json?]
  (let [profile (or (some-> (:profile (commands/parse-flags argv)) str/trim not-empty)
                    (some-> (aget js/process.env "ITONAMI_PROFILE") str/trim not-empty)
                    (:profile/id (repo-profile!))
                    chat-default-profile)
        words (commands/words (drop 1 (drop-while #(not= "chat" %) argv)))
        text (str/join " " words)]
    (if (seq words)
      ;; one-shot: `itonami chat hello` runs one streaming turn and exits
      (let [start! (fn []
                     (request! {:method :post :path "/v1/runs"
                                :body {:input text :profile profile}}
                               (require-token!)))
            report (fn [out]
                     ;; --json still gets the machine-readable final map;
                     ;; interactive one-shot already streamed the answer text.
                     (if json?
                       (emit! out true)
                       (when-let [u (:usage out)]
                         (println (str "· tokens: " (or (:prompt_tokens u) "?")
                                       " in / " (or (:completion_tokens u) "?") " out")))))]
        (-> (start!)
            (.then (fn [{:keys [status body]}]
                     (if (<= 200 status 299)
                       (-> (chat-poll-events! (or (:run_id body) (:run-id body)))
                           (.then (fn [out]
                                    ;; The run started but the turn failed on
                                    ;; the stream (disabled Bot, provider
                                    ;; denial): that is the server refusing,
                                    ;; exit 1 — not a silent success.
                                    (if (= "completed" (:status out))
                                      (report out)
                                      (refuse! (or (:error out)
                                                   (str "run は "
                                                        (name (:status out))
                                                        " で終わりました"))
                                               (select-keys out [:error]))))))
                       (refuse! (str "run を開始できません: HTTP " status)
                                (select-keys body [:error]))))))
        nil)
      (chat-prompt-loop!))))

(defn- suggest
  "Commands whose name contains the FIRST word.

  The whole phrase is the wrong query for a mistyped command: `bots lst` shares
  no substring with anything, and an empty list of suggestions reads as though
  the group does not exist either. The first word is the part an operator
  usually has right."
  [words]
  (when-let [head (first words)]
    (let [named (map #(str/join " " (:command %)) (commands/alias-commands))
          generated (map commands/command-name (commands/matching [head]))]
      (vec (take 8 (concat (filter #(str/includes? % head) named) generated))))))

(defn -main [& argv]
  (let [argv (vec argv)
        flags (commands/parse-flags argv)
        json? (true? (:json flags))
        named (commands/words argv)]
    (cond
      (= "--dump-config" (first argv))
      (dump-config!)

      (or (= ["help"] named) (true? (:help flags))
          ;; Argless on a terminal opens the REPL; argless under a pipe prints
          ;; this, because a REPL with nobody at it would hang a script that
          ;; used to get help. `--json` with no command asks for a value this
          ;; has none of, so it lands here too rather than on a screen.
          (and (empty? named) (or json? (not (tty?)))))
      (do (println (str "itonami — cloud-itonami-app の front end\n\n"
                        "  itonami                                   agent と対話 (REPL を開く)\n"
                        "  itonami chat [--profile <p>] [message …]  同上。message があれば 1 ターンで終了\n"
                        "  itonami commands [term …]                 使える command を検索\n"
                        "  itonami status                            server と store の状態\n"
                        "  itonami profile explain                   どの profile が効いているか\n"
                        "  itonami <command> [--flag value …] [--json]\n\n"
                        "REPL の slash command:\n" ((:help-text ctx-chat)) "\n\n"
                        "パイプ・非 TTY・--json では REPL を開かず、この help を出します。\n\n"
                        "commands: " (count (commands/all)) " (generated) + "
                        (count (commands/alias-commands)) " (named)\n"
                        "exit 0 answered / 1 refused / 2 could not answer"))
          (js/process.exit exit-answered))

      ;; What `claude` and `hermes-agent` do with no arguments, and what the
      ;; help text above had already begun promising while `-main` still
      ;; exited here (ADR-2609062240).
      (empty? named) (chat! argv json?)

      (= "commands" (first named)) (commands! (vec (drop 1 named)) json?)
      (= ["status"] named) (status! json?)
      (= "chat" (first named)) (chat! argv json?)
      (= ["profile" "explain"] named) (profile-explain! json?)

      (contains? #{["up"] ["down"]} named)
      (cannot-answer!
       (str "この front end は server を起動・停止しません。\n"
            "  常駐: launchctl kickstart -k gui/$(id -u)/dev.cloud-itonami.app")
       {:type :client/not-a-supervisor :command (first named)})

      :else
      (let [{:keys [kind] :as invocation} (commands/resolve-invocation argv)]
        (case kind
          :alias (run-alias! invocation json?)
          :registry (run-registry! invocation json?)
          :host-side
          (cannot-answer!
           (str "`" (str/join " " (:command (:command invocation)))
                "` はサーバを通らない host 側の処理で、この front end にはまだ無い。\n"
                "  理由: " (:why (:command invocation)))
           {:type :client/host-side-command})
          :unknown
          (cannot-answer!
           (str "そのような command はありません: " (str/join " " named))
           {:type :client/unknown-command
            :near (suggest named)}))))))

(apply -main (or *command-line-args* []))
