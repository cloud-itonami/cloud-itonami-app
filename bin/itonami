#!/usr/bin/env nbb
;; Leftover CLI launcher — closed as a run path.
;;
;; This used to `spawnSync` `clojure -M:cli`. That is no longer how this app
;; starts. `:cli` in deps.edn refuses the same way. The leftover JVM CLI
;; (`cli.clj` talking to leftover `server.clj`) is not ported; do not invent
;; a second KIR-EDN writer or an HttpClient FFI to fake it.

(ns itonami
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            [nbb.core :refer [*file*]]))

(def app-directory
  (fs/realpathSync (path/resolve (path/dirname *file*) "..")))
(def home-directory
  (when-let [home (aget js/process.env "HOME")]
    (try (fs/realpathSync home) (catch :default _ home))))
(def resident-app-directory
  (when home-directory (path/resolve home-directory ".cloud-itonami" "app")))

(when (and resident-app-directory
           (= app-directory resident-app-directory)
           (nil? (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")))
  (aset js/process.env "CLOUD_ITONAMI_DATA_DIR"
        (path/resolve home-directory ".cloud-itonami" "data")))

(defn- print-data-dir []
  (println (or (aget js/process.env "CLOUD_ITONAMI_DATA_DIR") ""))
  (println (or (aget js/process.env "CLOUD_ITONAMI_APP_DIR") app-directory)))

(defn -main [& args]
  (when (= "--print-data-dir" (first args))
    (print-data-dir)
    (js/process.exit 0))
  (binding [*print-fn* *print-err-fn*]
    (println "leftover JVM run path is closed.")
    (println "bin/itonami no longer starts clojure -M:cli")
    (println "server: nbb --classpath bin bin/cloud-itonami-server")
    (println "mcp:    nbb --classpath bin bin/itonami-mcp"))
  (js/process.exit 2))

(apply -main (or *command-line-args* []))
