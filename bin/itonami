#!/usr/bin/env nbb
;; The `itonami` command: a front end for the operations this app serves.
;;
;;   itonami commands [term …]        what can be named, and how many routes exist
;;   itonami status                   whether a server is answering, and which store
;;   itonami bots list
;;   itonami bots task --id <bot> --text <text>
;;   itonami auth login --label cli
;;
;; ## What this is, and what it replaced
;;
;; PR #270 deleted `:server`, `:mcp` and `:cli` from deps.edn and left this file
;; refusing every command with exit 2 — honestly titled "not JVM-removed". The
;; two hundred and eight commands the app serves had no front end at all.
;;
;; This is that front end, and it starts no JVM. It is a client: it resolves a
;; command to a method and a path, carries the agent session, and prints what
;; the server said. Which server is a separate question from this file — it
;; talks to whatever is bound on the configured host and port, so it works
;; against the resident that is running today and against whatever serves those
;; routes next.
;;
;; ## One decider, two front ends
;;
;; Nothing about a command is decided here. `cloud.itonami.app.commands` is
;; `.cljc` and owns the tables, the longest-prefix match, path templating, the
;; query/body split and the flag specs; this file supplies a classpath-free
;; reader for the two EDN tables and the effects a table cannot carry (reading
;; a file, reading the enrollment key). A second resolver in ClojureScript
;; would be a second decider — two answers that agree until the day they do not,
;; with no test that would notice (ADR-2608197300 §3).
;;
;; ## The exit codes are the contract
;;
;;   0  answered
;;   1  answered: the server refused, or a flag is missing
;;   2  could not answer — no server, no session, no such command
;;
;; 1 and 2 must not collapse. "The server said no" is a measurement; "nothing
;; was listening" is not, and an operator sent to read a refusal that never
;; happened debugs the wrong thing (ADR-2608136000).

(ns itonami
  (:require ["node:child_process" :as cp]
            ["node:os" :as os]
            ["node:fs" :as fs]
            ["node:path" :as path]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [nbb.classpath :as classpath]
            [nbb.core :refer [*file*]]))

;; ---------------------------------------------------------------------------
;; where this install is
;; ---------------------------------------------------------------------------

(def app-directory
  (fs/realpathSync (path/resolve (path/dirname *file*) "..")))

(def home-directory
  (when-let [home (aget js/process.env "HOME")]
    (try (fs/realpathSync home) (catch :default _ home))))

(def resident-app-directory
  (when home-directory (path/resolve home-directory ".cloud-itonami" "app")))

;; A resident install is one installation: `~/.cloud-itonami/app` and
;; `~/.cloud-itonami/data` belong together, and letting the data directory fall
;; back to `app/data` would read a different enrollment than the launchd server
;; wrote. An explicit environment value still wins.
(when (and resident-app-directory
           (= app-directory resident-app-directory)
           (nil? (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")))
  (aset js/process.env "CLOUD_ITONAMI_DATA_DIR"
        (path/resolve home-directory ".cloud-itonami" "data")))

(defn- data-dir []
  (or (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")
      (path/resolve app-directory "data")))

;; Answered before anything else is loaded, because it is the one question a
;; launcher must answer from its own file. A resident install is copied as a
;; single script (`launcher_test` does exactly that), and requiring a sibling
;; first would make "where is your store" depend on the rest of the tree being
;; there.
(when (= "--print-data-dir" (first *command-line-args*))
  (println (data-dir))
  (println app-directory)
  (js/process.exit 0))

;; The shared namespace is resolved from THIS file's location, not from the
;; caller's working directory, so `itonami` works wherever it is invoked from.
;;
;; Measured 2026-09-02: `bin/itonami-mcp` requires a sibling through the ns
;; form and therefore dies with "Could not find namespace" unless the caller
;; remembers `--classpath bin` — a launcher that cannot be run by its own
;; shebang. `launcher_test` catches exactly that, and this avoids repeating it.
(classpath/add-classpath (path/resolve app-directory "src"))
(classpath/add-classpath (path/resolve app-directory "bin"))
(require '[cloud.itonami.app.commands :as commands]
         '[cloud.itonami.app.repo-profile :as repo-profile]
         '[itonami-harness :as harness]
         '[itonami-profile :as profile]
         '[itonami-splash :as splash])

(defn- slurp-file [p]
  (try (fs/readFileSync p "utf8") (catch :default _ nil)))

(defn- read-edn [p]
  (when-let [t (slurp-file p)]
    (try (edn/read-string t) (catch :default _ nil))))

(def configuration
  (let [defaults (or (read-edn (path/resolve app-directory "resources"
                                             "cloud-itonami-app.defaults.edn"))
                     {})
        overrides (or (read-edn (path/resolve (data-dir) "config.edn")) {})]
    (merge-with (fn [a b] (if (and (map? a) (map? b)) (merge a b) b))
                defaults overrides)))

;; The tables ship as resources and this host has no classpath, so it reads
;; them and hands the text to the namespace that owns every judgement made
;; from it.
(commands/install-sources!
 (into {} (keep (fn [n]
                  (when-let [t (slurp-file (path/resolve app-directory "resources" n))]
                    [n t])))
       [commands/resource-name commands/alias-resource-name]))



;; ---------------------------------------------------------------------------
;; output and exits
;; ---------------------------------------------------------------------------

(def ^:private exit-answered 0)
(def ^:private exit-refused 1)
(def ^:private exit-cannot-answer 2)

(defn- err [& xs]
  (binding [*print-fn* *print-err-fn*] (apply println xs)))

(defn- emit! [value json?]
  (if json?
    (println (js/JSON.stringify (clj->js value) nil 2))
    (println (pr-str value)))
  (js/process.exit exit-answered))

(defn- refuse! [message data]
  (err message)
  (when (seq data) (err " " (pr-str data)))
  (js/process.exit exit-refused))

(defn- cannot-answer! [message data]
  (err message)
  (when (seq data) (err " " (pr-str data)))
  (js/process.exit exit-cannot-answer))

;; ---------------------------------------------------------------------------
;; the profile a repository carries (ADR-2609061200)
;; ---------------------------------------------------------------------------

(defn- repo-root
  "The nearest ancestor of `dir` holding `.git`, or nil.

  Upward from the working directory and no further -- the same shape `.git`
  discovery has. There is deliberately no scan: this workspace manages 4,000+
  repositories, and a command that walks them is a command nobody can stop
  (CLAUDE.md says the same about an argument-less `west update`)."
  [dir]
  (loop [d (path/resolve dir) n 0]
    (cond
      (> n 40) nil
      (fs/existsSync (path/join d ".git")) d
      :else (let [up (path/dirname d)] (when (not= up d) (recur up (inc n)))))))

(def ^:private repo-profiles-state
  "Every profile this repository offers, admitted. Computed once.

  Both shapes are read into ONE set: `.itonami/profile.edn` for a repository
  with a single profile, and `.itonami/profiles/*.edn` for one where several
  people keep their own. A repository that grows a second profile should not
  have to move the first."
  (delay
    (when-let [root (repo-root (js/process.cwd))]
      (let [single (path/join root repo-profile/file-name)
            dir (path/join root repo-profile/dir-name)
            files (cond-> []
                    (fs/existsSync single) (conj single)
                    (fs/existsSync dir)
                    (into (->> (js->clj (fs/readdirSync dir))
                               (filter #(str/ends-with? % ".edn"))
                               sort
                               (map #(path/join dir %)))))]
        (when (seq files)
          (assoc (repo-profile/admit-all
                  (map (fn [f] [(path/relative root f) (slurp-file f)]) files))
                 :root root))))))

(defn- local-identity
  "Who this machine says it is, for matching a profile's `:profile/for`.

  From the environment or this install's own configuration — NEVER from the
  repository. A repository that could name the operator could choose which
  profile that operator gets, which is selection by whoever can push."
  []
  (or (some-> (aget js/process.env "ITONAMI_PROFILE_AS") str/trim not-empty)
      (some-> (get-in configuration [:profile :as]) str str/trim not-empty)))

(defn- repo-selection
  "The chosen profile, a refusal, or nil when the repository offers none."
  []
  (when-let [st @repo-profiles-state]
    (repo-profile/select (:accepted st)
                         {:requested (some-> (:profile (commands/parse-flags
                                                        (vec (or *command-line-args* []))))
                                             str/trim not-empty)
                          :as (local-identity)})))

(defn- repo-profile!
  "The chosen repository profile, or nil. REFUSES rather than falling back.

  A repository whose profiles this cannot resolve must not quietly become
  `default`. `pick-default-bot`'s docstring records what that costs: two Bots
  answered to `default`, `itonami chat` ran every turn against the disabled
  one, and the screen said nothing. Exit 2 and not 1 -- nothing was asked of
  the server, so this is not a refusal it issued.

  Files that failed admission refuse here too, even when another file would
  have resolved: a repository carrying a profile nobody can read is a fact its
  author needs, and silently using the sibling hides it."
  []
  (when-let [st @repo-profiles-state]
    (when-let [bad (first (:refused st))]
      (cannot-answer! (str (:source bad) ": " (:message bad))
                      {:reason (:reason bad)}))
    (let [sel (repo-selection)]
      (if (:accepted? sel)
        sel
        (cannot-answer! (str (:root st) ": " (:message sel))
                        {:reason (:reason sel)})))))

(defn- repo-cli-config
  "The `:cli/config` an ACCEPTED repository profile supplies, or `{}`.

  Deliberately does NOT refuse, where `repo-profile!` does. This runs at mount
  time, before any command has been chosen, and refusing here made
  `profile explain` -- the one command whose job is to say WHY a profile was
  refused -- exit 2 before it could say anything. Measured 2026-09-06, and the
  docstring that this replaces claimed the opposite of what the code did.

  A refused profile therefore supplies no configuration and is refused by the
  commands that actually use it. Nothing is lost: `chat` still exits 2, and the
  refusal now reaches a screen instead of pre-empting it."
  []
  (or (some-> (repo-selection)
              (as-> r (when (:accepted? r) r))
              :prefers :cli/config)
      {}))

(defn- profile-source
  "Where the active profile came from, for the banner. An operator who cannot
  see this cannot tell a repository profile that applied from one that did not."
  []
  (cond
    (not-empty (aget js/process.env "ITONAMI_PROFILE")) "ITONAMI_PROFILE"
    (some-> (repo-selection) :accepted?) (:source (repo-selection))
    :else "default"))

(defn- profile-explain!
  "Which profile is active, where it came from, and what was refused.

  An operator cannot otherwise tell a repository profile that applied from one
  that was never there -- the two produce the same working CLI, and only one of
  them is what the person editing `.itonami/profile.edn` believes. `absent` and
  `refused` are printed as different words for the same reason.

  This does NOT refuse. `repo-profile!` exits 2 on an unadmissible profile, and
  the one command whose job is to say why must be able to run in that state."
  [json?]
  (let [st @repo-profiles-state
        sel (repo-selection)
        out {:schema "cloud.itonami.app.cli.profile.v1"
             :active (or (some-> (aget js/process.env "ITONAMI_PROFILE") str/trim not-empty)
                         (when (:accepted? sel) (:profile/id sel))
                         ;; the literal: `chat-default-profile` is defined with
                         ;; the chat surface, far below this
                         "default")
             :source (profile-source)
             :precedence ["--profile" "ITONAMI_PROFILE"
                          (str repo-profile/dir-name "/*.edn")
                          repo-profile/file-name "default"]
             :as (local-identity)
             ;; EVERY profile the repository offers, not only the chosen one.
             ;; An operator who can see one cannot tell "this repository has a
             ;; profile for me" from "this repository has four and I got the
             ;; default".
             :offered (vec (for [a (:accepted st)]
                             {:source (:source a)
                              :id (:profile/id a)
                              :for (get-in a [:describes :profile/for])
                              :default? (boolean (get-in a [:describes :profile/default?]))
                              :chosen? (= (:source a) (:source sel))}))
             :unreadable (vec (for [r (:refused st)]
                                {:source (:source r)
                                 :reason (str (:reason r))
                                 :message (:message r)}))
             :repo (cond
                     (nil? st) {:state "absent"}
                     (:accepted? sel) {:state "accepted"
                                       :path (:source sel)
                                       :id (:profile/id sel)
                                       :describes (vec (sort (map str (keys (:describes sel)))))
                                       :prefers (vec (sort (map str (keys (:prefers sel)))))}
                     :else {:state "refused"
                            :path (:root st)
                            :reason (str (:reason sel))
                            :refused-keys (vec (map str (:refused-keys sel)))
                            :message (:message sel)})}]
    (if json?
      (emit! out true)
      (let [r (:repo out)]
        (println (str "profile: " (:active out) " (" (:source out) ")"))
        (println (str "precedence: " (str/join " > " (:precedence out))))
        (println (str "as: " (or (:as out) "(未設定 — ITONAMI_PROFILE_AS か config の :profile/:as)")))
        (doseq [o (:offered out)]
          (println (str "  " (if (:chosen? o) "*" " ") " " (:id o)
                        "\t" (:source o)
                        (when (:for o) (str "\tfor=" (:for o)))
                        (when (:default? o) "\tdefault"))))
        (doseq [u (:unreadable out)]
          (println (str "  ! " (:source u) "\t" (:reason u))))
        (case (:state r)
          "absent" (println (str "repo: なし (" repo-profile/file-name " が見つかりません)"))
          "accepted" (do (println (str "repo: " (:path r)))
                         (println (str "  id: " (:id r)))
                         (println (str "  describes: " (str/join " " (:describes r))))
                         (println (str "  prefers:   " (str/join " " (:prefers r)))))
          "refused" (do (println (str "repo: " (:path r) " — 拒否"))
                        (println (str "  reason: " (:reason r)))
                        (when (seq (:refused-keys r))
                          (println (str "  keys:   " (str/join " " (:refused-keys r)))))
                        (println (str "  " (:message r)))))))
    (js/process.exit exit-answered)))


;; ---------------------------------------------------------------------------
;; the harness: everything below rides on mounted plugins (ADR-2609042200)
;; ---------------------------------------------------------------------------

(def harness-ctx (harness/make-context))

(harness/mount! harness-ctx (profile/config-plugin
                             {:app-directory app-directory
                              :data-dir (data-dir)
                              ;; A repository's `:cli/config`, at its own
                              ;; precedence: below the flag and the
                              ;; environment, above the shipped default. Only
                              ;; `repo-profile/cli-config-keys` survive
                              ;; admission, so this cannot reach `:server`.
                              :configuration (merge configuration
                                                    (repo-cli-config))}))
(harness/mount! harness-ctx (profile/theme-plugin))
(harness/mount! harness-ctx (profile/chat-plugin))
;; The start screen is a layer like the others, so `--dump-config` and
;; `/plugins` name it. It injects the theme rather than importing one, so the
;; skin a repository selected through `:cli/config` reaches the screen -- not
;; only the prompt. (It is drawn once, at start, so a later `/skin` changes
;; the next launch, not this one.)
(harness/mount! harness-ctx (splash/splash-plugin))

(def ^:private ctx-config (harness/ctx-get harness-ctx :ctx/config))
(def ^:private ctx-theme  (harness/ctx-get harness-ctx :ctx/theme))
(def ^:private ctx-chat   (harness/ctx-get harness-ctx :ctx/chat))
(def ^:private ctx-splash (harness/ctx-get harness-ctx :ctx/splash))

(def app-version
  "The shipped version, read from the resource that carries it. `unknown` is
  said out loud rather than guessed: a start screen naming a version it did
  not read would be the one line on it that nothing backs."
  (or (:version (read-edn (path/resolve app-directory "resources"
                                        "cloud-itonami-version.edn")))
      "unknown"))

(defn- dump-config! []
  (println (harness/dump-config harness-ctx))
  (js/process.exit exit-answered))


;; ---------------------------------------------------------------------------
;; session
;; ---------------------------------------------------------------------------

(def keychain-service "cloud-itonami-app.mcp")
(def keychain-account "session-token")

(defn- sh [cmd args]
  (let [{:keys [status stdout stderr]}
        (js->clj (cp/spawnSync cmd (clj->js args)
                               #js {:encoding "utf8" :stdio "pipe"})
                 :keywordize-keys true)]
    {:exit (or status 1) :stdout (str stdout) :stderr (str stderr)}))

(defn- keychain-get
  "One named item, fetched by service and account — never an enumeration.
  A dump-style sweep would expose unrelated credentials' metadata to answer a
  question about exactly one of them."
  []
  (let [{:keys [exit stdout]} (sh "security" ["find-generic-password"
                                              "-s" keychain-service
                                              "-a" keychain-account "-w"])]
    (when (zero? exit)
      (not-empty (str/trim stdout)))))

(defn- keychain-put! [token]
  (let [{:keys [exit stderr]} (sh "security" ["add-generic-password"
                                              "-U" "-s" keychain-service
                                              "-a" keychain-account
                                              "-w" token])]
    (if (zero? exit) "stored" (str "not-stored: " (str/trim stderr)))))

(defn- session-token []
  (or (some-> (aget js/process.env
                    (or (get-in configuration [:mcp :session-token-env])
                        "CLOUD_ITONAMI_MCP_SESSION"))
              str/trim not-empty)
      (keychain-get)))

(defn- base-url []
  (or (some-> (aget js/process.env "CLOUD_ITONAMI_API_URL") str/trim not-empty
              (str/replace #"/+$" ""))
      (str "http://" (get-in configuration [:server :host] "127.0.0.1")
           ":" (get-in configuration [:server :port] 1338))))

;; ---------------------------------------------------------------------------
;; transport
;; ---------------------------------------------------------------------------

(defn- request!
  "One request. Resolves to {:status :body}; rejects only when nothing answered,
  which is a different failure from a refusal and is reported as one."
  [{:keys [method path body timeout-seconds headers]} token]
  (let [controller (js/AbortController.)
        timer (js/setTimeout #(.abort controller)
                             (* 1000 (or timeout-seconds 30)))
        init #js {:method (str/upper-case (name method))
                  :headers (clj->js (cond-> {"content-type" "application/json"}
                                      token (assoc "authorization" (str "Bearer " token))
                                      ;; `/mcp` answers SSE unless the request
                                      ;; says it will take JSON, so a caller
                                      ;; has to be able to say so.
                                      (seq headers) (merge headers)))
                  :signal (.-signal controller)}]
    (when (= :post method)
      (aset init "body" (js/JSON.stringify (clj->js (or body {})))))
    (-> (js/fetch (str (base-url) path) init)
        (.then (fn [res]
                 (-> (.text res)
                     (.then (fn [t]
                              (js/clearTimeout timer)
                              {:status (.-status res)
                               :body (try (js->clj (js/JSON.parse t) :keywordize-keys true)
                                          (catch :default _ {:raw t}))})))))
        (.catch (fn [e]
                  (js/clearTimeout timer)
                  (throw (ex-info "unreachable"
                                  {:type :client/unreachable
                                   :base-url (base-url)
                                   :cause (or (.-message e) (str e))})))))))

(defn- unwrap
  "The body on success; a refusal carrying the server's own message otherwise.
  The server already says which refusal fired; restating it would give the
  operator a second, vaguer sentence to read."
  [{:keys [status body]} json?]
  (if (<= 200 status 299)
    (emit! body json?)
    (refuse! (or (get-in body [:error :message]) (str "HTTP " status))
             (cond-> {:status status}
               (get-in body [:error :type]) (assoc :type (get-in body [:error :type]))))))

(defn- require-token! []
  (or (session-token)
      (cannot-answer!
       (str "agent session がありません。`itonami auth login` を実行してください。\n"
            "  環境変数 " (get-in configuration [:mcp :session-token-env])
            " か Keychain (" keychain-service " / " keychain-account ") を読みます。")
       {:type :client/no-session})))

;; ---------------------------------------------------------------------------
;; lifecycle commands, answered without the API
;; ---------------------------------------------------------------------------

(defn- health []
  (-> (request! {:method :get :path "/health" :timeout-seconds 5} nil)
      (.then (fn [{:keys [status body]}]
               {:answering? (<= 200 status 299) :status status :health body}))
      (.catch (fn [_] {:answering? false}))))

(defn- status! [json?]
  (-> (health)
      (.then (fn [h]
               (let [out (merge {:base-url (base-url)
                                 :app-directory app-directory
                                 :data-dir (data-dir)
                                 :session? (boolean (session-token))}
                                h)]
                 (if (:answering? h)
                   (emit! out json?)
                   ;; Not a refusal: nothing said no, nothing said anything.
                   (do (err (pr-str out))
                       (cannot-answer!
                        (str "server が応答しません: " (base-url) "\n"
                             "  常駐は launchd (dev.cloud-itonami.app)。"
                             "この front end は server を起動しません。")
                        {:type :client/resident-absent}))))))))

(defn- commands! [terms json?]
  (let [{:keys [routes commands human-only unauthenticated]} (commands/counts)
        matched (commands/matching terms)]
    (emit! {:schema "cloud.itonami.app.cli.commands.v1"
            :coverage {:routes routes :commands commands
                       :human-only human-only :unauthenticated unauthenticated
                       :aliases (count (commands/alias-commands))}
            :matched (count matched)
            :aliases (mapv #(str/join " " (:command %)) (commands/alias-commands))
            :usage (mapv commands/usage matched)}
           json?)))

;; ---------------------------------------------------------------------------
;; dispatch
;; ---------------------------------------------------------------------------

(defn- read-enrollment-key []
  (or (some-> (aget js/process.env "CLOUD_ITONAMI_ENROLLMENT_KEY") str/trim not-empty)
      (some-> (slurp-file (path/resolve (data-dir) "enrollment-key")) str/trim not-empty)
      (cannot-answer!
       (str "enrollment key が読めません。CLOUD_ITONAMI_ENROLLMENT_KEY を設定するか "
            (path/resolve (data-dir) "enrollment-key") " を置いてください。")
       {:type :client/no-enrollment-key})))

(def ^:private effect-opts
  {:read-file (fn [p] (or (slurp-file p)
                          (cannot-answer! (str "読めません: " p)
                                          {:type :client/unreadable-file})))
   :enrollment-key read-enrollment-key})

(defn- run-alias! [{:keys [command flags]} json?]
  (let [req (try (commands/alias-request command flags effect-opts)
                 (catch :default e
                   (refuse! (ex-message e) (ex-data e))))
        token (require-token!)]
    (-> (request! req token)
        (.then (fn [{:keys [status body] :as response}]
                 (if (and (:stores-token? command) (<= 200 status 299))
                   ;; `auth login` is the one command whose result has to
                   ;; outlive the process, or the next one cannot authenticate.
                   (emit! (assoc (select-keys body [:session-id :label :expires-at :token])
                                 :keychain (keychain-put! (:token body)))
                          json?)
                   (unwrap response json?))))
        (.catch (fn [e]
                  (cannot-answer! (str "server に到達できません: " (base-url))
                                  (ex-data e)))))))

(defn- run-registry! [{:keys [command rest flags]} json?]
  (let [;; Path parameters by name, then positionally in the order the template
        ;; declares them, so `esign envelopes show env-1` works alongside
        ;; `--envelope env-1`.
        by-name (into {} (keep (fn [{:keys [name]}]
                                 (when-let [v (get flags (keyword name))]
                                   [name v])))
                      (:params command))
        positional (into {} (map vector
                                 (remove by-name (map :name (:params command)))
                                 rest))
        payload (into {} (keep (fn [[k v]]
                                 (let [n (clojure.core/name k)]
                                   (when-not (contains? by-name n) [n v]))))
                      flags)
        arguments (merge payload by-name positional)
        override (when-let [j (:json-body flags)]
                   (try (js->clj (js/JSON.parse j) :keywordize-keys true)
                        (catch :default _
                          (refuse! "--json-body には JSON 文字列を渡してください" {}))))
        req (try (commands/request command arguments override)
                 (catch :default e (refuse! (ex-message e) (ex-data e))))
        token (require-token!)]
    (-> (request! req token)
        (.then #(unwrap % json?))
        (.catch (fn [e]
                  (cannot-answer! (str "server に到達できません: " (base-url))
                                  (ex-data e)))))))

;; ---------------------------------------------------------------------------
;; chat — the agent loop: /v1/runs + SSE, the hermes-compat surface
;; ---------------------------------------------------------------------------

(def ^:private chat-default-profile "default")

;; REPL state lives in :ctx/chat (the plugin layer, ADR-2609042200); the
;; historical names are bindings to the plugin's own atoms so existing call
;; sites read unchanged and /profile stays a one-atom write.
(def chat-profile (:profile ctx-chat))
(def ^:private chat-approval (:held ctx-chat))
;; The card the current run is held on, set by a `waiting-approval` phase
;; event, consumed by /approve and /deny in the REPL.
(def ^:private chat-approval (atom nil))

(defn- chat-emit [text]
  (js/process.stdout.write (str text)))

(defn- chat-poll-events!
  "Reads the SSE stream for one run until a terminal event. Deltas print as
  they arrive; an approval surface names the command that answers it.
  Resolves to the final status map."
  [run-id]
  (js/Promise.
   (fn [resolve reject]
     (let [token (require-token!)
           controller (js/AbortController.)
           printed (atom "")
           out (atom {:status "started" :output "" :usage nil :error nil
                      :approval nil})]
       (letfn [(finish [] (.abort controller) (resolve @out))
               (on-event [ev]
                 (let [kind (:event ev)]
                   ;; /verbose: everything the stream says that is not the
                   ;; answer itself. Without this the toggle would set a flag
                   ;; nothing reads -- a switch that reports "on" and changes
                   ;; nothing is worse than no switch.
                   (when (and @(:verbose ctx-chat) (not= "assistant.delta" kind))
                     (chat-emit (str "\n" ((:stamp ctx-chat)) "┊ " kind
                                     (when-let [p (:phase ev)] (str " " p))
                                     (when-let [t (:tool ev)] (str " " t))
                                     "\n")))
                   (cond
                     (= "assistant.delta" kind)
                     ;; The server's delta shape is not contractual: runs have
                     ;; been observed both accumulated (each delta the full
                     ;; text so far) and incremental. Handle both — a delta
                     ;; that extends what was printed prints its tail; one
                     ;; that does not is an increment appended to it.
                     (let [delta (str (:delta ev))
                           seen (str @printed)]
                       (cond
                         (str/blank? delta) nil
                         (and (<= (.-length seen) (.-length delta))
                              (= 0 (.indexOf delta seen)))
                         (do (reset! printed delta)
                             (js/process.stdout.write (.slice delta (.-length seen))))
                         :else
                         (do (reset! printed (str seen delta))
                             (js/process.stdout.write delta))))

                     (= "run.completed" kind)
                     (do (swap! out assoc :status "completed"
                                :output (or (:output ev) "") :usage (:usage ev))
                         (js/process.stdout.write "\n")
                         (finish))

                     ;; A held write: the run pauses here, the stream stays
                     ;; open, and the decision (/approve /deny) sends the
                     ;; continuation's tail over this same stream. Resolve
                     ;; the turn so the REPL gets its prompt back — the pump
                     ;; keeps reading and prints the continuation's tail and
                     ;; terminal event when the decision resumes the run.
                     (= "run.waiting_approval" kind)
                     (do (reset! chat-approval {:card (:card ev) :tool (:tool ev)
                                                :run-id run-id})
                         (swap! out assoc :status "waiting-approval"
                                :approval {:card (:card ev) :tool (:tool ev)
                                           :run-id run-id})
                         (js/process.stdout.write
                          (str "\n⚠ 承認待ち: " (:tool ev)
                               " — /approve で許可、/deny で拒否\n"))
                         (resolve @out))

                     (= "run.phase" kind)
                     ;; A held write names the card that answers it. Surface
                     ;; it — the approval is one REPL command away.
                     (when (= "waiting-approval" (:phase ev))
                       (reset! chat-approval {:card (:card ev) :tool (:tool ev)
                                              :run-id run-id})
                       (swap! out assoc :approval {:card (:card ev) :tool (:tool ev)
                                                   :run-id run-id})
                       (js/process.stdout.write
                        (str "\n⚠ 承認待ち: " (:tool ev)
                             " — /approve で許可、/deny で拒否\n")))

                     (contains? #{"run.failed" "run.cancelled" "run.stopped"} kind)
                     (do (swap! out assoc :status (subs kind 4) :error (:error ev))
                         (when (:error ev) (chat-emit (str "\nerror: " (:error ev) "\n")))
                         (finish))

                     :else nil)))
               (feed [s]
                 (loop [s s]
                   (let [i (str/index-of s "\n\n")]
                     (if i
                       (let [frame (subs s 0 i)]
                         (doseq [l (str/split-lines frame)]
                           (when (str/starts-with? l "data: ")
                             (try (on-event (js->clj (js/JSON.parse (subs l 6))
                                                     :keywordize-keys true))
                                  (catch :default _ nil))))
                         (recur (subs s (+ i 2))))
                       ;; Return the unconsumed tail so the caller resets its
                       ;; buffer; re-feeding old frames would replay events.
                       s))))
               (pump [reader decoder buf]
                 (-> (.read reader)
                     (.then (fn [chunk]
                              (if (.-done chunk)
                                (finish)
                                (do (swap! buf str (decoder.decode (.-value chunk)
                                                                 #js {:stream true}))
                                    (reset! buf (feed @buf))
                                    (pump reader decoder buf)))))))]
         (let [req (js/fetch (str (base-url) "/v1/runs/" run-id "/events")
                             #js {:headers #js {"authorization" (str "Bearer " token)}
                                  :signal (.-signal controller)})]
           (-> req
               (.then (fn [res]
                        (let [reader (.getReader (.-body res))
                              decoder (js/TextDecoder. "utf8")
                              buf (atom "")]
                          (pump reader decoder buf))))
               (.catch (fn [e]
                         (.abort controller)
                         (reject (ex-info (str "event stream に到達できません: " (base-url))
                                          {:type :client/unreachable :cause (.-message e)})))))))))))

(defn- request-or-refuse!
  "One authenticated request whose answer is printed by `on-ok`, and whose
  refusal is printed as the server's own status. Returns the promise, which is
  what the REPL awaits before prompting again."
  ([req on-ok] (request-or-refuse! req on-ok nil))
  ([req on-ok on-error]
   (-> (request! req (require-token!))
       (.then (fn [{:keys [status body]}]
                (if (<= 200 status 299)
                  (on-ok body)
                  (if on-error
                    (on-error status body)
                    (println (str "HTTP " status
                                  (when-let [m (get-in body [:error :message])]
                                    (str " — " m))))))))
       (.catch (fn [e] (println (str "error: " (ex-message e))))))))

(defn- pr-edn [v] (binding [*print-length* 12] (pr-str v)))

(defn- register-slash!
  "Register one command on the :ctx/chat registry. There is no second table:
  `/help` is generated from this one, so a command cannot dispatch without
  being listed or be listed without dispatching."
  [cmd args-hint description handler]
  ((:register! ctx-chat) cmd args-hint description handler))

(defn- chat-slash!
  "A REPL line beginning with `/`. Returns :exit to end the session, :handled
  when the command answered synchronously, :resend to re-submit the last input
  as a message, a promise the caller should await, or nil when the line is not
  a command at all."
  [line]
  (let [words (str/split (str/trim line) #"\s+")
        cmd (first words)
        args (vec (rest words))]
    (if-let [entry (get @(:registry ctx-chat) cmd)]
      (try ((:handler entry) args harness-ctx)
           (catch :default e
             (println (str "error: " (ex-message e)))
             :handled))
      (if (str/starts-with? (str cmd) "/")
        (do (println (str "そのような command はありません: " cmd " (/help)")) :handled)
        nil))))


;; ---------------------------------------------------------------------------
;; the slash commands (ADR-2609062400)
;;
;; Ported from `agent/harness-plugin-architecture`, which built the hermes
;; parity surface on a second harness implementation this repository did not
;; land. The commands are the part worth having; they are rewritten here
;; against the harness `main` actually mounts, so the fleet keeps one.
;;
;; Every route below was checked against `src/cloud/itonami/app/server.clj`
;; before it was written down. Several of them (`/v1/runs/…/steer`, `/stop`,
;; `/p/<profile>/api/sessions`) are hermes-compat contexts that the generated
;; command table does not carry, so "not in commands.edn" was not evidence of
;; absence -- the server source was.
;; ---------------------------------------------------------------------------

(register-slash!
 "/help" "" "この一覧"
 (fn [_ _] (println ((:help-text ctx-chat))) :handled))

(register-slash!
 "/exit" "" "終了"
 (fn [_ _] :exit))

(register-slash!
 "/status" "" "常駐サーバの状態"
 (fn [_ _]
   (-> (request! {:method :get :path "/health" :timeout-seconds 5} nil)
       (.then (fn [{:keys [status body]}]
                (println (str "server: " (if (<= 200 status 299) "answering" "down")
                              "  store: " (:store body)))))
       (.catch (fn [_] (println "server: down"))))))

(register-slash!
 "/plugins" "" "mount 済み plugin tree (--dump-config と同じ)"
 (fn [_ _] (println (harness/dump-config harness-ctx)) :handled))

(register-slash!
 "/bots" "" "Bot 一覧"
 (fn [_ _]
   (request-or-refuse!
    {:method :get :path "/api/agent-bots"}
    (fn [body]
      ;; `/api/agent-bots` answers under `:bots`. This read `:data`, found
      ;; nothing, and printed nothing -- a 200 with a working server and an
      ;; empty screen, which is the shape CLAUDE.md calls a check that could
      ;; not run returning the value of one that ran and passed. Measured
      ;; 2026-09-06 against the live resident: 20+ Bots, zero lines.
      (let [bots (or (:bots body) (:data body))]
        (if (empty? bots)
          (println "Bot はありません")
          (doseq [b (take 20 bots)]
            (println (str "  " (or (:id b) (:bot_id b))
                          "  " (or (:name b) "?")
                          "  " (or (:status b) (when (some? (:enabled? b))
                                                 (if (:enabled? b) "enabled" "disabled"))
                                    "?"))))))))))

(register-slash!
 "/botinfo" "[bot-id]" "Bot の tool / browser 構成"
 (fn [args _]
   (request-or-refuse!
    {:method :get :path "/api/agent-bots" :timeout-seconds 15}
    (fn [body]
      (let [bots (or (:bots body) (:data body))
            want (or (first args) @chat-profile)
            matches (filter #(or (= want (:id %)) (= want (:name %))) bots)]
        (doseq [b (or (seq matches) (take 5 bots))]
          (println (str (or (:name b) (:id b)) " (" (:id b) ")"))
          (println (str "  browser: " (:browser? b)
                        "  omakase: " (:omakase? b)
                        "  enabled: " (:enabled? b)))
          (doseq [[label ks n] [["tools" (:tools b) 8]
                                ["admitted" (:admitted-tools b) 6]]]
            (println (str "  " label " (" (count ks) "): "
                          (str/join ", " (take n ks))
                          (when (> (count ks) n) " …"))))))))))

(register-slash!
 "/skills" "" "対話先 Bot の skill / hermes-import 状態"
 (fn [_ _]
   (request-or-refuse!
    {:method :get :path "/api/agent-bots" :timeout-seconds 15}
    (fn [body]
      (let [bots (or (:bots body) (:data body))
            want @chat-profile
            b (or (some #(when (or (= want (:id %)) (= want (:name %))) %) bots)
                  (first bots))]
        (if-not b
          (println "Bot がありません")
          (do (println (str "bot: " (or (:name b) (:id b) "?")))
              (if-let [imp (:hermes-import b)]
                (do (println (str "  imported profile: " (:profile-id imp)))
                    (println (str "  sessions: " (count (:session-ids imp)))))
                (println "  hermes-import なし"))
              (let [ts (:tools b)]
                (println (str "  tools (" (count ts) "): "
                              (str/join ", " (take 10 ts))))))))))))

(register-slash!
 "/profiles" "" "profile 一覧"
 (fn [_ _]
   (request-or-refuse!
    {:method :get :path "/api/profiles"}
    (fn [body]
      (doseq [p (take 30 (:data body))]
        (println (str "  " (:id p) "  " (:name p) "  " (:status p))))))))

(register-slash!
 "/profile" "[<id>]" "対話先を切り替え"
 (fn [args _]
   (when (seq args) (reset! chat-profile (first args)))
   (println (str "profile: " @chat-profile))
   :handled))

(register-slash!
 "/skin" "[<name>]" "見た目を切り替え (:ctx/theme を live re-provide)"
 (fn [args _]
   (if (empty? args)
     (let [s ((:skin ctx-theme))]
       (println (str "skin: " (:name s) "  prompt: " (:prompt s))))
     (let [r ((:set-skin! ctx-theme) (first args))]
       (if (:ok r)
         (println (str "skin: " (:name (:skin r)) " — live re-provided (:ctx/theme)"))
         (println (str "そのような skin はありません。available: "
                       (str/join " " (:available r)))))))
   :handled))

;; --- the held card -------------------------------------------------------

(defn- decide! [choice done]
  (if-let [{:keys [run-id]} @chat-approval]
    (request-or-refuse!
     {:method :post :path (str "/v1/runs/" run-id "/approval")
      :body {:choice choice}}
     (fn [_]
       ;; The continuation's tail and terminal event arrive on the run's
       ;; still-open SSE stream, so there is nothing to poll here.
       (println done)
       (reset! chat-approval nil))
     (fn [status body]
       (println (str "decide failed: HTTP " status " "
                     (str (get-in body [:error :message]))))))
    (do (println "承認待ちの card はありません") :handled)))

(register-slash! "/approve" "" "承認待ちの card を許可"
                 (fn [_ _] (decide! "approve" "approved — 実行が続きます")))
(register-slash! "/deny" "" "承認待ちの card を拒否"
                 (fn [_ _] (decide! "deny" "denied")))

;; --- a run in flight -----------------------------------------------------

(register-slash!
 "/steer" "<text>" "実行中 run への割り込み注入"
 (fn [args _]
   (let [text (str/join " " args)
         run-id (:run-id @chat-approval)]
     (if (or (str/blank? text) (nil? run-id))
       (do (println "steer できる実行中 run がありません (/steer <text>)") :handled)
       (request-or-refuse!
        {:method :post :path (str "/v1/runs/" run-id "/steer")
         :body {:input text} :timeout-seconds 15}
        (fn [_] (println "steered — 次の tool call 後に反映されます")))))))

(register-slash!
 "/stop" "" "実行中 run の停止"
 (fn [_ _]
   (if-let [run-id (:run-id @chat-approval)]
     (request-or-refuse!
      {:method :post :path (str "/v1/runs/" run-id "/stop") :timeout-seconds 10}
      (fn [_] (println "stop 要求を送りました")))
     (do (println "停止できる実行中 run がありません") :handled))))

