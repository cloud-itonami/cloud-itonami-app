(register-slash!
 "/sessions" "" "過去セッション一覧"
 (fn [_ _]
   (request-or-refuse!
    {:method :get :path (str "/p/" @chat-profile "/api/sessions")
     :timeout-seconds 10}
    (fn [body]
      (doseq [sess (take 30 (:data body))]
        (println (str "  " (:id sess)
                      "  " (or (:title sess) "?")
                      "  " (or (:message_count sess) 0) " msgs"
                      "  " (or (:preview sess) ""))))))))

(register-slash!
 "/history" "[N]" "直近 N 件のメッセージ (既定 20)"
 (fn [args _]
   (let [n (or (some-> args first js/parseInt) 20)
         n (if (js/Number.isFinite n) (max 1 n) 20)]
     (request-or-refuse!
      {:method :get
       :path (str "/p/" @chat-profile "/api/sessions/" @chat-profile
                  "/messages?order=latest&limit=" n)
       :timeout-seconds 10}
      (fn [body]
        (doseq [m (reverse (:data body))]
          (let [c (str (:content m))]
            (println (str "[" (or (:role m) "?") "] "
                          (subs c 0 (min 300 (.-length c))))))))))))

