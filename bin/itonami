(register-slash!
 "/whoami" "" "operator の確認"
 (fn [_ _]
   (request-or-refuse!
    {:method :get :path "/api/operator" :timeout-seconds 10}
    (fn [body]
      (let [p (:profile body)]
        (if (and (map? p) (seq p))
          (do (println (str "operator: "
                            (or (:name p) (:display-name p)
                                (pr-str (select-keys p [:id :created-at])))))
              (doseq [k (take 6 (keys p))]
                (println (str "  " k ": " (pr-str (get p k))))))
          (println "operator profile は未設定 (Web UI で設定)"))
        (when-let [s (:summary body)] (println (str "summary: " (pr-edn s)))))))))

