(defn- model-panel
  "The models this deployment can reach, per task, with the one in force marked.

  `/model` used to print the routing document as EDN. That document is a list
  of TASKS and their assignments -- it does not contain a single model name --
  so the screen answered a question nobody asked and offered nothing to pick
  (reported 2026-09-07: 「model 一覧が出てこない、選択できない」). The models are in
  the overview, under `:model-providers`."
  [routing overview]
  (let [providers (:model-providers overview)
        assignments (:assignments routing)
        scope (or (:default-scope routing) "default")
        assigned (fn [task]
                   (first (for [a assignments
                                :when (and (= task (str (:task a)))
                                           (= scope (str (:scope a))))]
                            a)))
        items (vec (for [p providers
                         m (:models p)]
                     {:label (str m)
                      :detail (str "(" (:name p) ")")
                      :provider-id (:id p)
                      :model (str m)}))]
    {:title "model routing"
     :tab 0 :index 0 :scroll 0
     :tabs
     (if (empty? items)
       [{:label "models"
         :lines ["この deployment から使える model がありません。"
                 "provider が有効か `/plugins` と operator config を確認してください。"]}]
       (vec (for [t (:tasks routing)]
              (let [task (str (:task t))
                    now (assigned task)]
                {:label (str (:label t) (when (:main? t) " ★"))
                 :task task
                 :scope scope
                 :items (vec (for [i items]
                               (assoc i :label
                                      (str (if (and now
                                                    (= (:model i) (str (:model now)))
                                                    (= (str (:provider-id i))
                                                       (str (:provider-id now))))
                                             "● " "  ")
                                           (:model i))
                                      :detail (str (:detail i)
                                                   "  " (:hint t)))))}))))}))

(register-slash!
 "/model" "" "model を選ぶ（task ごと）"
 (fn [_ _]
   (-> (js/Promise.all
        #js [(request! {:method :get :path "/api/bots/model-routing"
                        :timeout-seconds 10} (session-token))
             (request! {:method :get :path "/api/agent-bots"
                        :timeout-seconds 15} (session-token))])
       (.then (fn [[routing overview]]
                (cond
                  (not (<= 200 (:status routing) 299))
                  {:panel {:title "model routing"
                           :tab 0 :scroll 0
                           :tabs [{:label "使えません"
                                   :lines [(str "model routing を読めません (HTTP "
                                                (:status routing) ")")
                                           (if (human-token)
                                             "human session はありますが拒否されました。"
                                             "human session がありません。/login でサインインしてください。")]}]}}
                  (not (<= 200 (:status overview) 299))
                  {:panel {:title "model routing" :tab 0 :scroll 0
                           :tabs [{:label "使えません"
                                   :lines [(str "Bot 一覧を読めません (HTTP "
                                                (:status overview) ")")]}]}}
                  :else
                  {:panel (model-panel (:body routing) (:body overview))})))
       (.catch (fn [e]
                 {:panel {:title "model routing" :tab 0 :scroll 0
                          :tabs [{:label "使えません"
                                  :lines [(str "server に到達できません: " (base-url))
                                          (ex-message e)]}]}})))))

