#!/usr/bin/env nbb
;; The `itonami` command: a front end for the operations this app serves.
;;
;;   itonami commands [term …]        what can be named, and how many routes exist
;;   itonami status                   whether a server is answering, and which store
;;   itonami bots list
;;   itonami bots task --id <bot> --text <text>
;;   itonami auth login --label cli
;;
;; ## What this is, and what it replaced
;;
;; PR #270 deleted `:server`, `:mcp` and `:cli` from deps.edn and left this file
;; refusing every command with exit 2 — honestly titled "not JVM-removed". The
;; two hundred and eight commands the app serves had no front end at all.
;;
;; This is that front end, and it starts no JVM. It is a client: it resolves a
;; command to a method and a path, carries the agent session, and prints what
;; the server said. Which server is a separate question from this file — it
;; talks to whatever is bound on the configured host and port, so it works
;; against the resident that is running today and against whatever serves those
;; routes next.
;;
;; ## One decider, two front ends
;;
;; Nothing about a command is decided here. `cloud.itonami.app.commands` is
;; `.cljc` and owns the tables, the longest-prefix match, path templating, the
;; query/body split and the flag specs; this file supplies a classpath-free
;; reader for the two EDN tables and the effects a table cannot carry (reading
;; a file, reading the enrollment key). A second resolver in ClojureScript
;; would be a second decider — two answers that agree until the day they do not,
;; with no test that would notice (ADR-2608197300 §3).
;;
;; ## The exit codes are the contract
;;
;;   0  answered
;;   1  answered: the server refused, or a flag is missing
;;   2  could not answer — no server, no session, no such command
;;
;; 1 and 2 must not collapse. "The server said no" is a measurement; "nothing
;; was listening" is not, and an operator sent to read a refusal that never
;; happened debugs the wrong thing (ADR-2608136000).

(ns itonami
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:path" :as path]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [nbb.classpath :as classpath]
            [nbb.core :refer [*file*]]))

;; ---------------------------------------------------------------------------
;; where this install is
;; ---------------------------------------------------------------------------

(def app-directory
  (fs/realpathSync (path/resolve (path/dirname *file*) "..")))

(def home-directory
  (when-let [home (aget js/process.env "HOME")]
    (try (fs/realpathSync home) (catch :default _ home))))

(def resident-app-directory
  (when home-directory (path/resolve home-directory ".cloud-itonami" "app")))

;; A resident install is one installation: `~/.cloud-itonami/app` and
;; `~/.cloud-itonami/data` belong together, and letting the data directory fall
;; back to `app/data` would read a different enrollment than the launchd server
;; wrote. An explicit environment value still wins.
(when (and resident-app-directory
           (= app-directory resident-app-directory)
           (nil? (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")))
  (aset js/process.env "CLOUD_ITONAMI_DATA_DIR"
        (path/resolve home-directory ".cloud-itonami" "data")))

(defn- data-dir []
  (or (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")
      (path/resolve app-directory "data")))

;; Answered before anything else is loaded, because it is the one question a
;; launcher must answer from its own file. A resident install is copied as a
;; single script (`launcher_test` does exactly that), and requiring a sibling
;; first would make "where is your store" depend on the rest of the tree being
;; there.
(when (= "--print-data-dir" (first *command-line-args*))
  (println (data-dir))
  (println app-directory)
  (js/process.exit 0))

;; The shared namespace is resolved from THIS file's location, not from the
;; caller's working directory, so `itonami` works wherever it is invoked from.
;;
;; Measured 2026-09-02: `bin/itonami-mcp` requires a sibling through the ns
;; form and therefore dies with "Could not find namespace" unless the caller
;; remembers `--classpath bin` — a launcher that cannot be run by its own
;; shebang. `launcher_test` catches exactly that, and this avoids repeating it.
(classpath/add-classpath (path/resolve app-directory "src"))
(require '[cloud.itonami.app.commands :as commands])

(defn- slurp-file [p]
  (try (fs/readFileSync p "utf8") (catch :default _ nil)))

(defn- read-edn [p]
  (when-let [t (slurp-file p)]
    (try (edn/read-string t) (catch :default _ nil))))

(def configuration
  (let [defaults (or (read-edn (path/resolve app-directory "resources"
                                             "cloud-itonami-app.defaults.edn"))
                     {})
        overrides (or (read-edn (path/resolve (data-dir) "config.edn")) {})]
    (merge-with (fn [a b] (if (and (map? a) (map? b)) (merge a b) b))
                defaults overrides)))

;; The tables ship as resources and this host has no classpath, so it reads
;; them and hands the text to the namespace that owns every judgement made
;; from it.
(commands/install-sources!
 (into {} (keep (fn [n]
                  (when-let [t (slurp-file (path/resolve app-directory "resources" n))]
                    [n t])))
       [commands/resource-name commands/alias-resource-name]))

;; ---------------------------------------------------------------------------
;; output and exits
;; ---------------------------------------------------------------------------

(def ^:private exit-answered 0)
(def ^:private exit-refused 1)
(def ^:private exit-cannot-answer 2)

(defn- err [& xs]
  (binding [*print-fn* *print-err-fn*] (apply println xs)))

(defn- emit! [value json?]
  (if json?
    (println (js/JSON.stringify (clj->js value) nil 2))
    (println (pr-str value)))
  (js/process.exit exit-answered))

(defn- refuse! [message data]
  (err message)
  (when (seq data) (err " " (pr-str data)))
  (js/process.exit exit-refused))

(defn- cannot-answer! [message data]
  (err message)
  (when (seq data) (err " " (pr-str data)))
  (js/process.exit exit-cannot-answer))

;; ---------------------------------------------------------------------------
;; session
;; ---------------------------------------------------------------------------

(def keychain-service "cloud-itonami-app.mcp")
(def keychain-account "session-token")

(defn- sh [cmd args]
  (let [{:keys [status stdout stderr]}
        (js->clj (cp/spawnSync cmd (clj->js args)
                               #js {:encoding "utf8" :stdio "pipe"})
                 :keywordize-keys true)]
    {:exit (or status 1) :stdout (str stdout) :stderr (str stderr)}))

(defn- keychain-get
  "One named item, fetched by service and account — never an enumeration.
  A dump-style sweep would expose unrelated credentials' metadata to answer a
  question about exactly one of them."
  []
  (let [{:keys [exit stdout]} (sh "security" ["find-generic-password"
                                              "-s" keychain-service
                                              "-a" keychain-account "-w"])]
    (when (zero? exit)
      (not-empty (str/trim stdout)))))

(defn- keychain-put! [token]
  (let [{:keys [exit stderr]} (sh "security" ["add-generic-password"
                                              "-U" "-s" keychain-service
                                              "-a" keychain-account
                                              "-w" token])]
    (if (zero? exit) "stored" (str "not-stored: " (str/trim stderr)))))

(defn- session-token []
  (or (some-> (aget js/process.env
                    (or (get-in configuration [:mcp :session-token-env])
                        "CLOUD_ITONAMI_MCP_SESSION"))
              str/trim not-empty)
      (keychain-get)))

(defn- base-url []
  (or (some-> (aget js/process.env "CLOUD_ITONAMI_API_URL") str/trim not-empty
              (str/replace #"/+$" ""))
      (str "http://" (get-in configuration [:server :host] "127.0.0.1")
           ":" (get-in configuration [:server :port] 1338))))

;; ---------------------------------------------------------------------------
;; transport
;; ---------------------------------------------------------------------------

(defn- request!
  "One request. Resolves to {:status :body}; rejects only when nothing answered,
  which is a different failure from a refusal and is reported as one."
  [{:keys [method path body timeout-seconds]} token]
  (let [controller (js/AbortController.)
        timer (js/setTimeout #(.abort controller)
                             (* 1000 (or timeout-seconds 30)))
        init #js {:method (str/upper-case (name method))
                  :headers (clj->js (cond-> {"content-type" "application/json"}
                                      token (assoc "authorization" (str "Bearer " token))))
                  :signal (.-signal controller)}]
    (when (= :post method)
      (aset init "body" (js/JSON.stringify (clj->js (or body {})))))
    (-> (js/fetch (str (base-url) path) init)
        (.then (fn [res]
                 (-> (.text res)
                     (.then (fn [t]
                              (js/clearTimeout timer)
                              {:status (.-status res)
                               :body (try (js->clj (js/JSON.parse t) :keywordize-keys true)
                                          (catch :default _ {:raw t}))})))))
        (.catch (fn [e]
                  (js/clearTimeout timer)
                  (throw (ex-info "unreachable"
                                  {:type :client/unreachable
                                   :base-url (base-url)
                                   :cause (or (.-message e) (str e))})))))))

(defn- unwrap
  "The body on success; a refusal carrying the server's own message otherwise.
  The server already says which refusal fired; restating it would give the
  operator a second, vaguer sentence to read."
  [{:keys [status body]} json?]
  (if (<= 200 status 299)
    (emit! body json?)
    (refuse! (or (get-in body [:error :message]) (str "HTTP " status))
             (cond-> {:status status}
               (get-in body [:error :type]) (assoc :type (get-in body [:error :type]))))))

(defn- require-token! []
  (or (session-token)
      (cannot-answer!
       (str "agent session がありません。`itonami auth login` を実行してください。\n"
            "  環境変数 " (get-in configuration [:mcp :session-token-env])
            " か Keychain (" keychain-service " / " keychain-account ") を読みます。")
       {:type :client/no-session})))

;; ---------------------------------------------------------------------------
;; lifecycle commands, answered without the API
;; ---------------------------------------------------------------------------

(defn- health []
  (-> (request! {:method :get :path "/health" :timeout-seconds 5} nil)
      (.then (fn [{:keys [status body]}]
               {:answering? (<= 200 status 299) :status status :health body}))
      (.catch (fn [_] {:answering? false}))))

(defn- status! [json?]
  (-> (health)
      (.then (fn [h]
               (let [out (merge {:base-url (base-url)
                                 :app-directory app-directory
                                 :data-dir (data-dir)
                                 :session? (boolean (session-token))}
                                h)]
                 (if (:answering? h)
                   (emit! out json?)
                   ;; Not a refusal: nothing said no, nothing said anything.
                   (do (err (pr-str out))
                       (cannot-answer!
                        (str "server が応答しません: " (base-url) "\n"
                             "  常駐は launchd (dev.cloud-itonami.app)。"
                             "この front end は server を起動しません。")
                        {:type :client/resident-absent}))))))))

(defn- commands! [terms json?]
  (let [{:keys [routes commands human-only unauthenticated]} (commands/counts)
        matched (commands/matching terms)]
    (emit! {:schema "cloud.itonami.app.cli.commands.v1"
            :coverage {:routes routes :commands commands
                       :human-only human-only :unauthenticated unauthenticated
                       :aliases (count (commands/alias-commands))}
            :matched (count matched)
            :aliases (mapv #(str/join " " (:command %)) (commands/alias-commands))
            :usage (mapv commands/usage matched)}
           json?)))

;; ---------------------------------------------------------------------------
;; dispatch
;; ---------------------------------------------------------------------------

(defn- read-enrollment-key []
  (or (some-> (aget js/process.env "CLOUD_ITONAMI_ENROLLMENT_KEY") str/trim not-empty)
      (some-> (slurp-file (path/resolve (data-dir) "enrollment-key")) str/trim not-empty)
      (cannot-answer!
       (str "enrollment key が読めません。CLOUD_ITONAMI_ENROLLMENT_KEY を設定するか "
            (path/resolve (data-dir) "enrollment-key") " を置いてください。")
       {:type :client/no-enrollment-key})))

(def ^:private effect-opts
  {:read-file (fn [p] (or (slurp-file p)
                          (cannot-answer! (str "読めません: " p)
                                          {:type :client/unreadable-file})))
   :enrollment-key read-enrollment-key})

(defn- run-alias! [{:keys [command flags]} json?]
  (let [req (try (commands/alias-request command flags effect-opts)
                 (catch :default e
                   (refuse! (ex-message e) (ex-data e))))
        token (require-token!)]
    (-> (request! req token)
        (.then (fn [{:keys [status body] :as response}]
                 (if (and (:stores-token? command) (<= 200 status 299))
                   ;; `auth login` is the one command whose result has to
                   ;; outlive the process, or the next one cannot authenticate.
                   (emit! (assoc (select-keys body [:session-id :label :expires-at :token])
                                 :keychain (keychain-put! (:token body)))
                          json?)
                   (unwrap response json?))))
        (.catch (fn [e]
                  (cannot-answer! (str "server に到達できません: " (base-url))
                                  (ex-data e)))))))

(defn- run-registry! [{:keys [command rest flags]} json?]
  (let [;; Path parameters by name, then positionally in the order the template
        ;; declares them, so `esign envelopes show env-1` works alongside
        ;; `--envelope env-1`.
        by-name (into {} (keep (fn [{:keys [name]}]
                                 (when-let [v (get flags (keyword name))]
                                   [name v])))
                      (:params command))
        positional (into {} (map vector
                                 (remove by-name (map :name (:params command)))
                                 rest))
        payload (into {} (keep (fn [[k v]]
                                 (let [n (clojure.core/name k)]
                                   (when-not (contains? by-name n) [n v]))))
                      flags)
        arguments (merge payload by-name positional)
        override (when-let [j (:json-body flags)]
                   (try (js->clj (js/JSON.parse j) :keywordize-keys true)
                        (catch :default _
                          (refuse! "--json-body には JSON 文字列を渡してください" {}))))
        req (try (commands/request command arguments override)
                 (catch :default e (refuse! (ex-message e) (ex-data e))))
        token (require-token!)]
    (-> (request! req token)
        (.then #(unwrap % json?))
        (.catch (fn [e]
                  (cannot-answer! (str "server に到達できません: " (base-url))
                                  (ex-data e)))))))

(defn- suggest
  "Commands whose name contains the FIRST word.

  The whole phrase is the wrong query for a mistyped command: `bots lst` shares
  no substring with anything, and an empty list of suggestions reads as though
  the group does not exist either. The first word is the part an operator
  usually has right."
  [words]
  (when-let [head (first words)]
    (let [named (map #(str/join " " (:command %)) (commands/alias-commands))
          generated (map commands/command-name (commands/matching [head]))]
      (vec (take 8 (concat (filter #(str/includes? % head) named) generated))))))

(defn -main [& argv]
  (let [argv (vec argv)
        flags (commands/parse-flags argv)
        json? (true? (:json flags))
        named (commands/words argv)]
    (cond
      (or (empty? named) (= ["help"] named) (true? (:help flags)))
      (do (println (str "itonami — cloud-itonami-app の front end\n\n"
                        "  itonami commands [term …]\n"
                        "  itonami status\n"
                        "  itonami <command> [--flag value …] [--json]\n\n"
                        "commands: " (count (commands/all)) " (generated) + "
                        (count (commands/alias-commands)) " (named)\n"
                        "exit 0 answered / 1 refused / 2 could not answer"))
          (js/process.exit exit-answered))

      (= "commands" (first named)) (commands! (vec (drop 1 named)) json?)
      (= ["status"] named) (status! json?)

      (contains? #{["up"] ["down"]} named)
      (cannot-answer!
       (str "この front end は server を起動・停止しません。\n"
            "  常駐: launchctl kickstart -k gui/$(id -u)/dev.cloud-itonami.app")
       {:type :client/not-a-supervisor :command (first named)})

      :else
      (let [{:keys [kind] :as invocation} (commands/resolve-invocation argv)]
        (case kind
          :alias (run-alias! invocation json?)
          :registry (run-registry! invocation json?)
          :host-side
          (cannot-answer!
           (str "`" (str/join " " (:command (:command invocation)))
                "` はサーバを通らない host 側の処理で、この front end にはまだ無い。\n"
                "  理由: " (:why (:command invocation)))
           {:type :client/host-side-command})
          :unknown
          (cannot-answer!
           (str "そのような command はありません: " (str/join " " named))
           {:type :client/unknown-command
            :near (suggest named)}))))))

(apply -main (or *command-line-args* []))
