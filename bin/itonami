       (println "  skills: なし"))
     :handled)))


;; ---------------------------------------------------------------------------
;; the start screen (ADR-2609062240)
;; ---------------------------------------------------------------------------

(defn- session-origin
  "Where the session token came from, or that there is none.

  `auth login` writes the Keychain and the environment variable overrides it.
  An operator who cannot see which one answered cannot tell a stale export
  from a fresh login -- the two produce an identical working CLI right up to
  the moment the exported one expires."
  []
  (let [env-name (or (get-in configuration [:mcp :session-token-env])
                     "CLOUD_ITONAMI_MCP_SESSION")]
    (cond
      (not (str/blank? (str (aget js/process.env env-name)))) env-name
      (keychain-get) (str "keychain " keychain-service)
      :else "なし — itonami auth login")))

(defn- print-splash!
  "The start screen, then the two facts that had to be measured to be said.

  The frame is drawn from tables this process already read; `/health` is one
  request with a short timeout. It is awaited rather than printed late,
  because a warning that arrives after the prompt lands in the middle of the
  operator's first line. Resolves once the screen is written."
  []
  (-> (health)
      (.then
       (fn [h]
         (let [colour (colour?)
               cmds (commands/all)
               aliases (commands/alias-commands)
               slash ((:commands ctx-chat))
               warn (fn [text] (println (splash/paint colour "38;5;203" text)))]
           (println
            ((:render ctx-splash)
             {:color? colour
              :columns (or (.-columns js/process.stdout) 88)
              :version app-version
              :base-url (base-url)
              :profile @chat-profile
              :profile-source (profile-source)
              :cwd (js/process.cwd)
              :home home-directory
              :session (session-origin)
              :groups (splash/summarise cmds 5)
              :named (splash/summarise aliases 3)
              ;; The repository's own commands, named rather than counted: a
              ;; number tells an operator there are some, a name tells them
              ;; which one to type.
              :project (let [admitted (:admitted @project-commands)]
                         (cond-> (vec (for [e (take 3 admitted)]
                                        [(:command e)
                                         (or (not-empty (:description e))
                                             "project skill")]))
                           (> (count admitted) 3)
                           (conj [nil (str "+" (- (count admitted) 3) " more: "
                                           (str/join " " (map :command
                                                              (drop 3 admitted))))])))
              ;; The built-ins only. The repository's own get their own
              ;; section below: thirty-two names inside `REPL Commands` buried
              ;; the ten an operator uses every session.
              :slash (let [project (set (map :command (:admitted @project-commands)))]
                       (remove project ((:commands ctx-chat))))
              ;; joined by the skin's accent glyph inside the splash, so
              ;; the separator is one the theme owns
              :counts (cond-> [(str (count cmds) " commands")
                               (str (count aliases) " named")
                               (str (count slash) " slash")]
                        (seq (:admitted @project-commands))
                        (conj (str (count (:admitted @project-commands)) " project"))
                        :always (conj "/help for commands"))}))
           ;; Below the frame: a glyph whose width a terminal disagrees about
           ;; cannot push a border off down here, and these two lines are the
           ;; ones an operator acts on.
           (if (:answering? h)
             (println (splash/paint colour splash/dim-code
                                    (str "· server: answering · store: "
                                         (or (get-in h [:health :store]) "?"))))
             (warn (str "! server が応答しません: " (base-url)
                        " — 常駐: launchctl kickstart -k gui/$(id -u)/dev.cloud-itonami.app")))
           (when-not (session-token)
             (warn "! agent session がありません — itonami auth login"))
           ;; A project command that was NOT registered has to say so here. A
           ;; screen that lists only what worked makes "this repository has no
           ;; skills" and "I could not use its skills" the same screen.
           (doseq [e (:refused @project-commands)]
             (warn (str "! project command を登録しませんでした: " (:command e)
                        " — " (:reason e))))
           (println)
           (println (splash/paint colour splash/accent-code
                                  "Itonami へようこそ。メッセージを入力するか /help を打ってください。"))
           (println (splash/paint colour splash/dim-code
                                  (str "Tip: 対話先の Bot はリポジトリの .itonami/profile.edn が選びます"
                                       " (itonami profile explain)")))
           (println))))
      (.catch (fn [e]
                ;; The screen is decoration; failing to draw it must not cost
                ;; the operator their REPL. Say what happened and continue.
                (err (str "itonami: start screen を描けませんでした: " (ex-message e)))))))



;; ---------------------------------------------------------------------------
;; the terminal half of the input area (ADR-2609062800)
;;
;; `itonami-editor` decides what a key means and what the rows say. This part
;; owns raw mode, the bytes, and the cursor -- and no rules. Every number below
;; comes out of `editor/render`, so there is one place that knows the geometry.
;; ---------------------------------------------------------------------------

(defn- erase-input! []
  (when (:drawn? @input-block)
    (let [{:keys [caret-row]} @input-block]
      (out! (str "\r"
                 (when (pos? caret-row) (str esc "[" caret-row "A"))
                 esc "[0J"))
      (swap! input-block assoc :drawn? false))))

(defn- editor-opts []
  (let [skin ((:skin ctx-theme))]
    {:width (term-width)
     :prompt (:prompt skin)
     :continuation (:continuation skin)
     :colour (colour?)
     :rows (or (.-rows js/process.stdout) 24)
     :accent-code (or (:accent-code skin) splash/accent-code)
     :label-code (or (:label-code skin) splash/label-code)
     :dim-code (or (:dim-code skin) splash/dim-code)}))

(defn- status-for []
  (let [skin ((:skin ctx-theme))]
    (editor/status-line
     {:profile @chat-profile
      :slash-count (count ((:commands ctx-chat)))
      :held (:tool @chat-approval)
      :running? (some? (:running @repl))
      :queued (count (:queue @repl))
      :menu? (some? (editor/menu (:editor @repl)))
      :colour (colour?)
      :accent-code (or (:accent-code skin) splash/accent-code)
      :dim-code (or (:dim-code skin) splash/dim-code)}
     (term-width))))

(defn- header-for
  "The progress line, as the block's first row, while a turn is in flight."
  []
  (when-let [{:keys [started phase tokens tick]} (:running @repl)]
    (let [skin ((:skin ctx-theme))]
      (editor/progress-line
       {:phase phase :ms (- (js/Date.now) started) :tick (or tick 0)
        :tokens tokens :interruptible? true :colour (colour?)
        :accent-code (or (:accent-code skin) splash/accent-code)
        :dim-code (or (:dim-code skin) splash/dim-code)}
       (term-width)))))

(defn- draw-input! [state]
  (erase-input!)
  (let [{:keys [rows caret panel?]} (editor/render state (assoc (editor-opts)
                                                               :status (status-for)
                                                               :header (header-for)
                                                               :tail @pending-line))
        [caret-row caret-col] caret
        n (count rows)]
    (out!
     (str
      ;; Cursor off for the redraw, so it is not seen walking the frame.
      esc "[?25l"
      ;; AUTO-WRAP OFF. This is what makes the row count true.
      ;;
      ;; Every row here is built to fit, but "fits" is this program's opinion
      ;; of how wide a glyph is, and UAX#11 leaves that to the terminal for
      ;; U+276F, U+25B6, U+00B7 and all of box drawing. When the opinion is one
      ;; column short the row wraps, the block then occupies more terminal rows
      ;; than were counted, the next erase moves up too few, and the input area
      ;; walks down the screen leaving copies of itself.
      ;;
      ;; Measured 2026-09-07 by making every row twelve columns too wide: that
      ;; is exactly what happens, and it is what the operator saw as
      ;; `カーソルが動かない` and `入力エリアが消えてしまう`. With wrap off the
      ;; terminal clips instead -- a mismeasured glyph costs a clipped
      ;; character, not a broken screen. Re-measured with the same twelve
      ;; columns after: four rows, intact.
      esc "[?7l"
      ;; `[2K` per row rather than trusting the `[0J` above to have reached
      ;; every column of every row the last frame used.
      (str/join "\r\n" (map #(str esc "[2K" %) rows))
      esc "[?7h"
      "\r"
      (when (> (dec n) caret-row) (str esc "[" (- (dec n) caret-row) "A"))
      (when (pos? caret-col) (str esc "[" caret-col "C"))
      ;; A panel has nothing to type into; a cursor parked in its corner reads
      ;; as an input that is ignoring the keyboard.
      (when-not panel? (str esc "[?25h"))))
    (reset! input-block {:rows n :caret-row caret-row :drawn? true})))

(defn- redraw!
  "Put the block back. Scheduled rather than immediate: a burst of stream
  deltas would otherwise redraw the whole frame per delta, and the frame is the
  expensive part. One tick, one redraw."
  []
  (when-not @redraw-timer
    (reset! redraw-timer
            (js/setTimeout (fn []
                             (reset! redraw-timer nil)
                             (when-let [st (:editor @repl)] (draw-input! st)))
                           0))))

(defn- say!
  "Write to the screen while the input block may be on it.

  Erase the block, put the cursor back where the output actually stopped, write,
  and schedule the block to come back. EVERY write during the REPL goes through
  here -- including `println` from a slash command, which is why `*print-fn*` is
  rebound onto it. A write that skips this lands on top of the frame, and the
  frame is what the next erase is measured from."
  [text]
  (let [whole (str @pending-line text)
        i (str/last-index-of whole "\n")]
    (erase-input!)
    ;; Only COMPLETE lines go to the screen. The tail is kept and drawn as a
    ;; row of the block, so the terminal is never left holding half a row.
    (when i (out! (subs whole 0 (inc i))))
    (reset! pending-line (if i (subs whole (inc i)) whole))
    (redraw!)))

(defn- echo-submitted!
  "What was sent, left in the scrollback where the answer will follow it. The
  input area is erased on submit, so without this the transcript would show
  answers with no questions."
  [text]
  (let [skin ((:skin ctx-theme))
        colour (colour?)
        accent (or (:accent-code skin) splash/accent-code)
        prompt (:prompt skin)
        cont (or (:continuation skin) (.repeat " " (text/display-width prompt)))]
    (doseq [[i line] (map-indexed vector (str/split-lines text))]
      (println (str (text/paint colour accent (if (zero? i) prompt cont)) line)))))

(defn- measure-ambiguous-columns!
  "Ask the terminal how wide it draws U+276F, and believe the answer.

  Print the glyph at a known column, ask where the cursor ended up with
  `ESC[6n`, subtract. A terminal that does not answer within the timeout leaves
  the default standing, and says so: an unanswered query must not read as an
  answer of 1 (CLAUDE.md's second question)."
  []
  (js/Promise.
   (fn [resolve _]
     (if-not (and (.-isTTY js/process.stdin) (.-isTTY js/process.stdout))
       (resolve {:measured? false :columns @text/ambiguous-columns})
       (let [done (atom false)
             timer (atom nil)
             finish (fn [answer]
                      (when-not @done
                        (reset! done true)
                        (when @timer (js/clearTimeout @timer))
                        (.removeAllListeners js/process.stdin "data")
                        (out! (str "\r" esc "[2K"))
                        (resolve answer)))
             on-data (fn [chunk]
                       (when-let [m (re-find #"\[([0-9]+);([0-9]+)R" (str chunk))]
                         (finish {:measured? true
                                  :columns (text/set-ambiguous-columns!
                                            (dec (js/parseInt (nth m 2))))})))]
         (.on js/process.stdin "data" on-data)
         (reset! timer (js/setTimeout
                        #(finish {:measured? false :columns @text/ambiguous-columns})
                        300))
         (out! (str "\r" esc "[2K" "\u276f" esc "[6n")))))))

(defn- raw-mode! [on?]
  (when (.-isTTY js/process.stdin)
    (.setRawMode js/process.stdin on?)))

(defn- restore-terminal!
  "Put back what the editor switched on. Guarded, because these are bytes:
  under a pipe they are not a terminal being reset, they are `[?2004l[?25h`
  in somebody's log (measured 2026-09-06, in this file's own pipe test)."
  []
  (raw-mode! false)
  (when (.-isTTY js/process.stdout)
    (out! (str esc "[?2004l" esc "[?25h"))))

(defn- restore-terminal!
  "Put back what the editor switched on. Guarded, because these are bytes:
  under a pipe they are not a terminal being reset, they are `[?2004l[?25h`
  in somebody's log."
  []
  (raw-mode! false)
  (when (.-isTTY js/process.stdout)
    (out! (str esc "[?2004l" esc "[?25h"))))

(defn- flush-tail!
  "The incomplete last line lives in the block. When the block comes down for
  good it has to be written out, or the answer loses its last line."
  []
  (when (seq @pending-line)
    (out! (str @pending-line "\n"))
    (reset! pending-line "")))

(defn- bye! []
  (erase-input!)
  (flush-tail!)
  (restore-terminal!)
  (println)
  (js/process.exit exit-answered))

(defn- die! [e]
  (erase-input!)
  (flush-tail!)
  (restore-terminal!)
  (if (= "readline was closed" (ex-message e))
    (js/process.exit exit-answered)
    (do (js/process.stdout.write (str "error: " (ex-message e) "\n"))
        (js/process.exit exit-cannot-answer))))


;; ---------------------------------------------------------------------------
;; the turn, which no longer owns the keyboard (ADR-2609071400)
;;
;; A run used to take the terminal for its whole duration: the block was erased
;; when the turn started and drawn again when it ended, and the only key that
;; meant anything in between was ESC. So `/steer` -- a command whose entire
;; purpose is to reach a run that is ALREADY GOING -- could not be typed while
;; one was.
;;
;; Now the input loop and the turn are separate. The loop runs from the moment
;; the REPL opens until the process exits; a turn is state it reads. A slash
;; command runs the moment it is sent, a plain line starts a turn if none is in
;; flight and joins the queue if one is.
;; ---------------------------------------------------------------------------

(declare start-run! drain-queue!)

(defn- run-tick!
  "Advance the progress line while a turn is in flight. It is a row of the
  block, so this only has to ask for a redraw."
  []
  (when (:running @repl)
    (swap! repl update-in [:running :tick] (fnil inc 0))
    (redraw!)
    (js/setTimeout run-tick! 120)))

(defn- refused!
  "The server said no to a turn. In the REPL that ends the TURN, not the
  session: the editor is still open, the queue is still there, and an operator
  who typed one thing the server would not take has not asked to leave.

  The one-shot path (`itonami chat \"…\"`) keeps `exit 1` -- that is where a
  refusal has to be a status a script can read."
  [message]
  (swap! repl assoc :running nil)
  (say! (str (text/paint (colour?) "38;5;203" (str "✗ " message)) "\n"))
  ;; A refusal an operator can act on says what to do about it. This one is
  ;; the common one on a workstation whose Bots also carry resident jobs: the
  ;; run belongs to somebody else, so `/stop` -- which only knows THIS
  ;; session's run -- is not the answer, and saying so is the useful part.
  (when (str/includes? (str message) "すでに実行中")
    (say! (str (text/paint (colour?) splash/dim-code
                           (str "  この Bot は別の実行に使われています"
                                "（常駐ジョブか別セッション）。"
                                "`/bots` で状態を確認、`/profile <id>` で別の Bot に切り替えられます。"))
               "\n")))
  (when (seq (:queue @repl))
    (say! (str (text/paint (colour?) splash/dim-code
                           (str "待機中の " (count (:queue @repl))
                                " 件は送っていません (/queue で確認、/queue clear で破棄)"))
               "\n")))
  (redraw!))

(defn- finish-run!
  "One turn ended. Clear it, say what it cost, and start whatever was queued
  behind it."
  [o]
  (let [stopped? (:stopped (:running @repl))]
    (swap! repl assoc :running nil)
    (when-let [u (:usage o)]
      (say! (str (text/paint (colour?) splash/dim-code
                             (str "· tokens: " (or (:prompt_tokens u) "?")
                                  " in / " (or (:completion_tokens u) "?") " out"))
                 "\n")))
    (redraw!)
    (if (or (= "completed" (:status o)) stopped?)
      ;; The operator stopped this run, not this session.
      (drain-queue!)
      ;; A turn that failed on its own does not send the queue into a server
      ;; that just said no; the lines are left where they can be read.
      (refused! (or (:error o) (str "run は " (name (:status o)) " で終わりました"))))))

(defn- start-run!
  "Start one turn. `echo` is what goes in the transcript when that is not the
  text being sent: a project command expands to its whole skill body, and
  echoing ten kilobytes of instructions where the operator typed one line
  buries the conversation in the thing that produced it."
  ([t] (start-run! t t))
  ([t echo]
   (reset! (:last-input ctx-chat) t)
   (echo-submitted! echo)
  (swap! repl assoc :running {:started (js/Date.now) :phase nil :tokens 0
                              :tick 0 :run-id nil :stopped false})
  (run-tick!)
  (-> (request! {:method :post :path "/v1/runs"
                 :body {:input t :profile @chat-profile}
                 :timeout-seconds 30}
                (require-token!))
      (.then (fn [{:keys [status body]}]
               (if (<= 200 status 299)
                 (let [run-id (or (:run_id body) (:run-id body))]
                   (swap! repl assoc-in [:running :run-id] run-id)
                   (-> (chat-poll-events! run-id) (.then finish-run!)))
                 (refused! (str "run を開始できません: HTTP " status
                                (when-let [m (get-in body [:error :message])]
                                  (str " — " m)))))))
       (.catch (fn [e]
                 ;; Nothing answered. That is not a refusal and not the end of
                 ;; the session either -- the resident may come back.
                 (swap! repl assoc :running nil)
                 (say! (str (text/paint (colour?) "38;5;203"
                                        (str "✗ server に到達できません: " (base-url)))
                            "\n"))
                 (redraw!))))))

(defn- drain-queue! []
  (when-let [{:keys [text echo]} (first (:queue @repl))]
    (swap! repl update :queue subvec 1)
    (start-run! text echo)))

(defn- submit-message!
  ([t] (submit-message! t t))
  ([t echo]
   (if (:running @repl)
    ;; Queued rather than sent: two turns at once against one profile is two
    ;; conversations, and the server would interleave them.
     (do (swap! repl update :queue conj {:text t :echo echo})
         (say! (str (text/paint (colour?) splash/dim-code
                                (str "⏸ 待機列に追加 (" (count (:queue @repl))
                                     " 件): " (subs echo 0 (min 100 (count echo)))))
                    "\n"))
         (redraw!))
     (start-run! t echo))))

(defn- on-submit!
  "One line the operator sent. A slash command runs NOW, whatever the turn is
  doing -- that is the point of `/steer` and `/stop`."
  [t]
  (cond
    (contains? #{"exit" "quit"} t) (bye!)
    :else
    (let [r (chat-slash! t)]
      (cond
        (= :exit r) (bye!)
        ;; A handler that returns a panel is showing rather than saying.
        (and (map? r) (:panel r))
        (do (swap! repl assoc-in [:editor :panel] (:panel r)) (redraw!))
        (= :handled r) (redraw!)
        (= :resend r) (let [prev (str @(:last-input ctx-chat))]
                        (if (str/blank? prev) (redraw!) (submit-message! prev)))
        (instance? js/Promise r)
        ;; A handler may answer LATE with anything it could have answered with
        ;; at once -- a panel included. Handling only keywords here dropped
        ;; `/model`'s panel on the floor: the command ran, fetched, built the
        ;; panel, and the screen showed nothing (measured 2026-09-07).
        (-> r
            (.then (fn [v]
                     (cond
                       (and (map? v) (:panel v))
                       (do (swap! repl assoc-in [:editor :panel] (:panel v)) (redraw!))
                       (keyword? v) (on-submit! (str v))
                       :else (redraw!))))
            (.catch (fn [e] (say! (str "error: " (ex-message e) "\n")))))
        :else (submit-message! t)))))

(defn- interrupt!
  "ESC while a turn is in flight. What is printed is what the server answered,
  not that a request was made."
  []
  (when-let [{:keys [run-id]} (:running @repl)]
    (when (and run-id (not (:stopped (:running @repl))))
      (swap! repl assoc-in [:running :stopped] true)
      (-> (request! {:method :post :path (str "/v1/runs/" run-id "/stop")
                     :timeout-seconds 10}
                    (require-token!))
          (.then (fn [{:keys [status body]}]
                   (say! (str (text/paint (colour?) splash/dim-code
                                          (if (<= 200 status 299)
                                            "⎋ 中断しました"
                                            (str "⎋ 中断できません: HTTP " status
                                                 (when-let [m (get-in body [:error :message])]
                                                   (str " — " m)))))
                              "\n"))))
          (.catch (fn [e]
                    (swap! repl assoc-in [:running :stopped] false)
                    (say! (str (text/paint (colour?) splash/dim-code
                                           (str "⎋ 中断を送れません: " (base-url)
                                                " — " (ex-message e)))
                               "\n"))))))))

;; ---------------------------------------------------------------------------
;; passkey sign-in (ADR-2609073800)
;;
;; The ceremony happens in a real browser, because that is the only place
;; WebAuthn happens. This CLI never sees the passkey, never sees a password,
;; and never types into the form: it asks the server to start a flow, shows the
;; person the URL, and waits for a claim token to become claimable.
;;
;; `/api/auth/itonami/start {:handoff true}` returns that URL and a claim
;; token. The token is the entire authority, which is why the server keeps it
;; single-use and short-lived and why every refusal from the claim endpoint is
;; the same `{:ready? false}` -- a poller that guesses learns nothing from the
;; shape of the answer.
;; ---------------------------------------------------------------------------

(def ^:private identity-cookie "cloud_itonami_identity")

(defn- session-cookie-token
  "The session token out of a `Set-Cookie` header, or nil.

  The claim endpoint sends the session the way a browser is given one. The body
  it sends alongside carries `:ready?` and nothing secret, on purpose."
  [set-cookie]
  (text/cookie-value identity-cookie set-cookie))

(defn- passkey-login!
  "Start a sign-in and wait for the person to finish it in their browser.

  Resolves `{:ok true}` once a Passkey session is stored, or `{:ok false
  :reason …}`. Never throws: a sign-in that could not happen must not take the
  REPL with it."
  []
  (let [say (fn [text] (say! (str text "\n")))
        accent #(text/paint (colour?) splash/accent-code %)
        dim #(text/paint (colour?) splash/dim-code %)]
    (-> (request! {:method :post :path "/api/auth/itonami/start"
                   :body {:handoff true} :timeout-seconds 20}
                  (agent-token))
        (.then
         (fn [{:keys [status body]}]
           (if-not (<= 200 status 299)
             {:ok false :reason (str "sign-in を開始できません: HTTP " status
                                     (when-let [m (get-in body [:error :message])]
                                       (str " — " m)))}
             (let [url (:url body)
                   claim (:handoff body)
                   opened? (true? (:opened-externally? body))]
               (say "")
               (say (accent "Passkey でサインインしてください（DID はここで作られます）"))
               (say (dim (if opened?
                           "  ブラウザを開きました。開かなければ次の URL を開いてください:"
                           "  次の URL をブラウザで開いてください:")))
               (say (str "  " url))
               (say (dim "  終わるまでここで待ちます（esc で中止）"))
               (say "")
               ;; Poll rather than listen: the person may finish in a browser
               ;; on another machine, and nothing routes back to this process.
               (letfn [(poll [tries]
                         (if (zero? tries)
                           (js/Promise.resolve
                            {:ok false :reason "時間内にサインインが完了しませんでした"})
                           (-> (request! {:method :post
                                          :path "/api/auth/itonami/handoff"
                                          :body {:handoff claim}
                                          ;; Without this the claim is never
                                          ;; admitted and the poll runs to its
                                          ;; timeout with the person already
                                          ;; signed in — measured 2026-09-07.
                                          :headers {"origin" (server-origin)}
                                          :timeout-seconds 15}
                                         nil)
                               (.then (fn [{:keys [status body set-cookie]}]
                                        (if-let [token (and (<= 200 status 299)
                                                            (:ready? body)
                                                            (session-cookie-token set-cookie))]
                                          (do (keychain-put! human-keychain-account token)
                                              {:ok true :body body})
                                          (js/Promise.
                                           (fn [resolve _]
                                             (js/setTimeout
                                              #(resolve (poll (dec tries))) 2000))))))
                               (.catch (fn [e]
                                         {:ok false
                                          :reason (str "server に到達できません: "
                                                       (ex-message e))})))))]
                 ;; 90 tries at 2s is three minutes -- long enough to find a
                 ;; phone, short enough that a forgotten window stops polling.
                 (poll 90))))))
        (.catch (fn [e] {:ok false :reason (ex-message e)})))))

(defn- announce-login! [{:keys [ok reason body]}]
  (if ok
    (say! (str (text/paint (colour?) splash/accent-code
                           (str "✓ Passkey session を取得しました"
                                (when-let [u (:user-id body)] (str " (" u ")"))))
               "\n"))
    (say! (str (text/paint (colour?) "38;5;203" (str "✗ サインインできません: " reason))
               "\n"
               (text/paint (colour?) splash/dim-code
                           (str "  agent session のまま続けます。"
                                "model routing・資金面など human session が要る操作は"
                                " 403 のままです（/login でやり直せます）。"))
               "\n"))))

(register-slash!
 "/login" "" "Passkey でサインインして human session を取る"
 (fn [_ _]
   (-> (passkey-login!)
       (.then (fn [r] (announce-login! r) (redraw!))))))

(defn- wallet-panel
  "The smart account the Passkey owns.

  Coinbase Smart Wallet's model, which this app already implements: the account
  is an ERC-4337 contract whose OWNER is the WebAuthn P-256 key, its address is
  computed counterfactually from that key by the factory's
  `getAddress(bytes[],uint256)`, and no private key is stored anywhere. So
  there is no separate wallet to sign in with -- signing in with the Passkey is
  what produces the account (ADR-2609075000)."
  [w]
  (let [a (:principal-account w)
        cap (:capabilities w)
        yes (fn [v] (cond (true? v) "できます" (false? v) "できません" :else (str v)))
        ;; "private key stored できません" reads as a missing capability. It is
        ;; the opposite: nothing is stored because nothing needs to be.
        held (fn [v] (cond (true? v) "保存しています" (false? v) "保存していません"
                           :else (str v)))]
    {:title "wallet"
     :tab 0 :scroll 0
     :tabs
     [{:label "Account"
       :lines (if-not (:address a)
                ["Smart account がまだありません。"
                 "Passkey でサインインすると、その公開鍵から住所が決まります（/login）。"]
                [(str "address        " (:address a))
                 (str "owner          " (:owner-kind a) "  (" (:owner-model a) ")")
                 (str "factory        " (:factory-family a) " " (:factory-version a))
                 (str "entry point    " (:entry-point-version a))
                 (str "deployment     " (:deployment-state a))
                 (str "same address across chains  "
                      (yes (:same-address-across-chains? a)))
                 (str "private key                 "
                      (held (:private-key-stored? a)))
                 ""
                 "住所は Passkey の公開鍵から決まります（counterfactual）。"
                 "まだ deploy されていなくても受け取りには使えます。"])}
      {:label "Chains"
       :lines (vec (for [c (:supported-chains w)]
                     (str (text/pad-right (str (:name c)) 20)
                          "chain-id " (:chain-id c)
                          (when (:network c) (str "  " (:network c)))
                          "   owner UserOperation: "
                          (yes (:owner-user-operation-ready? c)))))}
      {:label "Capabilities"
       :lines (vec (concat
                    [(str "provider   " (:wallet-provider w))
                     (str "private keys         " (held (:private-keys-stored? w)))
                     ""]
                    (for [[k v] cap] (str (text/pad-right (name k) 22) (yes v)))
                    [""
                     "`pending` は「その UserOperation 経路がまだ通っていない」で、"
                     "「権限が無い」ではありません。"]))}]}))

(register-slash!
 "/wallet" "" "Passkey が所有する smart account"
 (fn [_ _]
   (-> (request! {:method :get :path "/api/wallet" :timeout-seconds 15} (session-token))
       (.then (fn [{:keys [status body]}]
                (if (<= 200 status 299)
                  {:panel (wallet-panel body)}
                  {:panel {:title "wallet" :tab 0 :scroll 0
                           :tabs [{:label "読めません"
                                   :lines [(str "wallet を読めません (HTTP " status ")")
                                           (if (human-token)
                                             "human session はありますが拒否されました。"
                                             "human session がありません。/login を実行してください。")]}]}})))
       (.catch (fn [e]
                 {:panel {:title "wallet" :tab 0 :scroll 0
                          :tabs [{:label "読めません"
                                  :lines [(str "server に到達できません: " (base-url))
                                          (ex-message e)]}]}})))))

(register-slash!
 "/whoami-session" "" "いま何の session で話しているか"
 (fn [_ _]
   (println (str "session: " (cond (human-token) "passkey (human)"
                                   (agent-token) "agent"
                                   :else "なし")))
   (println (str "  passkey: " (if (human-token) "あり" "なし")
                 "   agent: " (if (agent-token) "あり" "なし")))
   (println "  human session が要る面: model routing / 資金・決済 / wallet connect")
   :handled))

(defn- registry-entries
  "What the slash menu offers: every registered command, name and description."
  []
  (vec (for [e ((:entries ctx-chat))]
         {:name (:name e) :description (str (:description e))})))

(defn- apply-choice!
  "Carry out what was picked in a panel.

  The panel is data and the editor is pure, so choosing produces a VALUE and
  the effect happens here. A panel that acted for itself would put an HTTP
  call inside `handle`, and the key semantics would stop being testable."
  [{:keys [panel item]}]
  (let [tab (editor/panel-tab panel)]
    (if-not (and (:task tab) (:model item))
      (redraw!)
      (-> (request! {:method :post :path "/api/bots/model-routing"
                     :body {:task (:task tab) :scope (:scope tab)
                            :provider-id (:provider-id item) :model (:model item)}
                     :timeout-seconds 15}
                    (session-token))
          (.then (fn [{:keys [status body]}]
                   (if (<= 200 status 299)
                     (say! (str (text/paint (colour?) splash/accent-code
                                            (str "✓ " (:label tab) " → " (:model item)
                                                 " (" (:provider-id item) ")"))
                                "\n"))
                     (say! (str (text/paint (colour?) "38;5;203"
                                            (str "✗ 変更できません: HTTP " status
                                                 (when-let [m (get-in body [:error :message])]
                                                   (str " — " m))))
                                "\n")))
                   (redraw!)))
          (.catch (fn [e]
                    (say! (str (text/paint (colour?) "38;5;203"
                                           (str "✗ server に到達できません: " (ex-message e)))
                               "\n"))
                    (redraw!)))))))

(defn- input-loop!
  "The keyboard, from the moment the REPL opens until the process exits.

  One listener for the life of the session. It used to be one listener PER
  TURN, attached when a line was wanted and removed when it arrived, which is
  what made the keyboard go dead while a run was going."
  []
  ;; The registry, handed to the editor once: it is fixed after startup, and
  ;; the menu is a function of the buffer and this list.
  (swap! repl assoc :editor (editor/fresh @repl-history (registry-entries)))
  (let [on-data
        (fn [chunk]
          (let [ks (editor/decode (str chunk))]
            (if (and (:running @repl) (some #(= :escape (:kind %)) ks))
              ;; ESC means the run while there is one, and nothing to the
              ;; editor either way.
              (interrupt!)
              (let [{:keys [state submits signal redraw?]}
                    (editor/step (:editor @repl) ks)]
                (swap! repl assoc :editor state)
                (reset! repl-history (:history state))
                ;; Redraw BEFORE dispatching. This is the line whose absence
                ;; made typing invisible: the old loop redrew only on the
                ;; branches that happened to remember, and after the input loop
                ;; was separated from the turn, the ordinary branch -- a
                ;; character -- was not one of them.
                (when redraw? (draw-input! state))
                (when-let [chose (:chose state)]
                  (swap! repl update :editor dissoc :chose)
                  (apply-choice! chose))
                (doseq [line submits] (on-submit! (str/trim line)))
                (case signal
                  :eof (bye!)
                  :interrupt (say! (str (text/paint (colour?) splash/dim-code
                                                    "(exit または Ctrl+D で終了)")
                                        "\n"))
                  nil)))))]
    (.on js/process.stdin "data" on-data)
    (.on js/process.stdout "resize" #(when (:editor @repl) (draw-input! (:editor @repl))))
    (draw-input! (:editor @repl))))

(defn- readline-repl!
  "The same REPL for a stdin that is not a terminal: no frame, no raw mode, no
  queue -- readline hands over one line at a time and waits, which is the shape
  it is good at."
  []
  (let [rl (js/require "node:readline/promises")
        iface (.createInterface rl #js {:input js/process.stdin
                                        :output js/process.stdout})]
    (letfn [(turn []
              (-> (.question iface (:prompt ((:skin ctx-theme))))
                  (.then (fn [line]
                           (let [t (str/trim (str line))]
                             (cond
                               (str/blank? t) (turn)
                               (contains? #{"exit" "quit"} t)
                               (js/process.exit exit-answered)
                               :else
                               (let [r (chat-slash! t)]
                                 (cond
                                   (= :exit r) (js/process.exit exit-answered)
                                   (= :handled r) (turn)
                                   (instance? js/Promise r)
                                   (-> r (.then (fn [_] (turn))) (.catch die!))
                                   :else
                                   (-> (request! {:method :post :path "/v1/runs"
                                                  :body {:input t :profile @chat-profile}
                                                  :timeout-seconds 30}
                                                 (require-token!))
                                       (.then (fn [{:keys [status body]}]
                                                (if (<= 200 status 299)
                                                  (chat-poll-events!
                                                   (or (:run_id body) (:run-id body)))
                                                  (refuse! (str "run を開始できません: HTTP "
                                                                status)
                                                           (select-keys body [:error])))))
                                       (.then (fn [o]
                                                (when-let [u (:usage o)]
                                                  (println (str "· tokens: "
                                                                (or (:prompt_tokens u) "?")
                                                                " in / "
                                                                (or (:completion_tokens u) "?")
                                                                " out")))
                                                (if (= "completed" (:status o))
                                                  (turn)
                                                  (js/process.exit exit-refused))))
                                       (.catch die!))))))))
                  (.catch (fn [_] (js/process.exit exit-answered)))))]
      (turn))))

(defn- chat-repl! []
  (if (and (.-isTTY js/process.stdout) (.-isTTY js/process.stdin))
    (do
      (raw-mode! true)
      (.setEncoding js/process.stdin "utf8")
      (.resume js/process.stdin)
      ;; Bracketed paste: without it a pasted newline is the same byte as
      ;; Return, so pasting three lines sends the first and loses the rest.
      (out! (str esc "[?2004h"))
      (.on js/process "exit" (fn [_] (restore-terminal!)))
      ;; Every `println` in a slash command lands above the block from here on.
      ;; A write that skips `say!` lands on top of the frame, and the frame is
      ;; what the next erase is measured from.
      ;; nbb hands `*print-fn*` a line WITHOUT its newline, so the newline is
      ;; added here -- otherwise every `println` ends mid-row and the block is
      ;; drawn over it.
      (set! *print-fn* (fn [line] (say! (str line "\n"))))
      (input-loop!))
    (readline-repl!)))

(defn- chat-prompt-loop!
  "Open the REPL: resolve the profile, draw the start screen, then prompt."
  []
  ;; The REPL resolves its starting profile the same way the one-shot entry
  ;; does. Without this the screen would print `default` while `itonami chat
  ;; "..."` in the same directory used the repository's -- one command, two
  ;; answers, and the screen would be the one that lied.
  (when-let [id (or (some-> (aget js/process.env "ITONAMI_PROFILE") str/trim not-empty)
                    (:profile/id (repo-profile!)))]
    (reset! chat-profile id))
  ;; The start screen is for a terminal. Under a pipe there is nobody to read
  ;; a frame, the width is a guess, and the colour would be bytes in somebody's
  ;; log -- so that case keeps the one line it had.
  (if (tty?)
    ;; Ask the terminal how wide it draws an ambiguous glyph BEFORE the first
    ;; frame: every width on the screen after this depends on the answer, and
    ;; the probe needs raw mode, which the editor turns on for good anyway.
    (-> (js/Promise.resolve)
        (.then (fn [_]
                 (raw-mode! true)
                 (.setEncoding js/process.stdin "utf8")
                 (.resume js/process.stdin)
                 (measure-ambiguous-columns!)))
        (.then (fn [m]
                 (when-not (:measured? m)
                   (err (str "itonami: 端末が文字幅を答えませんでした。"
                             "ambiguous 幅 " (:columns m) " で続けます。")))
                 (print-splash!)))
        ;; Sign in on open (owner instruction 2026-09-07), because the DID is
        ;; made here and because half the surface refuses an agent session.
        ;;
        ;; NOT a hard gate. A browser that will not open, a laptop with no
        ;; network, a person who wants to read `/help` first -- none of those
        ;; is a reason to make the CLI unusable, and a required step that can
        ;; fail for reasons outside the room is a lock-out waiting to happen.
        ;; It runs, it says what is lost if it does not finish, and `/login`
        ;; does it again.
        (.then (fn [_]
                 (if (human-token)
                   (js/Promise.resolve nil)
                   (-> (passkey-login!) (.then announce-login!)))))
        (.then chat-repl!))
    (do (println (str (:banner ((:skin ctx-theme)))
                      "  profile: " @chat-profile " (" (profile-source) ")"
                      " — /help で一覧、exit で終了"))
        (chat-repl!))))

(defn- chat!
  "Entry: `itonami chat [--profile <p>] [first message]`. A message on the
  command line runs one turn and exits; without one, the REPL starts."
  [argv json?]
  (let [profile (or (some-> (:profile (commands/parse-flags argv)) str/trim not-empty)
                    (some-> (aget js/process.env "ITONAMI_PROFILE") str/trim not-empty)
                    (:profile/id (repo-profile!))
                    chat-default-profile)
        words (commands/words (drop 1 (drop-while #(not= "chat" %) argv)))
        text (str/join " " words)]
    (if (seq words)
      ;; one-shot: `itonami chat hello` runs one streaming turn and exits
      (let [start! (fn []
                     (request! {:method :post :path "/v1/runs"
                                :body {:input text :profile profile}}
                               (require-token!)))
            report (fn [out]
                     ;; --json still gets the machine-readable final map;
                     ;; interactive one-shot already streamed the answer text.
                     (if json?
                       (emit! out true)
                       (when-let [u (:usage out)]
                         (println (str "· tokens: " (or (:prompt_tokens u) "?")
                                       " in / " (or (:completion_tokens u) "?") " out")))))]
        (-> (start!)
            (.then (fn [{:keys [status body]}]
                     (if (<= 200 status 299)
                       (-> (chat-poll-events! (or (:run_id body) (:run-id body)))
                           (.then (fn [out]
                                    ;; The run started but the turn failed on
                                    ;; the stream (disabled Bot, provider
                                    ;; denial): that is the server refusing,
                                    ;; exit 1 — not a silent success.
                                    (if (= "completed" (:status out))
                                      (report out)
                                      (refuse! (or (:error out)
                                                   (str "run は "
                                                        (name (:status out))
                                                        " で終わりました"))
                                               (select-keys out [:error]))))))
                       (refuse! (str "run を開始できません: HTTP " status)
                                (select-keys body [:error]))))))
        nil)
      (chat-prompt-loop!))))

(defn- suggest
  "Commands whose name contains the FIRST word.

  The whole phrase is the wrong query for a mistyped command: `bots lst` shares
  no substring with anything, and an empty list of suggestions reads as though
  the group does not exist either. The first word is the part an operator
  usually has right."
  [words]
  (when-let [head (first words)]
    (let [named (map #(str/join " " (:command %)) (commands/alias-commands))
          generated (map commands/command-name (commands/matching [head]))]
      (vec (take 8 (concat (filter #(str/includes? % head) named) generated))))))

;; After every built-in is registered, so the collision check sees all of them.
(def ^:private project-command-report
  ;; Forced HERE and not at first use: the delay registers, and registering has
  ;; to happen after every built-in exists (that is what the collision check
  ;; reads) but before -main dispatches anything.
  @project-commands)

(defn -main [& argv]
  (let [argv (vec argv)
        flags (commands/parse-flags argv)
        json? (true? (:json flags))
        named (commands/words argv)]
    (cond
      (= "--dump-config" (first argv))
      (dump-config!)

      (or (= ["help"] named) (true? (:help flags))
          ;; Argless on a terminal opens the REPL; argless under a pipe prints
          ;; this, because a REPL with nobody at it would hang a script that
          ;; used to get help. `--json` with no command asks for a value this
          ;; has none of, so it lands here too rather than on a screen.
          (and (empty? named) (or json? (not (tty?)))))
      (do (println (str "itonami — cloud-itonami-app の front end\n\n"
                        "  itonami                                   agent と対話 (REPL を開く)\n"
                        "  itonami chat [--profile <p>] [message …]  同上。message があれば 1 ターンで終了\n"
                        "  itonami commands [term …]                 使える command を検索\n"
                        "  itonami status                            server と store の状態\n"
                        "  itonami profile explain                   どの profile が効いているか\n"
                        "  itonami <command> [--flag value …] [--json]\n\n"
                        "REPL の slash command:\n" ((:help-text ctx-chat)) "\n\n"
                        "パイプ・非 TTY・--json では REPL を開かず、この help を出します。\n\n"
                        "commands: " (count (commands/all)) " (generated) + "
                        (count (commands/alias-commands)) " (named)\n"
                        "exit 0 answered / 1 refused / 2 could not answer"))
          (js/process.exit exit-answered))

      ;; What `claude` and `hermes-agent` do with no arguments, and what the
      ;; help text above had already begun promising while `-main` still
      ;; exited here (ADR-2609062240).
      (empty? named) (chat! argv json?)

      (= "commands" (first named)) (commands! (vec (drop 1 named)) json?)
      (= ["status"] named) (status! json?)
      (= "chat" (first named)) (chat! argv json?)
      (= ["profile" "explain"] named) (profile-explain! json?)

      (contains? #{["up"] ["down"]} named)
      (cannot-answer!
       (str "この front end は server を起動・停止しません。\n"
            "  常駐: launchctl kickstart -k gui/$(id -u)/dev.cloud-itonami.app")
       {:type :client/not-a-supervisor :command (first named)})

      :else
      (let [{:keys [kind] :as invocation} (commands/resolve-invocation argv)]
        (case kind
          :alias (run-alias! invocation json?)
          :registry (run-registry! invocation json?)
          :host-side
          (cannot-answer!
           (str "`" (str/join " " (:command (:command invocation)))
                "` はサーバを通らない host 側の処理で、この front end にはまだ無い。\n"
                "  理由: " (:why (:command invocation)))
           {:type :client/host-side-command})
          :unknown
          (cannot-answer!
           (str "そのような command はありません: " (str/join " " named))
           {:type :client/unknown-command
            :near (suggest named)}))))))

(apply -main (or *command-line-args* []))
