#!/usr/bin/env nbb
;; MCP stdio host. Does not spawn java or clojure.
;;
;; Protocol admission is the guest export `protocol-ok?` from `mcp_main.wasm`.
;; Duplicating that predicate here is not the guest running — this file loads
;; the wasm and calls into it. Guest `main` must not stay 0.
;;
;; JSON-RPC stays on stdin/stdout. Fleet search reads the shipped catalog
;; EDN. Outbound `fleet_call` is not published.

(ns itonami-mcp
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:readline" :as readline]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [nbb.classpath :as classpath]
            [nbb.core :refer [*file*]]))

(def app-directory
  (fs/realpathSync (path/resolve (path/dirname *file*) "..")))

(def home-directory
  (when-let [home (aget js/process.env "HOME")]
    (try (fs/realpathSync home) (catch :default _ home))))
(def resident-app-directory
  (when home-directory (path/resolve home-directory ".cloud-itonami" "app")))

(when (and resident-app-directory
           (= app-directory resident-app-directory)
           (nil? (aget js/process.env "CLOUD_ITONAMI_DATA_DIR")))
  (aset js/process.env "CLOUD_ITONAMI_DATA_DIR"
        (path/resolve home-directory ".cloud-itonami" "data")))


;; `--print-data-dir` is answered from this file alone, before the guest
;; namespace is resolved. A resident install copies the launcher by itself, so
;; "where is your store" must not depend on a sibling being present.
(when (= "--print-data-dir" (first *command-line-args*))
  (println (or (aget js/process.env "CLOUD_ITONAMI_DATA_DIR") ""))
  (println (or (aget js/process.env "CLOUD_ITONAMI_APP_DIR") app-directory))
  (js/process.exit 0))

;; Resolved from THIS file's directory, not the caller's.
;;
;; Measured 2026-09-02: requiring `guest-runtime` through the ns form made this
;; launcher die with "Could not find namespace" unless the caller remembered
;; `--classpath bin` -- a launcher that cannot be started by its own shebang.
;; `resident-mcp-launcher-does-not-spawn-clojure` had been red on exactly that
;; since the launcher landed.
(classpath/add-classpath (path/resolve app-directory "bin"))
(require '[guest-runtime :as guest])

(def server-name "cloud-itonami-fleet")
(def server-version "1")
(def latest-protocol-version "2025-11-25")

(def catalog-path
  (path/resolve app-directory "resources" "itonami-fleet-catalog.edn"))

(defn- load-catalog []
  (when-not (fs/existsSync catalog-path)
    (throw (ex-info "fleet catalog resource missing"
                    {:type :fleet/catalog-missing :path catalog-path})))
  (edn/read-string (fs/readFileSync catalog-path "utf8")))

(def catalog (delay (load-catalog)))

(defn- actors []
  (or (:actors @catalog) []))

(defn- matches-text? [actor q]
  (let [q (str/lower-case (str q))]
    (some (fn [v] (and v (str/includes? (str/lower-case (str v)) q)))
          [(:id actor) (:name actor) (:domain actor)])))

(defn- isic-of [actor]
  (or (:isic actor) (:isic-rev5 actor) (:isic-rev4 actor)))

(defn- callable? [actor]
  (boolean (and (:endpoint actor) (seq (str (:endpoint actor))))))

(defn- search [criteria]
  (let [{:keys [text domain governor maturity status isic iso3166 execution role]
         want-callable :callable?} criteria]
    (cond->> (actors)
      text (filter #(matches-text? % text))
      domain (filter #(= domain (:domain %)))
      governor (filter #(= governor (:governor %)))
      maturity (filter #(= maturity (:maturity %)))
      status (filter #(= status (:status %)))
      isic (filter #(= isic (isic-of %)))
      iso3166 (filter #(= iso3166 (:iso3166 %)))
      execution (filter #(= execution (:execution %)))
      role (filter #(= role (:role %)))
      (some? want-callable) (filter #(= (boolean want-callable) (callable? %)))
      true vec)))

(defn- keywordize [m]
  (into {} (map (fn [[k v]] [(keyword k) v])) (or m {})))

(defn- kw [v]
  (when (and v (seq (str v))) (keyword (str v))))

(defn search-tool [input]
  (when-not (= "cloud.itonami.fleet-catalog.v1" (str (:schema @catalog)))
    (throw (ex-info "fleet catalog schema mismatch"
                    {:type :fleet/schema-mismatch})))
  (let [limit (min 100 (max 1 (or (:limit input) 20)))
        hits (search (cond-> {}
                       (:text input) (assoc :text (:text input))
                       (:domain input) (assoc :domain (kw (:domain input)))
                       (:isic input) (assoc :isic (str (:isic input)))
                       (:iso3166 input) (assoc :iso3166 (str (:iso3166 input)))
                       (:maturity input) (assoc :maturity (kw (:maturity input)))
                       (:execution input) (assoc :execution (kw (:execution input)))
                       (contains? input :callable) (assoc :callable? (true? (:callable input)))))]
    {:matched (count hits)
     :returned (min limit (count hits))
     :actors (mapv #(select-keys % [:repo :id :name :domain :governor :maturity
                                    :execution :role :endpoint :endpoint-kind])
                   (take limit hits))}))

(def tools
  [{:name "fleet_search"
    :description (str "Query the bundled actor catalog. No network. "
                      "fleet_call is not on this nbb host — leftover JVM.")
    :inputSchema {:type "object"
                  :properties
                  {:text {:type "string"}
                   :domain {:type "string"}
                   :isic {:type "string"}
                   :iso3166 {:type "string"}
                   :maturity {:type "string"}
                   :execution {:type "string"}
                   :callable {:type "boolean"}
                   :limit {:type "integer"}}}}])

(defn- write-json [value]
  (.write js/process.stdout (str (js/JSON.stringify (clj->js value)) "\n")))

(defn- result [id value]
  {"jsonrpc" "2.0" "id" id "result" value})

(defn- err [id code message]
  {"jsonrpc" "2.0" "id" id "error" {"code" code "message" message}})

(defn respond [hosted guest-main request]
  (when (contains? request "id")
    (let [id (get request "id")
          method (get request "method")
          params (get request "params")]
      (case method
        "initialize"
        (let [requested (get params "protocolVersion")
              version (if (guest/call-bool hosted "protocol-ok?" (str requested))
                        requested
                        latest-protocol-version)]
          (result id {"protocolVersion" version
                      "capabilities" {"tools" {}}
                      "serverInfo" {"name" server-name
                                    "version" server-version}
                      "runtime" "guest-wasm"
                      "guest-main" guest-main}))

        "ping"
        (result id {})

        "tools/list"
        (result id {"tools" (mapv (fn [t]
                                    {"name" (:name t)
                                     "description" (:description t)
                                     "inputSchema" (:inputSchema t)})
                                  tools)})

        "tools/call"
        (let [tool-name (get params "name")
              args (keywordize (get params "arguments"))]
          (if (= "fleet_search" tool-name)
            (try
              (result id {"content" [{"type" "text"
                                      "text" (js/JSON.stringify (clj->js (search-tool args)))}]})
              (catch :default e
                (result id {"isError" true
                            "content" [{"type" "text"
                                        "text" (or (.-message e) (str e))}]})))
            (result id {"isError" true
                        "content" [{"type" "text"
                                    "text" (str "unknown tool: " tool-name)}]})))

        (err id -32601 (str "method not found: " method))))))

(defn- handle-line [hosted guest-main line]
  (if (str/blank? line)
    nil
    (if-let [request (try (js->clj (js/JSON.parse line))
                          (catch :default _ nil))]
      (when-let [response (respond hosted guest-main request)]
        (write-json response))
      (write-json {"jsonrpc" "2.0" "id" nil
                   "error" {"code" -32700 "message" "parse error"}}))))

(defn- start-stdio [hosted guest-main]
  (aset js/process.env "CLOUD_ITONAMI_APP_DIR" app-directory)
  (let [rl (.createInterface readline
                             #js {:input js/process.stdin
                                  :crlfDelay js/Infinity})]
    (.on rl "line" (fn [line] (handle-line hosted guest-main line)))
    (.on rl "close" (fn [] (js/process.exit 0)))))

(defn -main [& args]
  (when (= "--print-data-dir" (first args))
    (println (or (aget js/process.env "CLOUD_ITONAMI_DATA_DIR") ""))
    (println (or (aget js/process.env "CLOUD_ITONAMI_APP_DIR") app-directory))
    (js/process.exit 0))
  (-> (guest/load-guest app-directory "target/amu/mcp_main.wasm")
      (.then
       (fn [loaded]
         (let [hosted (.-hosted loaded)
               guest-main (.-main loaded)]
           (when-not (pos? guest-main)
             (throw (ex-info "guest main stayed 0; unused guest is not a run"
                             {:guest-main guest-main})))
           (start-stdio hosted guest-main))))
      (.catch
       (fn [e]
         (binding [*print-fn* *print-err-fn*]
           (println (or (.-stack e) (str e))))
         (js/process.exit 1)))))

(apply -main (or *command-line-args* []))
