#!/bin/bash
set -euo pipefail

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
source_commit="${CLOUD_ITONAMI_SOURCE_COMMIT:-}"
release_channel="${CLOUD_ITONAMI_RELEASE_CHANNEL:-preview}"
if [[ ! "$source_commit" =~ ^[0-9a-f]{40}$ ]]; then
  echo "CLOUD_ITONAMI_SOURCE_COMMIT must be the released 40-character commit" >&2
  exit 1
fi

case "$release_channel" in
  preview) ;;
  stable)
    if [[ "${CLOUD_ITONAMI_CODESIGN_IDENTITY:-}" != "Developer ID Application:"* ]]; then
      echo "stable release requires a Developer ID Application identity" >&2
      exit 1
    fi
    if [[ "${CLOUD_ITONAMI_NOTARIZE:-0}" != "1" ]]; then
      echo "stable release requires CLOUD_ITONAMI_NOTARIZE=1" >&2
      exit 1
    fi
    if [[ -z "${CLOUD_ITONAMI_WINDOWS_PFX:-}" ||
          -z "${CLOUD_ITONAMI_WINDOWS_PFX_PASSWORD_FILE:-}" ]]; then
      echo "stable release requires a Windows Authenticode PKCS#12 identity" >&2
      exit 1
    fi
    ;;
  *)
    echo "CLOUD_ITONAMI_RELEASE_CHANNEL must be preview or stable" >&2
    exit 1
    ;;
esac

cd "$repo_dir"
scripts/build-macos-release
scripts/build-windows-release
CLOUD_ITONAMI_SOURCE_COMMIT="$source_commit" clojure -M:release-sign

version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' packaging/macos/Info.plist)"
cd target/release
/usr/bin/shasum -a 256 \
  "Cloud-Itonami-${version}-macOS-arm64.dmg" \
  "Cloud-Itonami-${version}-macOS-arm64.zip" \
  "Cloud-Itonami-${version}-Windows-x64.zip" \
  update-manifest.edn > SHA256SUMS
cat SHA256SUMS
