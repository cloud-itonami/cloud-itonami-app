#!/bin/bash
set -euo pipefail

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$repo_dir/packaging/macos/Info.plist")"
arch="$(uname -m)"
release_dir="$repo_dir/target/release"
app_bundle="$release_dir/Cloud Itonami.app"
contents_dir="$app_bundle/Contents"
stage_dir="$release_dir/dmg-root"
dmg="$release_dir/Cloud-Itonami-${version}-macOS-${arch}.dmg"
zip="$release_dir/Cloud-Itonami-${version}-macOS-${arch}.zip"

shell_dir="${KOTOBA_SHELL_DIR:-}"
if [[ -z "$shell_dir" ]]; then
  shell_src="$(clojure -Spath | tr ':' '\n' | /usr/bin/grep '/io.github.kotoba-lang/shell/' | /usr/bin/grep '/src$' | /usr/bin/head -n 1)"
  shell_dir="${shell_src%/src}"
fi
if [[ ! -x "$shell_dir/bin/kotoba-shell-build-macos-window" ]]; then
  echo "kotoba-lang/shell checkout not found; set KOTOBA_SHELL_DIR" >&2
  exit 1
fi

cd "$repo_dir"
clojure -T:build uber

mkdir -p "$contents_dir/MacOS" "$contents_dir/Resources"
cp packaging/macos/Info.plist "$contents_dir/Info.plist"
cp packaging/macos/CloudItonami "$contents_dir/MacOS/CloudItonami"
cp packaging/macos/ApplyUpdateMacos "$contents_dir/Resources/ApplyUpdateMacos"
cp target/release/cloud-itonami-app.jar "$contents_dir/Resources/cloud-itonami-app.jar"
cp resources/cloud/itonami/app/icon.png "$contents_dir/Resources/icon.png"
chmod 755 "$contents_dir/MacOS/CloudItonami"
chmod 755 "$contents_dir/Resources/ApplyUpdateMacos"

"$shell_dir/bin/kotoba-shell-build-macos-window" "$contents_dir/MacOS/kotoba-shell-host"

iconset="$release_dir/CloudItonami.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  /usr/bin/sips -z "$size" "$size" resources/cloud/itonami/app/icon.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  /usr/bin/sips -z "$double" "$double" resources/cloud/itonami/app/icon.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
/usr/bin/iconutil -c icns "$iconset" -o "$contents_dir/Resources/CloudItonami.icns"

codesign_identity="${CLOUD_ITONAMI_CODESIGN_IDENTITY:--}"
/usr/bin/codesign --force --deep --options runtime --sign "$codesign_identity" "$app_bundle"
/usr/bin/codesign --verify --deep --strict --verbose=2 "$app_bundle"

mkdir -p "$stage_dir"
cp -R "$app_bundle" "$stage_dir/Cloud Itonami.app"
ln -s /Applications "$stage_dir/Applications"
/usr/bin/hdiutil create -volname "Cloud Itonami" -srcfolder "$stage_dir" -ov -format UDZO "$dmg"
/usr/bin/ditto -c -k --sequesterRsrc --keepParent "$app_bundle" "$zip"

cd "$release_dir"
/usr/bin/shasum -a 256 "$(basename "$dmg")" "$(basename "$zip")" > SHA256SUMS
printf 'Built:\n  %s\n  %s\n  %s\n' "$dmg" "$zip" "$release_dir/SHA256SUMS"
