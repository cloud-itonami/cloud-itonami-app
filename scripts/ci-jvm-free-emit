#!/usr/bin/env bash
# CI: amu --jvm-free emit + public kotoba compile launcher.
# Java/clojure must not be on PATH. kexe verify on Linux stays HOLD.
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# nbb lives in this app's node_modules. Put it on PATH before the JVM filter.
if [[ -d "$root/node_modules/.bin" ]]; then
  PATH="$root/node_modules/.bin:$PATH"
  export PATH
fi

echo "honesty: bin/kotoba is this app's compile adapter, not the production kotoba v0.6.29 binary"

pin_sha() {
  local key="$1"
  node --input-type=module -e "
    import fs from 'node:fs';
    const text = fs.readFileSync('compiler-pin.edn','utf8');
    const re = new RegExp(':' + process.argv[1] + '\\\\s*\\\\{[^}]*:git/sha\\\\s+\\\"([0-9a-f]+)\\\"');
    const m = text.match(re);
    if (!m) { console.error('pin missing', process.argv[1]); process.exit(1); }
    console.log(m[1]);
  " "${key#:}"
}

amu_sha="$(pin_sha :amu)"
lang_sha="$(pin_sha :kotoba-lang)"
kbb_sha="$(pin_sha :kbb)"
echo "compiler freeze kotoba-lang@${lang_sha}"
echo "amu emit frontend @${amu_sha}"

# kbb: the launcher this cutover runs everything through (kotoba-lang/kotoba
# bin/kbb) plus its engine (kotoba-lang/org-babashka-nbb — nbb with .cljk
# classpath resolution). Pinned to the :kbb entry in compiler-pin.edn (the kbb
# cutover merge); kbb is a launcher here, not a runtime bump.
kbb_home="${KBB_CHECKOUT:-$root/target/kbb-checkout}"
if [[ ! -x "$kbb_home/bin/kbb" ]]; then
  rm -rf "$kbb_home"
  git clone --depth 5 https://github.com/kotoba-lang/kotoba.git "$kbb_home"
  git -C "$kbb_home" fetch --depth 20 origin "$kbb_sha"
  git -C "$kbb_home" checkout --detach "$kbb_sha"
fi
engine="${KBB_ENGINE:-$kbb_home/../org-babashka-nbb/cli.js}"
if [[ ! -f "$engine" ]]; then
  engine_dir="$root/target/kbb-engine-checkout"
  if [[ ! -f "$engine_dir/cli.js" ]]; then
    rm -rf "$engine_dir"
    git clone --depth 5 https://github.com/kotoba-lang/org-babashka-nbb.git "$engine_dir"
  fi
  engine="$engine_dir/cli.js"
fi
export KBB_ENGINE="$engine"
PATH="$kbb_home/bin:$PATH"
export PATH
# Force the amu emitter: without this bin/kotoba probes for a native kotoba
# CLI on PATH, and the kotoba launcher the kbb checkout ships cannot run on a
# JVM-free runner (its own path needs the JVM; measured 2026-09-13, CI failed
# with "native kotoba CLI did not emit" after a 30-dep classpath refusal).
export KOTOBA_EMITTER=amu
if [[ ! -f "$KBB_ENGINE" ]]; then
  echo "kbb engine missing: $KBB_ENGINE" >&2
  exit 1
fi

checkout="${AMU_CHECKOUT:-$root/target/amu-checkout}"
if [[ ! -x "$checkout/bin/amu" ]]; then
  rm -rf "$checkout"
  git clone --depth 80 https://github.com/kotoba-lang/amu.git "$checkout"
  git -C "$checkout" fetch --depth 80 origin "$amu_sha"
  git -C "$checkout" checkout --detach "$amu_sha"
  (cd "$checkout" && npm ci --ignore-scripts)
fi

export AMU="$checkout/bin/amu"
export AMU_HOME="$checkout"

if [[ ! -x "$AMU" ]]; then
  echo "amu launcher missing at $AMU" >&2
  exit 1
fi

# Reconstruct PATH without java/clojure launchers.
PATH="$("$root/scripts/path-without-jvm")"
export PATH
if command -v java >/dev/null 2>&1 || command -v clojure >/dev/null 2>&1; then
  echo "java/clojure still on PATH after filter" >&2
  exit 1
fi

kbb --backend sci --classpath bin bin/compile-amu

for artifact in server_main.wasm mcp_main.wasm server_main.kexe mcp_main.kexe; do
  path="$root/target/amu/$artifact"
  if [[ ! -s "$path" ]]; then
    echo "missing or empty artifact: $path" >&2
    exit 1
  fi
  if [[ ! -s "$path.provenance.edn" ]]; then
    echo "missing provenance: $path.provenance.edn" >&2
    exit 1
  fi
  echo "ok artifact $(wc -c < "$path") bytes $artifact"
done

if [[ ! -s "$root/target/amu/browser-host.mjs" ]]; then
  echo "browser-host.mjs was not copied next to the artifacts" >&2
  exit 1
fi

# Public compile launcher: file on disk AND :compile/emitted.
# amu {:ok true} alone is not this envelope.
measure() {
  local entry="$1"
  local out="$2"
  local json
  json="$(kbb --backend sci --classpath bin bin/kotoba compile "$entry" --target wasm --output "$out" --json)"
  echo "$json"
  echo "$json" | grep -q '"ok?":true\|"kotoba.cli/ok?":true' || {
    # nbb clj->js keywordizes :kotoba.cli/ok? to "ok?" or "kotoba.cli/ok?"
    true
  }
  if [[ ! -s "$out" ]]; then
    echo "public compile wrote no file: $out" >&2
    echo "$json" >&2
    exit 1
  fi
  if echo "$json" | grep -q 'command/planned'; then
    echo "public compile returned planned, not emit" >&2
    echo "$json" >&2
    exit 1
  fi
  if ! echo "$json" | grep -q 'compile/emitted'; then
    echo "public compile missing :compile/emitted" >&2
    echo "$json" >&2
    exit 1
  fi
  if ! echo "$json" | grep -q 'cloud-itonami-app/bin/kotoba'; then
    echo "public compile must name this app adapter, not a silent kotoba binary" >&2
    echo "$json" >&2
    exit 1
  fi
  if ! echo "$json" | grep -q 'not-production-kotoba-binary'; then
    echo "public compile must say it is not the production v0.6.29 kotoba binary" >&2
    echo "$json" >&2
    exit 1
  fi
}

measure src/cloud/itonami/app/server_main.kotoba "$root/target/amu/server_main.wasm"
measure src/cloud/itonami/app/mcp_main.kotoba "$root/target/amu/mcp_main.wasm"

CLOUD_ITONAMI_PORT="${CLOUD_ITONAMI_PORT:-17338}"
export CLOUD_ITONAMI_PORT
kbb --backend sci --classpath bin scripts/verify-no-java

echo "ci-jvm-free-emit: ok (kexe verify Linux remains HOLD; not faked)"
echo "ci-jvm-free-emit: bin/kotoba adapter :compile/emitted is not production kotoba v0.6.29"
