;; Amu selfhost native driver for the shared app install-admission core.
;; The decision records are constructed once, before the measured loop.
(ns awai.app-admission-selfhost-benchmark
  (:require [cloud.itonami.app.awai-app-admission-core :as admission])
  (:schemas {:awai-app-admission/finish-install
             [:record :awai-app-admission/finish-install
              [[:prepared :bool]
               [:install-lock-valid :bool]
               [:runtime-inputs-valid :bool]
               [:clock-valid :bool]
               [:dns-proof-valid :bool]
               [:amano-state :i64]
               [:content-complete :bool]
               [:capabilities-approved :bool]]]})
  (:export [main]))

(defn main [] :i64
  (let [valid
        (record-new [:ref :awai-app-admission/finish-install]
                    true true true true true 2 true true)
        refused
        (record-new [:ref :awai-app-admission/finish-install]
                    true true true true true 2 true false)
        precondition-ok?
        (and (= 0 (admission/finish-install-admission-code valid))
             (= 9 (admission/finish-install-admission-code refused)))
        admitted
        (loop [i 0 admitted 0 valid? true]
          (if (< i 1000000)
            (recur (+ i 1)
                   (+ admitted
                      (if (= 0 (admission/finish-install-admission-code
                                (if valid? valid refused)))
                        1 0))
                   (not valid?))
            admitted))]
    (if precondition-ok? admitted -1)))
