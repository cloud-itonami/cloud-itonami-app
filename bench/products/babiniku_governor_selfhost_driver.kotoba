;; Mixed policy workload for Babiniku's proposal governor.
(ns babiniku.governor-selfhost-benchmark
  (:require [babiniku.governor-core :as policy])
  (:export [main]))

(defn- decision [case-code]
  (cond
    (= case-code 0) (policy/review-turn-code 0 0 0 0)
    (= case-code 1) (policy/review-turn-code 1 0 0 1)
    (= case-code 2) (policy/review-turn-code 0 99 0 0)
    (= case-code 3) (policy/review-turn-code 0 0 99 0)
    (= case-code 4) (policy/review-turn-code 0 0 0 1)
    (= case-code 5) (policy/review-turn-code 0 5 4 0)
    (= case-code 6) (policy/review-turn-code 0 99 0 1)
    :else (policy/review-turn-code 0 0 99 1)))

(defn main [] :i64
  (let [cases-ok?
        (and (= 0 (policy/review-turn-code 0 0 0 0))
             (= 1 (policy/review-turn-code 1 0 0 1))
             (= 2 (policy/review-turn-code 0 99 0 0))
             (= 3 (policy/review-turn-code 0 0 99 0))
             (= 4 (policy/review-turn-code 0 0 0 1))
             (= 0 (policy/review-turn-code 0 5 4 0))
             (= 2 (policy/review-turn-code 0 99 0 1))
             (= 3 (policy/review-turn-code 0 0 99 1)))
        accepted
        (loop [i 0 count 0]
          (if (< i 1000000)
            (recur (+ i 1)
                   (+ count (if (= 0 (decision (mod i 8))) 1 0)))
            count))]
    (if (and cases-ok? (= accepted 250000)) accepted -1)))
