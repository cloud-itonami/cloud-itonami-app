# itonami agent (CLI + resident host) — container for the aiueos VM (JUN-77)
#
# Runtime is JVM-free by design (measured 2026-10-18):
#   - CLI    = cloud-itonami-cli/bin/itonami  (kbb script, classpath-free client)
#   - server = cloud-itonami-app/bin/cloud-itonami-server (kbb host + server_main.wasm guest)
#   - kbb v2 = kotoba/bin/kbb -> SCI-on-Node engine (org-babashka-nbb), no java in PATH
#
# Build context is produced by container/assemble-context.sh (app + cli + the two
# kbb engine repos at their sibling layout). The guest wasm artifact is NOT baked
# here: build it with bin/compile-amu under the compiler pin (compiler-pin.edn)
# and mount it at /data/guest/server_main.wasm, or extend this file with a
# builder stage once the amu launcher image exists. See container/README.md.

FROM docker.io/library/node:22-bookworm-slim

# openjdk JRE is NOT for the runtime (CLI/server are kbb/Node): it exists solely
# because nbb -> bb -> tools.deps dependency resolution shells out to `java`
# (measured 2026-10-18: "Couldn't find 'java'. Please set JAVA_HOME" from
# borkdude.deps). The warm-up below pre-resolves at build, so runs are offline.
RUN apt-get update && apt-get install -y --no-install-recommends bash git ca-certificates curl openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# babashka: nbb's :deps resolution shells out to `bb` (AGENTS.md warns: cold .nbb cache
# without bb = failure; measured live 2026-10-18 as ERR 127 'bb: not found').
# Arch-aware static install, pinned.
RUN BB_VER=1.12.218; ARCH=$(uname -m); case "$ARCH" in x86_64) BB_ARCH=amd64 ;; aarch64) BB_ARCH=aarch64 ;; *) BB_ARCH=$ARCH ;; esac; \
    curl -sL "https://github.com/babashka/babashka/releases/download/v${BB_VER}/babashka-${BB_VER}-linux-${BB_ARCH}-static.tar.gz" | tar -xz -C /usr/local/bin bb && bb --version

COPY context/ /opt/itonami/
# the SCI engine's npm deps (import-meta-resolve et al.) — measured 2026-10-18:
# without this, `itonami commands` dies ERR_MODULE_NOT_FOUND from nbb_api.js
RUN npm install --omit=dev --prefix /opt/itonami/kotoba-lang/org-babashka-nbb

ENV KBB_HOME=/opt/itonami/kotoba-lang/kotoba \
    CLOUD_ITONAMI_DATA_DIR=/data \
    PATH=/opt/itonami/kotoba-lang/kotoba/bin:$PATH

RUN mkdir -p /data && chmod 755 /data

# 1338 = the guest-decided listen port (bin/cloud-itonami-server)
EXPOSE 1338
VOLUME ["/data"]

# warm the .nbb deps cache at build time so the first run is not a cold resolution
RUN /opt/itonami/cloud-itonami/cloud-itonami-cli/bin/itonami commands >/dev/null 2>&1 || true

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["serve"]
