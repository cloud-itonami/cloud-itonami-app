#!/usr/bin/env kbb
(ns gen-commands
  "Write the CLI command registry from the routes `server.clj` actually serves.

  The scanning is `cloud.itonami.app.route-scan`, a portable `.cljc` this shares
  with `commands-test` — written twice, the generator and its gate would
  eventually disagree, and the disagreement would read as drift in the routes
  rather than in the two scanners.

  What is here is the part that is not portable: reading one file and writing
  another.

    kbb --backend sci --classpath src dev/gen_commands.cljk           # write the registry
    kbb --backend sci --classpath src dev/gen_commands.cljk --check   # exit 1 if it is stale
    kbb --backend sci --classpath src dev/gen_commands.cljk --print   # print, write nothing
    kbb --backend sci --classpath src dev/gen_commands.cljk --out <file>   # elsewhere

  Since 2026-09-15 the registry lives in cloud-itonami/cloud-itonami-commands
  (the contract every front end pins by sha), so the default target is that
  repository's checkout beside this one. Writing it is half the update; the
  other half is landing it there and advancing the sha in deps.edn, which
  `commands-test` will insist on. The file is refused, not created, when the
  sibling checkout is absent: a registry written into a directory nobody pins
  would look like a successful regeneration."
  (:require ["fs" :as fs]
            ["path" :as path]
            [cloud.itonami.app.route-scan :as scan]))

(def server-file "src/cloud/itonami/app/server.cljk")
(def commands-repo "../cloud-itonami-commands")

(defn- resource-file [args]
  (or (second (drop-while #(not= "--out" %) args))
      (str commands-repo "/resources/cloud-itonami-app.commands.edn")))

(defn- render [value]
  (str ";; Generated by dev/gen_commands.cljk from " server-file ".\n"
       ";; Do not edit: regenerate it, and commands-test fails when this file\n"
       ";; no longer matches the routes.\n"
       (pr-str value) "\n"))

(let [argv (vec (drop 3 (js->clj js/process.argv)))
      args (set argv)
      resource-file (resource-file argv)
      value (scan/registry (fs/readFileSync server-file "utf8") server-file)
      text (render value)
      {:keys [routes commands human-only unauthenticated]} (:counts value)]
  (when (and (not (contains? args "--print"))
             (not (fs/existsSync (path/dirname resource-file))))
    (println "REFUSED:" (path/dirname resource-file) "does not exist -- check out cloud-itonami-commands beside this repository, or pass --out <file>")
    (js/process.exit 2))
  (cond
    (contains? args "--print")
    (println text)

    (contains? args "--check")
    (let [current (try (fs/readFileSync resource-file "utf8") (catch :default _ nil))]
      (if (= current text)
        (println "commands.edn is current:" commands "commands")
        (do (println "STALE:" resource-file "does not match" server-file
                     "-- run `kbb --backend sci --classpath src dev/gen_commands.cljk`")
            (set! (.-exitCode js/process) 1))))

    :else
    (do (fs/writeFileSync resource-file text)
        (println "wrote" resource-file
                 (str "(" commands " commands from " routes " routes; "
                      human-only " human-passkey-only, "
                      unauthenticated " unauthenticated)")))))
