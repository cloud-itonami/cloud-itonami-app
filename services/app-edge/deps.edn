{:paths ["src"]
 ;; cloud-itonami-app's server surface, on Cloudflare Workers (ADR-2608081500).
 ;;
 ;; `../../src` is on the classpath for exactly one namespace today:
 ;; cloud.itonami.app.fleet-core, the .cljc half of the fleet directory. The
 ;; 109 .clj files beside it are never loaded — shadow-cljs compiles what is
 ;; required, and nothing here requires them. That is the point of the split:
 ;; the Worker and the JVM server answer a directory query with one
 ;; implementation instead of two that drift.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:cljs
  ;; tools.deps warns that a path outside the project is deprecated. Kept
  ;; deliberately: the alternative is `:local/root "../.."`, which would drag
  ;; the whole JVM application — 30 dependencies, webauthn-server-core and
  ;; jackson among them — onto a ClojureScript classpath in order to reach one
  ;; .cljc file. An external path says what is actually wanted. Revisit if
  ;; tools.deps removes it rather than deprecates it.
  {:extra-paths ["../../src"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                ;; `cloud.itonami.app.fleet-core` RUNS the shipped decision
                ;; core rather than reimplementing it, so the interpreter is a
                ;; dependency of this build and not only of the JVM one. It was
                ;; missing here from the day that delegation landed, and the
                ;; build failed closed — "The required namespace kotoba.kir is
                ;; not available" — while the JVM suite stayed green, which is
                ;; why nobody saw it. Pinned to the same sha as ../../deps.edn:
                ;; the artifact is a versioned document and the two runtimes
                ;; must read it with the same reader.
                io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.osaho"}
                ;; :local/root, not a git coordinate — jp-go-dds resolves its
                ;; own siblings the same way, and tools.deps forbids
                ;; :local/root inside a :git/sha dependency. So this build
                ;; requires the superproject west checkout, exactly as
                ;; net-kotobase/authn's deps.edn records for `authentication`.
                io.github.kotoba-lang/jp-go-digital-design-system
        {:local/root "../../../../kotoba-lang/kotoba/lib/kotoba.jpGoDigitalDesignSystem"}}}}}
