# Optional distribution profile: "gftd" or a path to another EDN profile.
CLOUD_ITONAMI_PROFILE=
CLOUD_ITONAMI_DATA_DIR=data
CLOUD_ITONAMI_WORKSPACE=
CLOUD_ITONAMI_M365_ARCHIVE=

# Provider keys are read from the process environment and are never persisted.
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
CLOUD_ITONAMI_RELAY_ACCESS_TOKEN=
ITONAMI_IDENTITY_SYNC_TOKEN=
BITCOIN_CORE_RPC_USER=
BITCOIN_CORE_RPC_PASSWORD=
# Optional dedicated bearer token for the disabled-by-default MCP HTTP profile.
CLOUD_ITONAMI_MCP_ACCESS_TOKEN=
CLOUD_ITONAMI_RECEIPT_SIGNER_TOKEN=

# Optional signed provider-policy release artifact. The signing private key is
# release-job input only and must not be placed in this file.
CLOUD_ITONAMI_POLICY_ARTIFACT_DIR=
CLOUD_ITONAMI_POLICY_TRUSTED_KEY_ID=
CLOUD_ITONAMI_POLICY_TRUSTED_PUBLIC_KEY=
