# Optional distribution profile: "gftd" or a path to another EDN profile.
CLOUD_ITONAMI_PROFILE=
# Optional override. By default the app uses the OS installation directory:
# macOS: ~/Library/Application Support/Cloud Itonami
CLOUD_ITONAMI_DATA_DIR=
# Optional one-time migration source. The source is copied and preserved.
CLOUD_ITONAMI_LEGACY_DATA_DIR=
# Base64-encoded 32-byte recovery key for non-macOS hosts. macOS uses Keychain.
CLOUD_ITONAMI_RECOVERY_KEY=
CLOUD_ITONAMI_WORKSPACE=
CLOUD_ITONAMI_M365_ARCHIVE=

# Provider keys are read from the process environment and are never persisted.
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
CLOUD_ITONAMI_RELAY_ACCESS_TOKEN=
