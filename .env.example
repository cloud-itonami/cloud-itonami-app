# Optional distribution profile: "gftd" or a path to another EDN profile.
CLOUD_ITONAMI_PROFILE=
CLOUD_ITONAMI_DATA_DIR=data
# Set to 1 only when multiple app processes share the same data directory.
CLOUD_ITONAMI_MULTI_PROCESS=
CLOUD_ITONAMI_WORKSPACE=
CLOUD_ITONAMI_M365_ARCHIVE=

# ADR-0013 encrypted repository storage. The owner is an opaque stable id;
# dataset and workspace must be different trees. Keep the token in Keychain or
# an injected process environment, never in this file.
CLOUD_ITONAMI_STORAGE_OWNER=
CLOUD_ITONAMI_WORKSPACE_ROOT=data/workspace
CLOUD_ITONAMI_DATALAD_DATASET=
CLOUD_ITONAMI_DATALAD_REMOTE=
CLOUD_ITONAMI_KOTOBASE_ENDPOINT=https://kotobase.net
CLOUD_ITONAMI_KOTOBASE_TOKEN=
# Optional recovery override. Normally Kagi selects its current repository VMK.
CLOUD_ITONAMI_KEY_EPOCH=
KAGI_HOME=
KAGI_UNLOCK_REF=

# Provider keys are read from the process environment and are never persisted.
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required when governed GitHub write-back is enabled. The receipt key attests
# local executor receipts; the webhook secret verifies source wake-up events.
CLOUD_ITONAMI_WORK_RECEIPT_KEY=
CLOUD_ITONAMI_GITHUB_WEBHOOK_SECRET=
# Live GitHub Projects adapter probe. Use only for a disposable sandbox item;
# the probe writes SANDBOX_OPTION_ID, verifies it, then restores the old Status.
CLOUD_ITONAMI_GITHUB_SANDBOX_CONFIRM=
CLOUD_ITONAMI_GITHUB_SANDBOX_PROJECT_ID=
CLOUD_ITONAMI_GITHUB_SANDBOX_ITEM_ID=
CLOUD_ITONAMI_GITHUB_SANDBOX_FIELD_ID=
CLOUD_ITONAMI_GITHUB_SANDBOX_FIELD_NAME=Status
CLOUD_ITONAMI_GITHUB_SANDBOX_OPTION_ID=
CLOUD_ITONAMI_GITHUB_SANDBOX_WRITE_CAPABILITY=github.projects/status-write
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
CLOUD_ITONAMI_RELAY_ACCESS_TOKEN=
