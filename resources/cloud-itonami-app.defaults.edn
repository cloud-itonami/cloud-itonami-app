{:brand {:name "Cloud Itonami"
         :short-name "Itonami"}
 :server {:host "127.0.0.1" :port 1338
          :public-origin "http://localhost:1338"
          :webauthn-rp-id "localhost"}
 :identity {:account-domain "cloud-itonami.app"
            :organization-domain-suffix "cloud-itonami.app"
            :organization-domain-overrides {}
            ;; Enable only when the deployment publishes a DID document for
            ;; every generated organization domain.
            :publish-did-web? false}
 :routing {:default-provider "ollama"
           :default-model "gemma4:e2b"
           :cloud-enabled? false}
 :providers
 [{:id "ollama"
   :name "Ollama"
   :kind :ollama
   :base-url "http://127.0.0.1:11434"
   :local? true
   :enabled? true}
  {:id "lm-studio"
   :name "LM Studio"
   :kind :openai-compatible
   :base-url "http://127.0.0.1:1234/v1"
   :local? true
   :enabled? false}
  {:id "codex-cli"
   :name "Codex CLI"
   :kind :cli
   :runner :codex
   :model "codex:default"
   :local? true
   :enabled? true}
  {:id "claude-cli"
   :name "Claude Code"
   :kind :cli
   :runner :claude
   :model "claude:sonnet"
   :local? true
   :enabled? true}
  {:id "claude-zai"
   :name "Claude ZAI"
   :kind :cli
   :runner :claude-zai
   :model "claude-zai:default"
   :local? true
   :enabled? true}
  {:id "openai"
   :name "OpenAI"
   :kind :openai-compatible
   :base-url "https://api.openai.com/v1"
   :api-key-env "OPENAI_API_KEY"
   :local? false
   :enabled? false}]
 :privacy {:bind-loopback-only? true
           :allow-cloud-without-review? false}
 :cloud-relay {:base-url nil
               :access-token-env "CLOUD_ITONAMI_RELAY_ACCESS_TOKEN"}
 :identity-sync {:base-url "https://hooks.itonami.cloud"
                 :access-token-env "ITONAMI_IDENTITY_SYNC_TOKEN"}
 :bitcoin
 {:explorer-base-url "https://mempool.space/api"
  ;; PSBTs exceeding either limit are rejected before Passkey approval.
  :max-fee-sats 1000000
  :max-fee-ratio 0.1
  :core-rpc
  {:url nil
   :expected-chain "main"
   :expected-genesis-hash
   "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"
   :cookie-file nil
   :require-secure-cookie? true
   :username-env "BITCOIN_CORE_RPC_USER"
   :password-env "BITCOIN_CORE_RPC_PASSWORD"
   :timeout-seconds 30
   :allow-remote? false}}
 :workspace {:m365-archive nil}
 :mail-sync {:gmail-topic nil}
 :account-services
 {:murakumo
  {:id "murakumo.cloud" :name "Murakumo Cloud"
   :base-url "https://murakumo.cloud" :plan "cloud-itonami"
   :quota-bytes 5368709120
   :quota-source :cloud-itonami-allocation}
  :kotobase
  {:id "kotobase.net" :name "Kotobase"
   :base-url "https://kotobase.net" :plan "p2p"
   :quota-bytes 104857600 :quota-pins 3
   :quota-source :service-contract}}
 :agent-control
 {:enabled? false
  :max-turns 8
  :max-tool-calls 12
  :browser {:enabled? false
            :allowed-domains ["localhost" "127.0.0.1"]
            :headed? true}
  :computer {:enabled? false}
  :cli {:enabled? false
        :workspace nil
        :access :read-only}}
 :memory {:max-session-messages 40
          :max-context-messages 20}
 ;; Background worker runs. Concurrency is deliberately small: these share the
 ;; local model with interactive chat.
 :worker {:max-concurrency 2
          :max-runs 50}

 ;; The stdio MCP server. Fleet tools need no session; funding and settlement
 ;; tools need a real one, and appear in the manifest only when this token
 ;; resolves to a live session whose user has enrolled a Passkey. Absent token =
 ;; no such tools, which is the shipped default.
 ;;
 ;; The token is an app session token. It is read from this environment variable,
 ;; or from the login Keychain (service `cloud-itonami-app.mcp`, account
 ;; `session-token`) — never stored here.
 :mcp {:session-token-env "CLOUD_ITONAMI_MCP_SESSION"}

 ;; Governed outward authorities (ADR-2607300300). Each rides the
 ;; `cloud.itonami.app.authority` spine: deterministic pre-check -> Passkey
 ;; consent -> hand-off to an actor that has its own Governor and ledger.
 ;;
 ;; ALL DISABLED BY DEFAULT, the same posture as :agent-control. These are the
 ;; only surfaces in this app that carry a proposal outward to something that
 ;; could affect a real card, a real line or a real phone call, so switching one
 ;; on is a deployment decision and not a default.
 ;;
 ;; `:endpoint` is a BASE url (e.g. "http://127.0.0.1:1339"), from which the
 ;; transport derives `/commit` and `/proposals/<reference>`. nil means there is
 ;; nowhere to hand a proposal to, so an enabled authority with no endpoint still
 ;; cannot commit.
 ;;
 ;; Only the actor's CONSENT surface belongs here. The operator surface -- where a
 ;; pending proposal is actually decided -- is a different listener on purpose, and
 ;; this app must not be given its address: holding both would mean holding both
 ;; gates. Every actor behind these is
 ;; propose-only today (see the ADR's ceiling section): a committed proposal
 ;; records a governed proposal, NOT an issued card, a downloaded profile or an
 ;; answered call. A UI that reads :committed as "done" is lying.
 :authorities
 {:esim {:enabled? false
         :endpoint nil}   ; cloud-itonami/cloud-itonami-esim
  :card {:enabled? false
         :endpoint nil    ; cloud-itonami/cloud-itonami-card-issuing
         ;; Pre-check arithmetic only. The issuer's own limits are the issuer's;
         ;; this is the app refusing to ask a human about something it can already
         ;; tell will exceed the funding account's recorded daily limit.
         :default-daily-limit nil
         ;; The cross-domain invariant (ADR-2607300300 D4): how long an eSIM
         ;; ownership transfer keeps this subject's card spend and issuance
         ;; restricted. Seven days by default -- long enough to cover the
         ;; days-scale tail of a real account takeover, short enough that a
         ;; legitimate device change does not restrict a subject indefinitely.
         ;; This is only expressible because all three authorities' proposals
         ;; share one partition; see cloud.itonami.app.authority.posture.
         :sim-swap-window-seconds 604800}
  ;; Settlement records for money the organization owes. The deterministic gate
  ;; is the funds check: a payment whose recorded balance does not cover it is
  ;; refused BEFORE a human is asked. A committed proposal is a governed
  ;; settlement RECORD -- this app holds no banking credential and moves no
  ;; money; a human makes the transfer in their bank.
  :payment {:enabled? false
            :endpoint nil  ; cloud-itonami/cloud-itonami-settlement
            ;; How old a recorded balance may be and still answer 'will this
            ;; clear?'. 24h: a company current account moves on business-day
            ;; timescales. Beyond this the pre-check refuses with
            ;; :payment/balance-unknown rather than trusting a stale figure --
            ;; an absent balance is not an unlimited one.
            :balance-max-age-seconds 86400}
  :voice {:enabled? false
          :endpoint nil   ; cloud-itonami/denwaban (R0: run-session raises at G7)
          ;; nil = no allowlist configured, so the pre-check does not apply one.
          ;; An EMPTY vector means nothing is allowed -- an absent policy is not a
          ;; permissive policy, and `[]` is how you say "no callers yet".
          :allowed-callers nil}}}
