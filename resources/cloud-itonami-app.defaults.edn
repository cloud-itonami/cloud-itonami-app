{:brand {:name "Cloud Itonami"
         :short-name "Itonami"}
 :server {:host "127.0.0.1" :port 1338
          :public-origin "http://localhost:1338"
          :webauthn-rp-id "localhost"}
 :updates {:enabled? true
           :auto-download? true
           :channel :preview
           :initial-delay-minutes 60
           :interval-hours 24
           :releases-url "https://api.github.com/repos/cloud-itonami/cloud-itonami-app/releases?per_page=20"}
 ;; `:organization-domain-overrides` was removed by ADR-0043. It named a tenant
 ;; by configuration and proved nothing; a custom or apex domain now passes a
 ;; DNS TXT proof and a self-probe. See `domain_verification`.
 :identity {:account-domain "cloud-itonami.app"
            :organization-domain-suffix "cloud-itonami.app"
            ;; Enable only when the deployment publishes a DID document for
            ;; every generated organization domain.
            :publish-did-web? false
            ;; Which method an organization ROOT is minted with once the line
            ;; above is true (ADR-0068). `:webvh` gives the tenant a
            ;; hash-chained log with pre-rotation and a 3-of-5 witness
            ;; threshold, and keeps its identity across a later proven domain
            ;; because the SCID does not move. `:web` is the previous
            ;; behaviour, for a deployment that cannot serve `did.jsonl`.
            ;;
            ;; The five witness keys are this deployment's own, so the
            ;; threshold is enforced by resolvers and is NOT independence from
            ;; this machine. Moving one role to its own HSM is a change to
            ;; `org-root-did/witness-signers` and nothing else.
            :root-did-method :webvh}
 ;; Re-measuring proven custom domains. On by default and free when there are
 ;; none: the sweep visits `:claimed`, `:live` and `:lapsed` bindings only, so a
 ;; deployment that has never proven a domain makes no outbound request.
 ;; `:interval-hours` must stay well inside `domain-verification/probe-freshness`
 ;; (7 days), or a live name's evidence goes stale between sweeps and the next
 ;; one demotes it for want of a measurement rather than for a real failure.
 :domain-binding {:recheck? true
                  :interval-hours 12
                  :initial-delay-minutes 15}
 ;; ACME (ADR-0049). No directory URL is shipped, so nothing is ordered until an
 ;; operator names one — a default would spend a real CA's rate limit on a
 ;; deployment that never asked. `cloud.itonami.app.acme/staging-directory` is
 ;; the one to point at first; its certificates are not publicly trusted, which
 ;; is exactly what you want while finding out whether the flow works.
 ;;
 ;; The listener is off because this app binds loopback and a deployment behind
 ;; a CDN or reverse proxy already terminates TLS somewhere else.
 :tls {:directory-url nil
       :contact []
       :https {:enabled? false :host "0.0.0.0" :port 8443}}
 :email-login {:enabled? false
               :delivery-endpoint nil
               :access-token-env "CLOUD_ITONAMI_EMAIL_LOGIN_TOKEN"}
 :auth {:allow-signup? false
        :sso-providers [:google :microsoft :github]
        ;; A distributed desktop app cannot keep a client secret. Google and
        ;; Microsoft installed-app registrations can therefore provide only a
        ;; public client ID and use the PKCE verifier already generated per
        ;; transaction. GitHub's web flow still requires its secret, so it is
        ;; intentionally not accepted in this map as a public client.
        :sso-clients
        #_{:google {:client-id "..." :public-client? true}
           :microsoft {:client-id "..." :public-client? true}}
        {}}
 ;; Passkey Smart Account owner operations. Endpoints are operator inputs, not
 ;; Coinbase authority: any ERC-4337 v0.6 bundler serving the allowlisted chain
 ;; may be used. Full URLs live in environment variables because provider URLs
 ;; commonly contain an API key. With them absent the receive address still
 ;; works, while owner submission fails closed as not configured.
 :wallet
 {:smart-account
  {:factory-address "0xBA5ED110eFDBa3D005bfC882d75358ACBbB85842"
   :implementation-address "0x00000110dCdEdC9581cb5eCB8467282f2926534d"
   :entry-point-address "0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789"
   :entry-point-version "0.6"
   :factory-family "coinbase-smart-wallet"
   :owner-management-abi "coinbase-smart-wallet-v1"}
  :chains
  [{:chain-id 1 :name "Ethereum"
    :rpc-url-env "CLOUD_ITONAMI_EVM_RPC_URL"
    :bundler-url-env "CLOUD_ITONAMI_ERC4337_BUNDLER_URL"
    ;; Optional ERC-4337 v0.6 sponsorship endpoint. When absent the Smart
    ;; Account pays its own gas from its deterministic address.
    :paymaster-url-env "CLOUD_ITONAMI_ERC4337_PAYMASTER_URL"}
   ;; Public-chain rehearsal before mainnet. The Coinbase Smart Wallet v1.1
   ;; factory/implementation and EntryPoint v0.6 use the same deterministic
   ;; addresses on Sepolia, but endpoints remain independently replaceable.
   {:chain-id 11155111 :name "Ethereum Sepolia" :network "testnet"
    :rpc-url-env "CLOUD_ITONAMI_EVM_SEPOLIA_RPC_URL"
    :bundler-url-env "CLOUD_ITONAMI_ERC4337_SEPOLIA_BUNDLER_URL"
    :paymaster-url-env "CLOUD_ITONAMI_ERC4337_SEPOLIA_PAYMASTER_URL"}]}
 ;; SECURITY FIRST (ADR-2608130100). `:cloud-enabled?` is the deployment-wide
 ;; egress switch: with it false, no provider that leaves this machine is
 ;; admitted no matter what it declares. It does NOT admit anything on its own —
 ;; each provider still needs its own `:reviewed?`.
 :routing {:default-provider "ollama"
           :default-model "gemma4:e2b"
           :cloud-enabled? false}
 ;; Normal Bots start with the local interaction surfaces requested. Concrete
 ;; tool admission still fails closed when agent-browser, CuaDriver or the
 ;; required macOS permissions are missing, and an explicit saved false value
 ;; remains a durable special-purpose restriction.
 :agent-control {:enabled? true
                 :browser {:enabled? true
                           :headed? true
                           :allowed-domains ["localhost" "127.0.0.1"]}
                 :computer {:enabled? true}}
 ;; `:reviewed?` is per provider and positive: somebody looked at THIS
 ;; destination and said yes. It is the whole gate for a loopback provider and
 ;; half of it for one that leaves the machine — the rest (TLS, a credential
 ;; that is actually exported) is derived from `:base-url` and the environment
 ;; rather than declared here, so a provider cannot assert its own safety.
 ;;
 ;; `:local?` is documentation now. The decision reads the host out of
 ;; `:base-url`, because a provider that called itself local while pointing
 ;; somewhere else is exactly the case the flag could not catch.
 :providers
 [{:id "xai"
   :name "Grok (xAI)"
   :kind :xai
   :base-url "https://api.x.ai/v1"
   :api-key-env "XAI_API_KEY"
   :default-model "grok-4.6"
   :reasoning-effort "medium"
   :max-output-tokens 8192
   ;; Official model metadata, checked 2026-08-22. Bot context accounting uses
   ;; the selected model's window, not a provider-wide guess.
   :context-window-tokens {"grok-4.6" 500000}
   :local? false
   ;; A distribution cannot consent to sending a tenant's Bot transcript to
   ;; xAI. Operators must enable cloud routing, export XAI_API_KEY, and mark
   ;; this exact destination reviewed before it appears in the Bot picker.
   :reviewed? false
   :enabled? false}
  {:id "murakumo"
   :name "Murakumo fleet"
   :kind :openai-compatible
   ;; `murakumo-main` is an ALIAS the fleet resolves, never a concrete model
   ;; id: models change capability quickly and a pinned id goes stale silently
   ;; (root ADR-2607173100). Switching the fleet main is one KV entry there,
   ;; and every consumer follows on its next call.
   ;; The OpenAI chat shape, not the Anthropic messages shape. Measured
   ;; 2026-08-13: both api. and infer. answer 200 to /v1/chat/completions with
   ;; a Bearer token. Shipped wrong for one commit as `:anthropic-messages`,
   ;; which the provider layer refused with `unsupported provider kind` — the
   ;; refusal is why it was found the same day.
   :base-url "https://api.murakumo.cloud/v1"
   :default-model "murakumo-main"
   ;; This is the public RunPod RTX 5090 selector advertised and live-verified
   ;; by https://murakumo.cloud/llm.txt on 2026-08-25.  A cold start took
   ;; 237.45 s there, so this selector gets a deliberately wider request bound
   ;; than local and warm models.  The requested model is checked against
   ;; the response before output is admitted; a failed bounded request is
   ;; retried explicitly as murakumo-main and remains labelled as that model.
   :models ["murakumo-main"
            "murakumo-edge"
            "qwen3.8-27b-throughput-5090"
            "qwen3.8-27b-fastmtp-aggressive"
            "z-ai/glm-5.3-flash"
            "qwen/qwen3.8-flash"]
   :model-request-timeout-seconds
   {"qwen3.8-27b-throughput-5090" 420}
   ;; Do not spend that 420-second cold-start wall when RunPod lacks verified
   ;; generation capacity. The gateway requires an idle worker plus a recent
   ;; exact-model generation; it receives no inference bearer from this probe.
   ;; A 503 becomes the explicit fallback below and the result remains labelled
   ;; as the model that actually served.
   :model-readiness
   {"qwen3.8-27b-throughput-5090"
    {:url "https://api.murakumo.cloud/ready?model=qwen3.8-27b-throughput-5090"
     :timeout-seconds 5}}
   :max-transient-retries 0
   :assert-response-model? true
   ;; 5090 cold-start 503 and FastMTP's dead Modal origin (measured
   ;; 2026-08-26: HTTP 502 body starting `modal-http`, not JSON) both
   ;; retry the alias. The result stays labelled as the model that served.
   :model-fallbacks {"qwen3.8-27b-throughput-5090" "murakumo-main"
                    "qwen3.8-27b-fastmtp-aggressive" "murakumo-main"
                    "z-ai/glm-5.3-flash" "qwen/qwen3.8-flash"
                    "qwen/qwen3.8-flash" "murakumo-main"}
   ;; The resident workforce is the murakumo-edge SLO workload. Falling it
   ;; through to murakumo-main converts one unavailable edge into two occupied
   ;; inference planes, hides which route failed, and can amplify an edge
   ;; outage into main-pool timeouts. Operator overlays may still carry an old
   ;; fallback entry; the provider honours this deny-list after overlays merge.
   :no-fallback-models #{"murakumo-edge"}
   ;; The stable alias currently reports 262,144, the Community RTX 5090 Pod
   ;; reports 65,536, and the FastMTP deployment reports 32,768. Keep this map
   ;; beside the alias: repointing `murakumo-main` must update its model metadata
   ;; in the same configuration change. Every Bot uses the window of the model
   ;; it selected; this does not change that model selection.
   ;; Measured 2026-08-27: this set was stale and every alias turn was refused
   ;; after generating fine -- 24h completion 37.3%, 25 of the last 50 runs
   ;; `model-mismatch`. The gateway answered HTTP 200 with
   ;; .model = "qwen3.8-27b-throughput-b70", while the alias entry still
   ;; reported alias-for = "qwen3.8-27b" and /infer/models listed neither.
   ;;
   ;; Enumerating names is a floor, not the fix: the next redeploy that moves
   ;; the suffix breaks it again, and pinning a literal contradicts what an
   ;; alias is. Do not delete the guard to make this go away -- what it
   ;; protects is `:context-window-tokens` below, which is the only thing
   ;; standing between a repointed alias and an over-budget request.
   ;; See 90-docs/adr/2608270100-an-alias-cannot-be-checked-against-a-pinned-name.edn
   :accepted-response-models
   {"murakumo-main" #{"murakumo-main"
                      "Qwen3.8-27B-Q4_K_M.gguf"
                      "qwen3.8-27b"
                      "qwen3.8-27b-throughput-b70"}
    "z-ai/glm-5.3-flash" #{"z-ai/glm-5.3-flash"}
    "qwen/qwen3.8-flash" #{"qwen/qwen3.8-flash"}}
   :context-window-tokens {"murakumo-main" 262144
                           ;; Live /v1/models and a real CLI Bot generation,
                           ;; measured 2026-08-29. This is the Ornith Q4 route
                           ;; resident on the 16 GB Mac mini fleet. Keep it
                           ;; literal: falling back to murakumo-main would make
                           ;; an edge stability check report the wrong machine.
                           "murakumo-edge" 65536
                           "qwen3.8-27b-throughput-5090" 65536
                           "qwen3.8-27b-fastmtp-aggressive" 32768
                           ;; OpenRouter lists 1.31M / 1M. This Worker has not
                           ;; measured those windows through api.murakumo.cloud,
                           ;; so bots budget a conservative 128k — an unmeasured
                           ;; number that looks like a measured one is the
                           ;; defect class CLAUDE.md names.
                           "z-ai/glm-5.3-flash" 128000
                           "qwen/qwen3.8-flash" 128000}
   ;; 2026-08-29 owner instruction: raise output budgets toward the model
   ;; maximum. The previous 512 (kept "concise" for capacity) truncated real
   ;; work -- measured that day: a resident decision_frame tool call cut at
   ;; its budget, filed :provider/output-budget-exhausted. 16384 matches the
   ;; gateway's raised public cap; at b70's measured 53 tok/s it is ~5
   ;; minutes of decode, inside the gateway's ten-minute ceiling, and the
   ;; observed-ceiling mechanism still clamps to whatever an endpoint
   ;; actually serves.
   :max-output-tokens 16384
   :api-key-env "MURAKUMO_API_KEY"
   :local? false
   ;; Shipped off and unreviewed. The distribution is tenant-neutral: it cannot
   ;; review a fleet on a stranger's behalf, and a default that did would be
   ;; this file asserting somebody else's decision. An operator who wants it
   ;; sets both here or in their own config, which is the act of reviewing.
   :reviewed? false
   :enabled? false}
  {:id "ollama"
   :name "Ollama"
   :kind :ollama
   :base-url "http://127.0.0.1:11434"
   :local? true
   ;; Reviewed in the shipped defaults, and this is a claim worth reading
   ;; twice: the distribution can vouch for "the machine you are already
   ;; running this on" and for nothing else. Every provider that leaves the
   ;; machine ships `:reviewed? false` and stays that way until an operator
   ;; changes it here.
   :reviewed? true
   :enabled? true}
  {:id "lm-studio"
   :name "LM Studio"
   :kind :openai-compatible
   :base-url "http://127.0.0.1:1234/v1"
   :local? true
   :reviewed? true
   :enabled? false}
  {:id "openai"
   :name "OpenAI"
   :kind :openai-compatible
   :base-url "https://api.openai.com/v1"
   :api-key-env "OPENAI_API_KEY"
   :local? false
   :reviewed? false
   :enabled? false}
  {:id "openrouter"
   :name "OpenRouter (free plan)"
   :kind :openai-compatible
   :base-url "https://openrouter.ai/api/v1"
   :api-key-env "OPENROUTER_API_KEY"
   ;; `openrouter/free` is a ROUTER over the models that are free right now,
   ;; not a model. That is the point of naming it here: the free tier is the
   ;; fastest-moving set of model ids this workspace touches -- `ox-alpha` was
   ;; the most-used model on the platform and served zero endpoints four days
   ;; later -- so a pinned free id would go stale faster than the fleet alias
   ;; ever did (root ADR-2608272100).
   :default-model "openrouter/free"
   :models ["openrouter/free"]
   ;; NO `:assert-response-model?`, and this is the deliberate part.
   ;;
   ;; The router answers with the model that actually served: measured
   ;; 2026-08-27, a request for `openrouter/free` returned HTTP 200 with
   ;; .model = "nvidia/nemotron-3.5-lightning:free" and a well-formed tool
   ;; call. A hand-maintained accepted-set would refuse that, and refuse a
   ;; different name tomorrow. ADR-2608270100 is what that costs: the same
   ;; check against `murakumo-main` refused 25 of 50 runs while the model was
   ;; generating fine, and the 24h completion rate read 37.3%.
   ;;
   ;; What the assertion protects elsewhere is `:context-window-tokens`. Here
   ;; that is bounded from the other side: the router advertises 200,000 and
   ;; only routes to models that can take the request, and the budget below is
   ;; set well under it rather than at any single model's window.
   :context-window-tokens {"openrouter/free" 128000}
   ;; Unattended Bot turns are a role/tool decision, not prose. Same bound the
   ;; fleet entry carries, for the same reason.
   :max-output-tokens 512
   :local? false
   ;; Shipped off and unreviewed, like every destination that leaves the
   ;; machine. Two things an operator is consenting to here, and the second is
   ;; not obvious: the transcript goes to OpenRouter, AND onward to whichever
   ;; third party is serving the free endpoint that minute -- which is a
   ;; different company on different turns. A free tier is priced that way for
   ;; reasons, and the account's own data policy at
   ;; openrouter.ai/settings/privacy decides which of those endpoints are even
   ;; offered. A distribution cannot review that on a tenant's behalf.
   :reviewed? false
   :enabled? false}]
 ;; `:allow-cloud-without-review?` was retired here (ADR-2608130100). It was
 ;; the only way to admit a cloud provider, and it said the opposite of what an
 ;; operator who had reviewed one wanted to say. Review is `:reviewed?` above,
 ;; per provider.
 :privacy {:bind-loopback-only? true}
 :cloud-relay {:base-url nil
               :access-token-env "CLOUD_ITONAMI_RELAY_ACCESS_TOKEN"}
 ;; Live mailbox synchronization. Off in the tenant-neutral distribution: an
 ;; installed workspace that starts reading somebody's mail has answered a
 ;; question nobody asked it.
 ;;
 ;; A provider syncs when this app holds its own OAuth connection (Settings →
 ;; Connect), or when `:delegated-credential` names one another tool on this
 ;; machine already holds. The delegated form exists so a person who has
 ;; already consented once — to `kotoba-lang/mail-archive`, say — is not
 ;; marched through a second consent screen for the same read-only scope.
 ;;
 ;; Both keychain items are named in full, service *and* account. Nothing here
 ;; searches the keychain or infers an account: an application that reached for
 ;; whichever Google token happened to be present would be reading a mailbox it
 ;; was never pointed at.
 ;;
 ;;   :providers {:google {:delegated-credential
 ;;                        {:client-service  "google-oauth-client"
 ;;                         :client-account  "mail-archive"
 ;;                         :refresh-service "google-oauth:<slug>"
 ;;                         :refresh-account "<address>@gmail.com"}}}
 ;; Mail sync walks *accounts*, not providers: however many mailboxes have
 ;; been connected, of whatever kind (Gmail and Microsoft 365 over OAuth, any
 ;; other host over IMAP). Nothing about which mailboxes exist is configured
 ;; here — an OAuth mailbox exists because somebody granted consent, and an
 ;; IMAP or POP3 one because somebody registered it at POST /api/mail/accounts.
 ;;
 ;; `:providers` names *delegated* credentials only: OAuth grants some other
 ;; tool on this machine already holds, named item by item so that nothing
 ;; here ever searches the keychain for a token it was not pointed at.
 :mail-sync {:enabled? false
             :interval-seconds 60
             ;; The hosted webhook relay is a further opt-in; a loopback-only
             ;; deployment should not be calling out to it by default.
             :relay-enabled? false
             :gmail-topic nil
             :providers {}}
 ;; Ordinary local directory <-> Cloud Itonami Drive synchronization.
 ;; Off unless the operator explicitly binds a directory to one local user.
 ;; A root is {:id "documents" :path "/absolute/local/path"
 ;;            :actor "person-..." :drive-path ["Synced" "Documents"]}.
 ;; Conflict and deletion recovery trees are written inside the local root as
 ;; `.itonami-conflicts` and `.itonami-trash`; they are never synchronized.
 :folder-sync {:enabled? false
               :interval-seconds 30
               :maximum-file-bytes 104857600
               :roots []}
 :memory {:max-session-messages 40
          :max-context-messages 20}
 ;; The unattended routine tick. `:interval-seconds` is how often to LOOK, not
 ;; how often anything runs — a routine's own schedule has a five-minute floor
 ;; and `may-fire?` refuses to overlap or to stack behind an approval.
 ;;
 ;; On by default, and that is not the same as scheduling anything: the tick
 ;; acts only for a person whose session is live, and only on routines they
 ;; explicitly gave a schedule. With no scheduled routine it is a store read
 ;; that finds nothing. Set `:enabled? false` to stop it looking at all.
 :bots {:mail-domain "mail.itonami.cloud"
        ;; New Bots receive an isolated local Git root automatically. It is
        ;; continuously reconciled with Drive/Bots/<bot-id>/Workspace. A
        ;; hosted network target may be supplied under :workspace-sync :remote
        ;; with the same shape as a folder-sync HTTP remote.
        :workspace {:enabled? true}
        :workspace-sync {}
        :tick {:enabled? true :interval-seconds 60}
        ;; Resident startup jobs share the inference plane with interactive
        ;; conversations. One start per tick controls bursts; max-active also
        ;; prevents a slow run from overlapping the next tick.
        :workforce {:max-starts-per-tick 1
                    :max-active 1
                    ;; Restart recovery is deliberately narrower than the
                    ;; steady-state workforce budget. A deployment may raise
                    ;; :max-active for scheduled work without submitting its
                    ;; whole durable backlog to a single inference provider.
                    :recovery-max-active 1
                    ;; This is a scheduling slice, not a terminal execution
                    ;; limit. A durable Goal checkpoints here and resumes in a
                    ;; fresh slice, so a useful autonomous run no longer turns
                    ;; into a red "tool budget" failure after four reads.
                    :max-tool-calls 8
                    :max-tool-output-chars 1600
                    ;; The resident workforce is the edge workload: use the
                    ;; explicit Ornith route so its SLO measures the 16 GB Mac
                    ;; fleet, not whatever murakumo-main aliases to later.
                    :model "murakumo-edge"
                    ;; Standing delegation, deliberately ABSENT here: `:all`
                    ;; or a set of workforce keys ("business/kind") an
                    ;; operator writes into their own config.edn. A
                    ;; distribution cannot delegate on a stranger's behalf.
                    ;; Provisioning never lowers a delegation a person set in
                    ;; Settings either. ADR-0070.
                    ;;
                    ;; Organization aliases, also ABSENT here: a map of
                    ;; {tenant-slug registry-organization} an operator writes
                    ;; into their own config.edn when a tenant was registered
                    ;; under a spelling the registry does not use (a slug is
                    ;; immutable once claimed). A business that names an
                    ;; organization provisions only into the tenant whose slug
                    ;; -- or alias -- matches; the status reports the alias
                    ;; it matched through. ADR-0071.
                    }}
 :chronicle {:interval-seconds 60
             ;; Capture starts on for a new local profile. Settings remains the
             ;; authority for all three switches; this is only the cadence used
             ;; while screen context is enabled.
             :frame-retention-hours 6}
 ;; Background worker runs. Concurrency is deliberately small: these share the
 ;; local model with interactive chat.
 :worker {:max-concurrency 2
          :max-runs 50}

 ;; The stdio MCP server. Fleet tools need no session; funding and settlement
 ;; tools need a real one, and appear in the manifest only when this token
 ;; resolves to a live session whose user has enrolled a Passkey. Absent token =
 ;; no such tools, which is the shipped default.
 ;;
 ;; The token is an app session token. It is read from this environment variable,
 ;; or from the login Keychain (service `cloud-itonami-app.mcp`, account
 ;; `session-token`) — never stored here.
 ;; Two slots, because the two surfaces need sessions that are required to
 ;; differ: the agent one is minted by `auth login`, the human one has to belong
 ;; to a Passkey-enrolled user (ADR-0009). Sharing one meant enrolling the CLI
 ;; silently disabled funding and settlement.
 :mcp {:session-token-env "CLOUD_ITONAMI_MCP_SESSION"
       :human-session-token-env "CLOUD_ITONAMI_MCP_HUMAN_SESSION"
       ;; Hosted resource servers can have a different origin from the local
       ;; Passkey UI. nil preserves the server origin for a single-origin app.
       :resource-origin nil
       ;; Streamable HTTP is served at /mcp. Origin is validated whenever a
       ;; browser supplies it; add trusted hosted control-plane origins here.
       :allowed-origins []
       :oauth
       {:authorization-servers ["https://auth.itonami.cloud"]
        ;; Hosted deployments set these three values. Local opaque agent
        ;; sessions continue to work without an introspection endpoint.
        :introspection-endpoint nil
        :public-introspection? false
        :client-id-env "CLOUD_ITONAMI_OAUTH_RESOURCE_CLIENT_ID"
        :client-secret-env "CLOUD_ITONAMI_OAUTH_RESOURCE_CLIENT_SECRET"}}

 ;; A2A v1.0 is a separate, text-only Bot boundary. It is off until an owner
 ;; selects one Bot explicitly; the public Agent Card never enumerates the
 ;; private Bot or tool catalog. Remote calls require a bearer token carrying
 ;; `a2a:tasks`, and every request is run with isolated conversation context.
 :a2a {:enabled? false
       :bot-id nil
       :name "Cloud Itonami"
       :description "A bounded Cloud Itonami Bot"
       :version "1.0.0"
       :resource-origin nil
       :max-tasks 1000
       :skills []}

 ;; AGNTCY SLIM is adopted as an optional carrier for the same A2A payload.
 ;; The portable envelope is implemented in kotoba-protocol. A deployment must
 ;; still supply a concrete SLIM publisher and names before this becomes ready.
 :agent-messaging
 {:transport :direct
  :slim {:enabled? false
         :from nil
         :to nil}}

 ;; Which registered device this install IS (ADR-0062). nil means this install
 ;; was never enrolled as a device, and every `bot:<id>@<device>` handle is
 ;; therefore not-local — which is the fail-closed direction. It is deliberately
 ;; not derived from a hostname or a seed: a machine that names itself is the
 ;; discovery step ADR-0062 refuses. Set it to the id this install was
 ;; registered under with `messenger/register-device!`.
 :devices
 {:local nil}

 ;; 事業 (ADR-2607309600). A Business holds one key from each analysis plane —
 ;; BMC canvas, XMILE model, adopted blueprints, repo paths, LEI — so that the
 ;; three planes that cannot currently join to each other meet on one entity.
 ;;
 ;; :workspace-root is a checkout of the com-junkawasaki/root superproject, which
 ;; is where those planes actually live (90-docs/, manifest/). nil is the shipped
 ;; default because this app is released on its own and cannot assume a west
 ;; checkout beside it — the same reason `fleet` ships its catalog as a resource.
 ;; Unset does NOT mean 'nothing found': every plane-backed face reports
 ;; :unresolvable and names this setting, because a face that read 'missing' when
 ;; nobody said where to look would be a measurement of nothing.
 :business {:workspace-root nil
            ;; How old a metrics/<product>.edn may be and still read as current.
            ;; 3 days: the emitter runs daily, so one missed run is not staleness
            ;; and three are. Measured 2026-07-30: eleven of twelve metrics files
            ;; were same-day, and ai-gftd-yukkuri was 28 days old — which is the
            ;; case this exists to mark rather than print as a current figure.
            :metrics-max-age-days 3}

 ;; Verifiable Credentials issued by OTHER organizations
 ;; (cloud.itonami.app.credential-trust). Credentials this app issued itself need
 ;; nothing here — they are checked against its own key.
 ;;
 ;; :trusted-issuers is DENY-BY-DEFAULT and there is no way to switch it off,
 ;; because for did:web the trust list is not hardening, it is the trust model.
 ;; Anyone can publish a DID document at a domain they control and sign a
 ;; credential with the matching key; verifying that proves only "whoever
 ;; controls that domain said this". A verifier that fetches the key the
 ;; credential names is checking the forger's arithmetic against the forger's own
 ;; key. So the operator decides which domains to believe, in advance, here.
 ;;
 ;; nil accepts nothing. [] accepts nothing and says so deliberately -- an absent
 ;; policy is not a permissive policy, the same reading :authorities :voice
 ;; :allowed-callers already documents.
 :credentials {:trusted-issuers nil
               :fetch-timeout-seconds 5
               ;; A DID document is a handful of keys; the cap is what stops a
               ;; trusted-but-compromised domain streaming until this process
               ;; runs out of heap.
               :max-document-bytes 65536
               ;; Cached per verificationMethod rather than per domain, so a key
               ;; rotation is not answered from a stale entry for a sibling key.
               :cache-seconds 3600
               ;; Status lists cache for far less time than keys: a key rotates
               ;; rarely, a revocation is the thing being asked about. The list's
               ;; own `ttl` wins when it is shorter, because the issuer knows how
               ;; often it republishes.
               ;;
               ;; Revocation is checked, and FAILS CLOSED: a list that cannot be
               ;; fetched, does not verify, or is signed by someone other than the
               ;; credential's own issuer comes back :unchecked and the credential
               ;; is not treated as valid. "Could not ask" is not "not revoked".
               :status-cache-seconds 300}

 ;; Governed outward authorities (ADR-2607300300). Each rides the
 ;; `cloud.itonami.app.authority` spine: deterministic pre-check -> Passkey
 ;; consent -> hand-off to an actor that has its own Governor and ledger.
 ;;
 ;; ALL DISABLED BY DEFAULT. Unlike the local, bounded :agent-control surfaces,
 ;; these authorities can commit an effect outside this Mac. They are the
 ;; only surfaces in this app that carry a proposal outward to something that
 ;; could affect a real card, a real line or a real phone call, so switching one
 ;; on is a deployment decision and not a default.
 ;;
 ;; `:endpoint` is a BASE url (e.g. "http://127.0.0.1:1339"), from which the
 ;; transport derives `/commit` and `/proposals/<reference>`. nil means there is
 ;; nowhere to hand a proposal to, so an enabled authority with no endpoint still
 ;; cannot commit.
 ;;
 ;; Only the actor's CONSENT surface belongs here. The operator surface -- where a
 ;; pending proposal is actually decided -- is a different listener on purpose, and
 ;; this app must not be given its address: holding both would mean holding both
 ;; gates.
 ;;
 ;; The consent surfaces, as the actors ship them (all loopback, `clojure -M:serve`):
 ;;
 ;;   esim   http://127.0.0.1:1339   cloud-itonami-esim          (operator :1340)
 ;;   card   http://127.0.0.1:1341   cloud-itonami-card-issuing  (operator :1342)
 ;;   voice  http://127.0.0.1:1343   denwaban                    (no operator port)
 ;;
 ;; denwaban has no operator port on purpose: its outward gate G7 is shut, so an
 ;; approval there could not answer a call, and every op comes back `held`.
 ;;
 ;; CARD IS NOW THE EXCEPTION to "propose-only". The other two actors cannot perform
 ;; an outward act at all, so a :committed proposal there records a governed proposal
 ;; and NOT a downloaded profile or an answered call -- a UI that reads it as "done"
 ;; is lying. cloud-itonami-card-issuing CAN issue a real card, through Stripe
 ;; Issuing, when its operator approves AND its deployment injects the provider
 ;; (CARD_ACTUATOR=1; CARD_ACTUATOR_MODE=live for real money, test mode otherwise).
 ;; That is why the transport now understands a fourth answer,
 ;; "approved-not-actuated": the operator's approval and the provider's call are
 ;; separate events that fail separately, and collapsing them would either lose an
 ;; approval that happened or claim a card exists when Stripe declined.
 ;;
 ;; Nothing in THIS app holds a Stripe key. The provider reads it from an
 ;; environment variable named by its own caller, at call time, inside the actor's
 ;; process.
 ;; :consent-token-env names the ENVIRONMENT VARIABLE holding the shared secret this
 ;; app presents to an actor's consent surface -- never the value. A token written here
 ;; would be a secret in git, and this particular one is what lets a caller claim a
 ;; subject consented. The actor refuses (503) when its own side is unconfigured, which
 ;; is the honest failure; this app does not pre-emptively refuse on the actor's behalf.
 ;; Dropbox Fax as the practice's outbound fax transport
 ;; (`cloud.itonami.app.fax`). OFF by default: enabling it means this machine
 ;; can put a client's document on a phone line.
 ;;
 ;; The API takes Basic auth with the ACCOUNT'S OWN PASSWORD, so the password
 ;; is not here and must never be. Only the coordinates that locate it are:
 ;; the credential lives in the OS keychain under `:keychain-service` with
 ;; `:username` as the account.
 ;;
 ;;   security add-generic-password -s dropbox-fax -a you@example.jp -w
 ;;
 ;; `:account-guid` comes from app.hellofax.com/account/apiInfo. API access is
 ;; paid-plan only and must be switched on by Dropbox support first.
 ;; `:callback-token` is a shared secret in the callback URL — weak, and what
 ;; the provider's callback mechanism affords. What bounds it is reach: a
 ;; callback can record a status against a 送達 this practice already sent
 ;; and nothing else.
 :fax {:enabled? false
       :username nil
       :account-guid nil
       :keychain-service "dropbox-fax"
       :callback-token nil
       :cover-from nil
       :cover-message nil}

 ;; The legal-practice record surface (`cloud.itonami.app.lawfirm`).
 ;;
 ;; OFF by default. Enabling it means this installation holds a law practice's
 ;; 一件記録 — client identities, 利益相反 clearances, 預り金 balances, 送達先
 ;; — in `state.edn` beside everything else in the data directory. That is a
 ;; deployment decision about what this machine is, not a feature toggle.
 ;;
 ;; The practice's own gate (`lawfirm.governor`) is unaffected by this flag:
 ;; it refuses the same operations whether the surface is on or off. This
 ;; flag decides only whether this app hosts a record at all.
 :lawfirm {:enabled? false}

 ;; Agent-first domain lifecycle. Credentials are named, never stored here.
 ;; The MCP tools are absent unless both variables and a supported agent
 ;; session resolve. Mutations additionally pass through the proposal -> human
 ;; Passkey -> commit spine below; the agent session cannot approve them.
 :domain-service {:account-id-env "CLOUDFLARE_ACCOUNT_ID"
                  :api-token-env "CLOUDFLARE_API_TOKEN"
                  :api-base "https://api.cloudflare.com/client/v4"}

 :authorities
 {:domain {:enabled? false}
  :esim {:enabled? false
         :endpoint nil    ; cloud-itonami/cloud-itonami-esim
         :consent-token-env "ESIM_CONSENT_TOKEN"}
  ;; Numbering: allocation (払い出し), assignment, lifecycle and portability
  ;; (ADR-2608034000 + ADR-2608301200). The actor now exists at the loopback
  ;; consent surface below. It still ships OFF: enabling it can lead, after a
  ;; separate named-operator decision, to a recurring-cost Telnyx number order.
  :number {:enabled? false
           :endpoint "http://127.0.0.1:1345" ; cloud-itonami/cloud-itonami-numbering
           :consent-token-env "NUMBER_CONSENT_TOKEN"
           ;; The ranges this operator was assigned. Configuration, not store: a
           ;; block that could arrive in a request would let a caller allocate
           ;; themselves a number out of a range nobody gave this operator.
           ;; Each entry: {:id "…" :first "+81…" :last "+81…" :kind :mobile}
           :blocks []
           ;; How long a released number ages before anybody else may have it.
           ;; nil = kotoba.phone.numbering/default-quarantine-days (90). The
           ;; thing being waited out is the previous holder's account-recovery
           ;; traffic -- password resets and one-time codes -- so short is the
           ;; dangerous direction.
           :quarantine-days nil
           ;; How long after a line changes hands it may not change hands again.
           ;; nil = kotoba.phone.porting/default-change-freeze-days (60).
           :freeze-days nil}
  :card {:enabled? false
         :endpoint nil    ; cloud-itonami/cloud-itonami-card-issuing
         :consent-token-env "CARD_CONSENT_TOKEN"   ; actor: X-CARD-CONSENT-TOKEN
         ;; Pre-check arithmetic only. The issuer's own limits are the issuer's;
         ;; this is the app refusing to ask a human about something it can already
         ;; tell will exceed the funding account's recorded daily limit.
         :default-daily-limit nil
         ;; The cross-domain invariant (ADR-2607300300 D4): how long an eSIM
         ;; ownership transfer keeps this subject's card spend and issuance
         ;; restricted. Seven days by default -- long enough to cover the
         ;; days-scale tail of a real account takeover, short enough that a
         ;; legitimate device change does not restrict a subject indefinitely.
         ;; This is only expressible because all three authorities' proposals
         ;; share one partition; see cloud.itonami.app.authority.posture.
         :sim-swap-window-seconds 604800}
  ;; Settlement records for money the organization owes. The deterministic gate
  ;; is the funds check: a payment whose recorded balance does not cover it is
  ;; refused BEFORE a human is asked. A committed proposal is a governed
  ;; settlement RECORD -- this app holds no banking credential and moves no
  ;; money; a human makes the transfer in their bank.
  :payment {:enabled? false
            :endpoint nil  ; cloud-itonami/cloud-itonami-settlement
            ;; What kind of authenticator may approve a settlement.
            ;;
            ;; The decision (2026-07-30) was a Secure Enclave key requiring
            ;; Touch ID, so that an agent cannot approve on the owner's behalf.
            ;; A Passkey assertion alone does not establish that: a browser's
            ;; virtual authenticator verifies identically and signs with no
            ;; human present. cloud.itonami.app.credential-assurance grades the
            ;; difference from evidence captured at enrolment.
            ;;
            ;; :platform-claimed is the shipped floor because it is the
            ;; strongest one KNOWN to be reachable. :platform-attested needs the
            ;; browser to disclose a real AAGUID under direct attestation, and
            ;; whether it does is measurable on the machine rather than
            ;; guessable here. Register once, read
            ;; GET /api/passkeys/assurance, then raise this with evidence --
            ;; a floor the hardware cannot clear would enrol fine and then
            ;; refuse every payment, which reads as a bug.
            :credential-policy {:min-assurance :platform-claimed
                                :require-user-verification? true}
            ;; How old a recorded balance may be and still answer 'will this
            ;; clear?'. 24h: a company current account moves on business-day
            ;; timescales. Beyond this the pre-check refuses with
            ;; :payment/balance-unknown rather than trusting a stale figure --
            ;; an absent balance is not an unlimited one.
            :balance-max-age-seconds 86400}
  :voice {:enabled? false
          :endpoint nil   ; cloud-itonami/denwaban (R0: run-session raises at G7)
          :consent-token-env "VOICE_CONSENT_TOKEN"
          ;; nil = no allowlist configured, so the pre-check does not apply one.
          ;; An EMPTY vector means nothing is allowed -- an absent policy is not a
          ;; permissive policy, and `[]` is how you say "no callers yet".
          :allowed-callers nil

          ;; ---- outbound (:call/originate, ADR-2608034000) ----
          ;; The caller's country, used to classify a destination as domestic,
          ;; international, premium-rate, toll-free or emergency.
          :home-country-code "81"
          ;; Short codes (2-4 digits) this deployment may dial. nil and [] both
          ;; mean NONE -- short numbers sit next to the emergency and service
          ;; ranges, so "anything three digits" is not a default anybody should
          ;; get by leaving a key out. An emergency number is refused even when
          ;; it appears here; see kotoba.phone.origination/emergency-issue.
          :allowed-short-codes nil
          ;; Premium-rate destinations bill the caller and pay the called party,
          ;; which is the shape of toll fraud. Explicit opt-in only.
          :allow-premium-rate? false
          ;; What a minute costs, in integer MINOR units, by destination class.
          ;; A class with no entry cannot be priced, and an unpriced call is
          ;; REFUSED rather than assumed free (:origination/cost-unknown).
          :rate-card {:domestic nil :international nil :toll-free nil
                      :short-code nil :premium-rate nil}
          ;; The daily ceiling on outbound spend, in minor units. nil refuses
          ;; every call: an absent limit is not an unlimited one, the same rule
          ;; the card adapter's daily-limit gate follows.
          :daily-limit-minor nil}}}
