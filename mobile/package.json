{
  "name": "cloud-itonami-app-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "cloud-itonami-app's mobile web bundle, carried by a kotoba-shell iOS/Android app. ADR-2608311000.",
  "type": "module",
  "scripts": {
    "index": "kbb --backend sci --classpath \"$(kbb -A:cljs -Spath)\" scripts/gen_index.cljs",
    "index:check": "kbb --backend sci --classpath \"$(kbb -A:cljs -Spath)\" scripts/gen_index.cljs --check",
    "assets": "mkdir -p dist && cp \"${JP_GO_DDS:-../../../kotoba-lang/jp-go-digital-design-system}/resources/jp_go_dds/dds.css\" dist/",
    "build": "npm run assets && node scripts/build-bundle.mjs && node scripts/audit-viewport.mjs",
    "watch": "npm run assets && node scripts/build-bundle.mjs watch app",
    "serve": "npx http-server dist -p 8099 -c-1",
    "bundle": "node scripts/build-bundle.mjs",
    "audit": "node scripts/audit-viewport.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "shadow-cljs": "3.4.11"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
