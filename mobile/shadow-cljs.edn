;; cloud-itonami-app's mobile surface — the web bundle inside the iOS/Android app.
;;
;; :target :browser, one module, one document (ADR-2608080100). The document is
;; mobile/dist/index.html, generated from jp-go-dds.page so that the head — the
;; viewport, color-scheme and theme-color metas, and the ext-css — comes from the
;; design system rather than from a hand-written copy of it.
;;
;; The API base is a closure-define, not a literal in the source: the same bundle
;; is built against the deployed edge Worker and against `wrangler dev`, and a
;; base URL compiled into a function would make those two different bundles.
{:deps   {:aliases [:cljs]}
 :builds {:app
          {:target     :browser
           :output-dir "dist/js"
           :asset-path "js"
           :modules    {:main {:init-fn cloud.itonami.mobile.app/init}}
           :closure-defines
           {cloud.itonami.mobile.app/api-base
            "https://cloud-itonami-app-edge.04-feasts-minded.workers.dev"}
           :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}}}
