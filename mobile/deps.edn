{:paths ["src"]
 ;; The mobile surface: the web bundle a kotoba-shell iOS/Android app carries.
 ;;
 ;; Its own project, not an alias of ../deps.edn, for the reason services/app-edge
 ;; is its own project: the 100+ .clj files of the JVM application are never
 ;; loaded here, and putting this build on that classpath would drag
 ;; webauthn-server-core and jackson onto a ClojureScript compile in order to
 ;; reach nothing.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:cljs
  {;; `cloud.itonami.app.commands` and the two EDN tables it reads used to be
   ;; reached through `:extra-paths ["../src" "../resources"]` -- a path
   ;; outside the project that tools.deps deprecates, kept so the 100+
   ;; application namespaces beside them never landed on a ClojureScript
   ;; classpath. Since 2026-09-15 they are cloud-itonami-commands, a
   ;; dependency with nothing else in it, pinned at the same sha as
   ;; ../deps.edn.
   :extra-deps
   {io.github.cloud-itonami/cloud-itonami-commands {:git/sha "9bd4ec8d8c5bf75e6404e890aaf9e5a907c1df43"}
    thheller/shadow-cljs {:mvn/version "2.28.20"}
    ;; reagent 1.2.0, the version kami-genko already builds against. The views
    ;; are plain hiccup data in .cljc, so reagent is the mount point and not a
    ;; second view language.
    reagent/reagent {:mvn/version "1.2.0"}
    ;; :local/root, exactly as services/app-edge records it: jp-go-dds resolves
    ;; its own siblings that way, and tools.deps forbids :local/root inside a
    ;; :git/sha dependency. This build therefore requires the superproject west
    ;; checkout.
    io.github.kotoba-lang/jp-go-digital-design-system
    {:local/root "../../../kotoba-lang/jp-go-digital-design-system"}}}
  :test
  ;; The command tables for the same reason the :cljs alias needs them: the
  ;; JVM suite asserts what `terminal/plan` returns, and a plan that cannot
  ;; read the command tables would assert nothing.
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cloud-itonami/cloud-itonami-commands {:git/sha "9bd4ec8d8c5bf75e6404e890aaf9e5a907c1df43"}
    ;; `cloud.itonami.app.commands` requires `kotoba.lang.text`, so the suite
    ;; cannot load the command tables without it. Pinned to the same sha the
    ;; application's own deps.edn names as its explicit floor -- two different
    ;; shas here would let this suite assert against a different resolver than
    ;; the one that ships.
    io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
    io.github.kotoba-lang/jp-go-digital-design-system
    {:local/root "../../../kotoba-lang/jp-go-digital-design-system"}}
   :main-opts ["-m" "cloud.itonami.mobile.test-main"]}}}
