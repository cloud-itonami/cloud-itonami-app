{:paths ["src"]
 ;; The mobile surface: the web bundle a kotoba-shell iOS/Android app carries.
 ;;
 ;; Its own project, not an alias of ../deps.edn, for the reason services/app-edge
 ;; is its own project: the 100+ .clj files of the JVM application are never
 ;; loaded here, and putting this build on that classpath would drag
 ;; webauthn-server-core and jackson onto a ClojureScript compile in order to
 ;; reach nothing.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:cljs
  {;; `../src` and `../resources` are on the classpath for exactly two things:
   ;; `cloud.itonami.app.commands` (the .cljc that owns every command this app
   ;; serves) and the two EDN tables it reads. The 100+ .clj files beside them
   ;; are never loaded -- shadow-cljs compiles what is required, and nothing
   ;; here requires them. `services/app-edge/deps.edn` records the identical
   ;; decision for `fleet-core`, with the identical reason: the alternative is
   ;; `:local/root "../"`, which would drag webauthn-server-core and jackson
   ;; onto a ClojureScript classpath in order to reach one .cljc file.
   ;;
   ;; tools.deps deprecates paths outside the project. Kept deliberately, as
   ;; app-edge keeps it. Revisit if it is removed rather than deprecated.
   :extra-paths ["../src" "../resources"]
   :extra-deps
   {thheller/shadow-cljs {:mvn/version "2.28.20"}
    ;; reagent 1.2.0, the version kami-genko already builds against. The views
    ;; are plain hiccup data in .cljc, so reagent is the mount point and not a
    ;; second view language.
    reagent/reagent {:mvn/version "1.2.0"}
    ;; :local/root, exactly as services/app-edge records it: jp-go-dds resolves
    ;; its own siblings that way, and tools.deps forbids :local/root inside a
    ;; :git/sha dependency. This build therefore requires the superproject west
    ;; checkout.
    io.github.kotoba-lang/jp-go-digital-design-system
    {:local/root "../../../kotoba-lang/jp-go-digital-design-system"}}}
  :test
  ;; `../src` and `../resources` for the same two things the :cljs alias needs
  ;; them for. The JVM suite asserts what `terminal/plan` returns, and a plan
  ;; that cannot read the command tables would assert nothing.
  {:extra-paths ["test" "../src" "../resources"]
   :extra-deps
   {io.github.kotoba-lang/jp-go-digital-design-system
    {:local/root "../../../kotoba-lang/jp-go-digital-design-system"}}
   :main-opts ["-m" "cloud.itonami.mobile.test-main"]}}}
