 ;; ── privacy, from actual behaviour ──────────────────────────────────────
 ;;
 ;; What leaves the device:
 ;;  1. GET https://cloud-itonami-app-edge.04-feasts-minded.workers.dev
 ;;     /api/fleet/search?limit=50[&text=…][&role=…] and /api/fleet/facets?field=role.
 ;;     No cookie, no auth header, no device id. The query text is in the URL.
 ;;     The Worker has `observability: {enabled: true}` (services/app-edge/
 ;;     wrangler.jsonc), so Cloudflare Workers Logs keep request URLs, and
 ;;     Cloudflare edge logs keep the IP, for a limited time.
 ;;  2. Only if the user pairs the device on the コマンド pane: requests to the
 ;;     ingress they entered (default https://agent.itonami.cloud) with
 ;;     `Authorization: Bearer <token>`. Passkey-gated writes are refused on the
 ;;     client and never sent.
 ;; What stays on the device:
 ;;  - the pairing {:base :token} as JSON in WebView localStorage under
 ;;    "cloud.itonami.mobile.pairing.v1". NOT the Keychain/Keystore: the bridge
 ;;    policy is deny-all (mobile/shell-policy.edn). Removed with the app.
 ;; No SDKs, no analytics, no ads, no advertising id, no location, no contacts,
 ;; no camera/mic, no tracking (ATT not needed).
 :apple-app-privacy
 {:tracking false
  ;; Conservative answer while Workers observability is on. If it is turned
  ;; off for this Worker (or search params are excluded from logs), the honest
  ;; answer becomes :data-not-collected. UNCERTAIN: owner decision.
  :data-collected
  [{:type "Search History"
    :linked-to-user false
    :used-for-tracking false
    :purposes ["App Functionality"]
    :note "search text and chosen role, in the edge request URL, retained only in Cloudflare request logs"}]
  :alternative-if-logs-disabled :data-not-collected
  ;; The pairing token is an access credential the user types in; it is sent
  ;; only to the ingress the user chose, i.e. to the owner's own service.
  ;; UNCERTAIN: Apple has no "credential" data type; "Other Data, App
  ;; Functionality, linked" is the cautious disclosure if paired use is
  ;; considered part of the shipped app.
  :paired-use {:type "Other Data" :linked-to-user true :used-for-tracking false
               :purposes ["App Functionality"] :uncertain true}}

 :google-data-safety
 {:collects-or-shares-data true      ; false if Workers logs are disabled (see above)
  :data-types
  [{:category "App activity" :type "In-app search history"
    :collected true :shared false :ephemeral false :required false
    :purposes ["App functionality"]}]
  :encrypted-in-transit true         ; every endpoint is HTTPS
  ;; android:usesCleartextTraffic="false" (:android/cleartext-traffic? false,
  ;; kotoba-lang/shell PR #36).
  :deletion-request-mechanism :not-applicable   ; no account, nothing tied to a user
  :account-creation false
  :independent-security-review false
  :families-policy false}

 ;; ── export compliance ───────────────────────────────────────────────────
 ;; The app uses only the OS's HTTPS (URLSession/WebKit, Android WebView); it
 ;; contains no proprietary or non-standard cryptography. Apple: answer "uses
 ;; encryption: yes, exempt (standard HTTPS)" or set
 ;; ITSAppUsesNonExemptEncryption = NO in Info.plist. Set by
 ;; :ios/uses-non-exempt-encryption? false (kotoba-lang/shell PR #36), so App
 ;; Store Connect does not ask per build. No ERN/CCATS needed. France
 ;; declaration not needed.
 :export-compliance {:uses-encryption true :exempt true
                     :basis "standard HTTPS via OS networking only"
                     :info-plist-key-set true}

