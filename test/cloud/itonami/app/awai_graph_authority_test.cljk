(ns cloud.itonami.app.awai-graph-authority-test
  (:require [kotoba.test :refer [deftest is]]
            [chain.core :as chain]
            [cloud.itonami.app.awai-graph-authority :as graph-authority]))

(def app-id "net.kotoba.murakumo")
(def publisher-did "did:key:z6MkoPd1PVGGf5gTMGy4nZNrBMszzfaeaNmZfSzgAZZNhDWq")
(def authority-cid
  "bafyreiajuvwx5c52tzkfugs6zzye45sunx4ivoioeht5ckn7o5ak3u3ynq")

(defn- one-commit [authority]
  (let [blocks (atom {})
        put! (fn [cid bytes] (swap! blocks assoc cid bytes))
        get-fn (fn [cid] (get @blocks cid))
        options (cond-> {:actor publisher-did}
                  authority (assoc :authority authority))
        head-cid (chain/commit! put! get-fn {"manifest" app-id} nil options)]
    {:get-fn get-fn :head-cid head-cid}))

(defn- grant
  ([authority-cid]
   (grant authority-cid {}))
  ([authority-cid overrides]
   (merge {:cid authority-cid
           :app-id app-id
           :capability graph-authority/app-graph-write-capability
           :subject publisher-did
           :not-before 1700000000000
           :expires-at 2000000000000
           :revoked-at nil
           :signature-verified? true
           :scope-verified? true}
          overrides)))

(defn- verify [blocks resolve-grant overrides]
  (graph-authority/verify-history
   (:get-fn blocks) (:head-cid blocks)
   (merge {:app-id app-id
           :resolve-grant resolve-grant
           :as-of 1800000000000
           :revocation :prospective}
          overrides)))

(deftest authorized-history-requires-verified-app-scoped-grant
  (let [blocks (one-commit authority-cid)
        result (verify blocks #(grant %) {})]
    (is (= :verified (:decision result)))
    (is (true? (:verified? result)))
    (is (= 1 (:visited result)))
    (is (= 1800000000000 (:as-of result)))
    (is (= [] (:findings result)))))

(deftest invalid-signature-or-wrong-app-scope-fails-closed
  (let [blocks (one-commit authority-cid)
        invalid-signature (verify blocks
                                  #(grant % {:signature-verified? false})
                                  {})
        wrong-app (verify blocks #(grant % {:app-id "net.other.app"}) {})]
    (is (= :refuse (:decision invalid-signature)))
    (is (= :unknown-authority (:reason invalid-signature)))
    (is (= :refuse (:decision wrong-app)))
    (is (= :unknown-authority (:reason wrong-app)))))

(deftest revocation-policy-is-explicit-and-applied-at-evaluation-time
  (let [blocks (one-commit authority-cid)
        result (verify blocks
                       #(grant % {:revoked-at 1799999999999})
                       {:revocation :prospective})]
    (is (= :refuse (:decision result)))
    (is (= :revoked (get-in result [:findings 0 :reason])))))

(deftest history-without-authority-is-not-installable
  (let [blocks (one-commit nil)
        result (verify blocks (fn [_] nil) {})]
    (is (= :refuse (:decision result)))
    (is (= :no-authority (get-in result [:findings 0 :reason])))))

(deftest verifier-requires-evaluation-time-and-revocation-policy
  (let [blocks (one-commit authority-cid)
        missing-time (verify blocks #(grant %) {:as-of nil})
        missing-policy (verify blocks #(grant %) {:revocation nil})]
    (is (= :evaluation-time-required (:error missing-time)))
    (is (= :revocation-policy-required (:error missing-policy)))))
