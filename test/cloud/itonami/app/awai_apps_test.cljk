(ns cloud.itonami.app.awai-apps-test
  "Awai registry resolution selects only releases with live signed origins."
  (:require [ipld.core :as ipld]
            [kotoba.test :refer [deftest is]]
            [kotoba.protocol.install :as install]
            [cloud.itonami.app.awai-apps :as apps]
            [cloud.itonami.app.kotoba-oracle :as oracle]
            [cloud.itonami.app.product-policy :as product-policy]
            [cloud.itonami.app.awai-manifest :as manifest]))

(def app-id "net.kotoba.murakumo")
(def publisher-did "did:key:z1")
(def cell-id "net.kotoba.murakumo.notes")
(def cell-cid (ipld/cid (ipld/encode {"dna" "notes"})))
(def origin-cids
  ["bafyreiajuvwx5c52tzkfugs6zzye45sunx4ivoioeht5ckn7o5ak3u3ynq"
   "bafyreieixtse7yrlgr7fmdhmyrmb2nfedhcbwps6xdrw6ev6mkmfwtv37y"
   "bafyreig5lceinj4lu7dmntsmf3ggbhhys2j3y4dhnqtqobjeot5bdj4hg4"])

(defn- origin-record [cid host pin-char operator-did]
  {:cid cid
   :sequence 0
   :type "content/origin"
   :body {:app-id app-id
          :publisher-did publisher-did
          :operator-did operator-did
          :host host
          :spki-sha256 (apply str (repeat 64 pin-char))
          :expires-at 2000000000}})

(defn- snapshot [origins release-body]
  {:schema "awai.app-registry.read.v4"
   :dna-cid "bafkreifwintjn6lddprilx7xpbxrtorzkuxhjwhs7c4x3c4aippelcipnu"
   :records (into
             [{:cid "bafkreihbfo374yy4mz2w3sli2azqfw3ea73cnr3jm5gzqvub7wsh57uoxa"
               :sequence 0
               :type "domain/bind"
               :body {:domain "murakumo.cloud"
                      :app-id app-id
                      :publisher-did publisher-did
                      :domain-owner-did publisher-did
                      :channel "stable"
                      :release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
                      :sequence 1
                      :previous-binding-cid ""
                      :expires-at 2000000000}}
              {:cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
               :sequence 0
               :type "app/release"
               :body (merge {:app-id app-id
                             :publisher-did publisher-did
                             :channel "stable"
                             :sequence 1
                             :previous-release-cid ""
                             :manifest-cid "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"}
                            release-body)}]
             origins)})

(defn- registered-origins []
  (mapv origin-record origin-cids
        ["content-a.example" "content-b.example" "content-c.example"]
        [\a \b \c]
        ["did:key:z2" "did:key:z3" "did:key:z4"]))

(defn- resolve-candidates [snapshot]
  (apps/registry-domain-candidates
   {:trust "configured-peer-checkpoint-quorum" :snapshot snapshot}
   1800000000))

(defn- installed-record [cells]
  {:schema apps/installation-schema
   :install-lock {:schema install/install-lock-schema
                  :app-id app-id
                  :version "1.0.0"
                  :channel "stable"
                  :publisher-did
                  "did:key:z6MkoPd1PVGGf5gTMGy4nZNrBMszzfaeaNmZfSzgAZZNhDWq"
                  :release-sequence 1
                  :release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
                  :manifest-cid "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"
                  :bundle-cid "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"
                  :cells cells
                  :requested-caps []}
   :origin {:domain "murakumo.cloud"
            :binding-cid "bafkreihbfo374yy4mz2w3sli2azqfw3ea73cnr3jm5gzqvub7wsh57uoxa"
            :binding-sequence 1
            :binding-expires-at 1900000000
            :dns-proof-checked-at 1800000000
            :dns-proof-expires-at 1800000300}
   :approved-caps []
   :installed-at 1800000001})

(def ^:private app-domain-binding-cid
  "bafkreihbfo374yy4mz2w3sli2azqfw3ea73cnr3jm5gzqvub7wsh57uoxa")
(def ^:private app-release-cid
  "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4")
(def ^:private app-chain-profile
  {:profile-id "awai-apps-test-v1"
   :chain-id "awai-apps-test-chain-v1"
   :genesis-hash "genesis-test-hash"
   :validator-set-id "validators-test-v1"
   :quorum-policy-id "quorum-policy-test-v1"})

(defn- current-ref-proof [ref head-cid challenge now-ms]
  {:trust "amano-inga-verified-current-ref"
   :decision :verified
   :profile-id (:profile-id app-chain-profile)
   :chain-id (:chain-id app-chain-profile)
   :genesis-hash (:genesis-hash app-chain-profile)
   :validator-set-id (:validator-set-id app-chain-profile)
   :quorum-policy-id (:quorum-policy-id app-chain-profile)
   :ref ref
   :head-cid head-cid
   :challenge challenge
   :current? true
   :quorum-read-verified? true
   :current-read-proof {:trust "inga-quorum-current-ref-read"}
   :finality-proof-verified? true
   :finalized-event-cid head-cid
   :finality-proof {:status :finalized}
   :observed-at (dec now-ms)
   :expires-at (+ now-ms 30000)})

(defn- lifecycle-dns-proof [domain binding-cid now]
  {:verified? true
   :fresh? true
   :dnssec-status :secure
   :domain domain
   :qname (str "_itonami-app." domain ".")
   :binding-cid binding-cid
   :alias-chain []
   :txt-record-count 1
   :checked-at now
   :expires-at (+ now 30)
   :signature-expires-at (+ now 300)
   :ttl-seconds 30})

(defn- lifecycle-resolution-input [now-ms]
  (let [domain "murakumo.cloud"
        challenge "test-challenge-123456"
        domain-ref (str "awai/domain/" domain)
        app-ref (str "awai/app/" app-id "/stable")]
    {:binding {:verified? true
               :domain domain
               :entry-cid app-domain-binding-cid
               :app-id app-id
               :publisher-did publisher-did
               :channel "stable"
               :sequence 1
               :expires-at 2000000000}
     :txt-proof (lifecycle-dns-proof domain app-domain-binding-cid 1800000000)
     :release {:app-id app-id
               :publisher-did publisher-did
               :channel "stable"
               :release-cid app-release-cid
               :sequence 1}
     :now 1800000001
     :amano-now-ms now-ms
     :challenge challenge
     :amano-chain-profile app-chain-profile
     :amano-ref-proofs
     {domain-ref (current-ref-proof domain-ref app-domain-binding-cid challenge now-ms)
      app-ref (current-ref-proof app-ref app-release-cid challenge now-ms)}}))

(deftest first-domain-binding-release-and-origin-records-resolve
  (let [records (registered-origins)
        result (resolve-candidates
                (snapshot records {:content-origin-cids origin-cids}))]
    (is (= :candidates (:decision result)))
    (is (= :candidate (get-in result [:candidates 0 :decision])))
    (is (= 1 (get-in result [:candidates 0 :binding-sequence])))
    (is (= 1 (get-in result [:candidates 0 :release-sequence])))
    (is (= "ready" (get-in result [:candidates 0 :content-origin-status])))
    (is (= ["content-a.example" "content-b.example" "content-c.example"]
           (mapv :host (get-in result [:candidates 0 :content-origins]))))))

(deftest domain-binding-stays-on-its-explicit-release-pin
  (let [records (registered-origins)
        release-one "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        release-two {:cid (ipld/cid (ipld/encode {"release" "next"}))
                     :sequence 1
                     :type "app/release"
                     :body {:app-id app-id
                            :publisher-did publisher-did
                            :channel "stable"
                            :sequence 2
                            :previous-release-cid release-one
                            :manifest-cid (ipld/cid (ipld/encode {"manifest" "next"}))
                            :content-origin-cids origin-cids}}
        result (resolve-candidates
                (update (snapshot records {:content-origin-cids origin-cids})
                        :records conj release-two))
        candidate (first (:candidates result))]
    (is (= :candidate (:decision candidate)))
    (is (= release-one (:release-cid candidate)))
    (is (= 1 (:release-sequence candidate)))
    (is (= "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"
           (:manifest-cid candidate)))))

(deftest domain-binding-requires-a-release-cid
  (let [registry (update-in (snapshot (registered-origins) {})
                            [:records 0 :body] dissoc :release-cid)
        result (resolve-candidates registry)]
    (is (= :refuse (:decision result)))
    (is (= :invalid-registry-record (:error result)))))

(deftest domain-binding-refuses-cloudflare-managed-aliases
  (let [registry (assoc-in (snapshot (registered-origins) {})
                           [:records 0 :body :domain]
                           "setup.workers.dev")
        result (resolve-candidates registry)]
    (is (= :refuse (:decision result)))
    (is (= :invalid-registry-record (:error result)))))

(deftest persisted-installation-refuses-cloudflare-managed-domain
  (let [record (assoc-in (installed-record [{:id cell-id :dna-cid cell-cid}])
                         [:origin :domain]
                         "setup.pages.dev")]
    (is (= [{:field :origin :error :invalid-domain-origin}]
           (apps/installation-problems record)))))

(deftest publisher-revocation-removes-the-release-from-domain-candidates
  (let [release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        revocation {:cid (ipld/cid (ipld/encode {"revocation" release-cid}))
                    :sequence 0
                    :type "app/revoke"
                    :body {:app-id app-id
                           :publisher-did publisher-did
                           :release-cid release-cid
                           :sequence 1
                           :previous-revoke-cid ""
                           :reason-code "security-review"
                           :issued-at 1800000000}}
        registry (snapshot (registered-origins) {})
        result (resolve-candidates (update registry :records conj revocation))
        candidate (first (:candidates result))]
    (is (= :revoked (:decision candidate)))
    (is (= :release-revoked (:reason candidate)))
    (is (= "revoked" (:revocation-status candidate)))
    (is (= release-cid (:release-cid candidate)))))

(deftest conflicting-revocation-sequences-block-install-candidates
  (let [release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        revoke (fn [reason]
                 {:cid (ipld/cid (ipld/encode {"revocation" reason}))
                  :sequence 0 :type "app/revoke"
                  :body {:app-id app-id :publisher-did publisher-did
                         :release-cid release-cid :sequence 1
                         :previous-revoke-cid "" :reason-code reason
                         :issued-at 1800000000}})
        registry (snapshot (registered-origins) {})]
    ;; Construct two signed-chain roots; neither may be selected by arrival order.
    (let [result (resolve-candidates
                  (update registry :records into
                          [(revoke "security-review") (revoke "publisher-request")]))
          candidate (first (:candidates result))]
      (is (= :conflict (:decision candidate)))
      (is (= :revocation-chain-conflict (:reason candidate)))
      (is (= "conflict" (:revocation-status candidate))))))

(deftest revocation-cannot-reference-an-unrelated-publisher-release
  (let [revocation {:cid (ipld/cid (ipld/encode {"revocation" "mismatch"}))
                    :sequence 0
                    :type "app/revoke"
                    :body {:app-id app-id
                           :publisher-did publisher-did
                           :release-cid "bafkreiajuvwx5c52tzkfugs6zzye45sunx4ivoioeht5ckn7o5ak3u3ynq"
                           :sequence 1
                           :previous-revoke-cid ""
                           :reason-code "security-review"
                           :issued-at 1800000000}}
        result (resolve-candidates
                (update (snapshot (registered-origins) {}) :records conj revocation))]
    (is (= :refuse (:decision result)))
    (is (= :invalid-revocation-target (:error result)))))

(deftest releases-without-registered-origins-are-not-deployable-candidates
  (let [result (resolve-candidates (snapshot [] {}))]
    (is (= :content-origins-missing
           (get-in result [:candidates 0 :decision])))))

(deftest referenced-origin-expiry-blocks-the-release-candidate
  (let [records (assoc (registered-origins) 0
                       (assoc-in (first (registered-origins))
                                 [:body :expires-at] 1800000000))
        result (resolve-candidates
                (snapshot records {:content-origin-cids origin-cids}))]
    (is (= :content-origins-expired
           (get-in result [:candidates 0 :decision])))))

(deftest public-manifest-must-match-its-verified-awai-release
  (let [wire {"schema" "kotoba.app.manifest.v1"
              "entity" {"kotoba.app/id" app-id
                        "kotoba.app/version" "1.0.0"
                        "kotoba.app/kind" "embed"
                        "kotoba.app/bundle-cid"
                        "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"
                        "kotoba.app/entry" "index.html"}}
        manifest-bytes (ipld/encode wire)
        manifest-cid (ipld/cid manifest-bytes)
        manifest-result (manifest/verify-block manifest-cid manifest-bytes app-id)
        release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        release-record {:cid release-cid
                        :sequence 0
                        :type "app/release"
                        :body {:app-id app-id
                               :manifest-cid manifest-cid
                               :publisher-did publisher-did
                               :channel "stable"
                               :sequence 1}}
        registry-result {:trust "configured-peer-checkpoint-quorum"
                         :snapshot {:schema "awai.app-registry.read.v4"
                                    :records [release-record]}}
        result (apps/verified-release-descriptor
                registry-result release-cid manifest-result)]
    (is (= :verified (:decision result)))
    (is (= release-cid (get-in result [:release :release-cid])))
    (is (= manifest-cid (get-in result [:release :manifest-cid])))
    (is (= "net.kotoba.murakumo"
           (get-in result [:release :manifest :kotoba.app/id])))))

(deftest public-manifest-cannot-be-substituted-for-another-release
  (let [wire {"schema" "kotoba.app.manifest.v1"
              "entity" {"kotoba.app/id" app-id
                        "kotoba.app/version" "1.0.0"
                        "kotoba.app/kind" "embed"
                        "kotoba.app/bundle-cid"
                        "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"}}
        manifest-bytes (ipld/encode wire)
        manifest-result (manifest/verify-block (ipld/cid manifest-bytes)
                                               manifest-bytes app-id)
        release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        release-record {:cid release-cid :sequence 0 :type "app/release"
                        :body {:app-id app-id
                               :manifest-cid "bafkreifwintjn6lddprilx7xpbxrtorzkuxhjwhs7c4x3c4aippelcipnu"
                               :publisher-did publisher-did
                               :channel "stable" :sequence 1}}
        registry-result {:trust "configured-peer-checkpoint-quorum"
                         :snapshot {:schema "awai.app-registry.read.v4"
                                    :records [release-record]}}
        result (apps/verified-release-descriptor
                registry-result release-cid manifest-result)]
    (is (= :refuse (:decision result)))
    (is (= :manifest-cid-does-not-match-release (:error result)))))

(deftest verified-release-descriptor-refuses-a-revoked-release
  (let [wire {"schema" "kotoba.app.manifest.v1"
              "entity" {"kotoba.app/id" app-id
                        "kotoba.app/version" "1.0.0"
                        "kotoba.app/kind" "embed"
                        "kotoba.app/bundle-cid"
                        "bafkreig4jyeaynm47icfmqj3m5ya7iep2o7c4vk34pwpafm7tnf4tfimny"
                        "kotoba.app/entry" "index.html"}}
        manifest-bytes (ipld/encode wire)
        manifest-cid (ipld/cid manifest-bytes)
        manifest-result (manifest/verify-block manifest-cid manifest-bytes app-id)
        release-cid "bafkreiesyfwcohnsr47o2eapym5ahwxzghpxpej253k6d4wygj4hrfnhp4"
        release-record {:cid release-cid :sequence 0 :type "app/release"
                        :body {:app-id app-id :manifest-cid manifest-cid
                               :publisher-did publisher-did :channel "stable"
                               :sequence 1}}
        revocation {:cid (ipld/cid (ipld/encode {"revoked" release-cid}))
                    :sequence 1 :type "app/revoke"
                    :body {:app-id app-id :publisher-did publisher-did
                           :release-cid release-cid :sequence 1
                           :previous-revoke-cid "" :reason-code "security-review"
                           :issued-at 1800000000}}
        registry-result {:trust "configured-peer-checkpoint-quorum"
                         :snapshot {:schema "awai.app-registry.read.v4"
                                    :records [release-record revocation]}}
        result (apps/verified-release-descriptor
                registry-result release-cid manifest-result)]
    (is (= :refuse (:decision result)))
    (is (= :release-revoked (:error result)))))

(deftest protected-install-record-authorizes-only-its-exact-cell-cid
  (let [record (installed-record [{:id cell-id :dna-cid cell-cid}])
        authorized (apps/authorize-cell-install record cell-id cell-cid)
        other-cid (ipld/cid (ipld/encode {"dna" "other"}))
        wrong-cid (apps/authorize-cell-install record cell-id other-cid)
        undeclared-cell (apps/authorize-cell-install
                         record "net.kotoba.murakumo.other" cell-cid)
        corrupted (apps/authorize-cell-install
                   (assoc-in record [:install-lock :release-cid] "not-a-cid")
                   cell-id cell-cid)]
    (is (= {:decision :authorized
            :app-id app-id
            :release-cid (get-in record [:install-lock :release-cid])
            :cell-id cell-id
            :bundle-cid cell-cid}
           authorized))
    (is (= :cell-not-declared-by-install-lock (:error wrong-cid)))
    (is (= :cell-not-declared-by-install-lock (:error undeclared-cell)))
    (is (= :invalid-installation (:error corrupted)))))

(deftest amano-ref-freshness-uses-milliseconds-separately-from-dns-seconds
  (let [now-ms 1800000001000
        checks (atom [])
        result (apps/resolve-domain
                "murakumo.cloud"
                (assoc (lifecycle-resolution-input now-ms)
                       :verify-amano-ref
                       (fn [request]
                         (swap! checks conj (:now-ms request))
                         true)))]
    (is (= [now-ms now-ms] @checks))
    (is (not (contains? #{:amano-current-ref-proof-unavailable
                          :invalid-amano-current-ref-proof}
                        (:error result))))))

(deftest amano-ref-proof-fails-closed-without-millisecond-clock
  (let [input (dissoc (lifecycle-resolution-input 1800000001000)
                      :amano-now-ms)
        result (apps/resolve-domain "murakumo.cloud"
                                    (assoc input :verify-amano-ref (fn [_] true)))]
    (is (= :refuse (:decision result)))
    (is (= :amano-current-ref-proof-unavailable (:error result)))))

(deftest shinshi-policy-call-uses-the-indexed-micro-luma-abi
  (is (= [:i64 :i64]
         (:input-abi (product-policy/policy-info "shinshi.club"))))
  (is (= 1 (oracle/i64-value
            (product-policy/call-policy
             "shinshi.club" 'black-frame-code [1 7999999]))))
  (is (= 0 (oracle/i64-value
            (product-policy/call-policy
             "shinshi.club" 'black-frame-code [1 8000000]))))
  (is (= 1 (oracle/i64-value
            (product-policy/call-policy
             "shinshi.club" 'black-frame-code [0 8000000])))))
