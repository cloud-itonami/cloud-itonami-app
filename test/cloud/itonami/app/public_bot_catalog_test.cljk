(ns cloud.itonami.app.public-bot-catalog-test
  "The portable half of the public-bot catalog tests: every entry carries what
  the installer needs, ids are unique slugs, the manifest is the single
  catalog, and `find-bot`/`install!` resolution is honest about unknown ids.

  Runs on ClojureScript (`bin/test-portable-cljs`) AND on the JVM through the
  leftover suite — which is the point of the namespace being `.cljc`. The
  HTTP face (authentication, CSRF, organization scoping, persistence) is
  `public_bots_http_test.clj`, origin `.clj` with the rest of the loopback
  web tests."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])
            [cloud.itonami.app.public-bot-catalog :as catalog]))

(deftest catalog-is-present-and-single
  (let [entries (catalog/bots)]
    (is (pos? (count entries)))
    (is (= (count entries) (count (distinct (map :id entries)))))))

(deftest every-entry-carries-what-the-installer-needs
  (doseq [entry (catalog/bots)]
    (testing (str "entry " (:id entry))
      (doseq [field [:id :name :avatar :role :brief :author :entry-url
                     :installed-surface :install]]
        (is (not (clojure.string/blank? (str (get entry field))))
            (str field " is present")))
      (is (map? (:defaults (:install entry))))
      (is (re-matches #"^[a-z0-9][a-z0-9-]{0,63}$" (str (:id entry)))
          "id is a lowercase slug"))))

(deftest find-bot-resolves-only-known-ids
  (let [first-entry (first (catalog/bots))]
    (is (= first-entry (catalog/find-bot (:id first-entry))))
    (is (nil? (catalog/find-bot "no-such-public-bot")))))

(deftest the-four-creative-bots-are-offered
  (let [ids (set (map :id (catalog/bots)))]
    (is (contains? ids "mangaka"))
    (is (contains? ids "animeka"))
    (is (contains? ids "dougaka"))
    (is (contains? ids "gameka"))))

(deftest abaki-offers-the-owner-profile-without-computer-or-signer-grants
  (let [entry (catalog/find-bot "abaki")]
    (is (= "etzhayyim" (:author entry)))
    (is (= "etzhayyim/com-etzhayyim-abaki" (get-in entry [:profile-source :repository])))
    (is (re-matches #"[0-9a-f]{40}" (get-in entry [:profile-source :revision])))
    (is (= "hermes/profiles/abaki" (get-in entry [:profile-source :path])))
    (is (= false (get-in entry [:install :defaults :computer?])))
    (is (= true (get-in entry [:install :defaults :coding?])))
    (is (nil? (get-in entry [:install :defaults :signer])))
    (is (clojure.string/includes? (:brief entry) "scripts/market_watch.py"))))

(deftest installing-abaki-carries-pinned-instructions-and-only-existing-capabilities
  (let [entry (catalog/find-bot "abaki")
        attrs (catalog/install-attributes
               (assoc-in entry [:install :defaults :signer] "must-not-copy"))]
    (is (clojure.string/includes? (:brief attrs)
          (str "/blob/" (get-in entry [:profile-source :revision]) "/hermes/profiles/abaki/SOUL.md")))
    (is (= false (:computer? attrs)))
    (is (nil? (:signer attrs)))
    (is (nil? (:accounts attrs)))
    (is (nil? (:organization-id attrs)))))

(deftest profile-source-cannot-use-mutable-or-escaping-paths
  (let [entry (catalog/find-bot "abaki")]
    (doseq [[key value] [[:revision "main"] [:repository "https://example.com"]
                       [:path "../private"] [:path "/absolute"]]]
      (is (thrown? #?(:clj Exception :cljs js/Error)
                   (catalog/install-attributes (assoc-in entry [:profile-source key] value)))))))

(deftest registry-offers-are-pinned-and-inert
  (let [registry (filter :registry (catalog/bots))]
    (is (seq registry) "the generated itonami-registry offers are merged in")
    (doseq [entry registry]
      (testing (str "registry offer " (:id entry))
        (is (= "itonami-registry" (:installed-surface entry)))
        (is (not-any? true? (vals (get-in entry [:install :defaults])))
            "a registry template grants nothing")
        (is (re-matches #"[0-9a-f]{40}" (str (get-in entry [:profile-source :revision]))))
        (is (re-find #"/templates/hermes/SOUL\.md" (:brief (catalog/install-attributes entry)))
            "the brief points at the pinned SOUL.md")
        (is (re-matches #"sha256:[0-9a-f]{64}" (str (get-in entry [:registry :checksum]))))))))

(deftest a-registry-offer-that-grants-is-refused
  (let [entry (first (filter :registry (catalog/bots)))
        commit (get-in entry [:profile-source :revision])]
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (#'catalog/validate-registry
                  {:schema catalog/registry-schema :registry {:commit commit}
                   :bots [(assoc-in entry [:install :defaults :writes?] true)]})))
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (catalog/merge-catalogs {:bots [entry]} {:bots [entry]}))
        "an id offered by both sources is an error")))
