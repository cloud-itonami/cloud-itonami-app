(require '[cloud.itonami.app.bots :as bots]
         '[cloud.itonami.app.hermes-compat :as hermes]
         '[cloud.itonami.app.provider :as provider])
(let [entered (promise) owner {:user-id "u" :organization-id "o"}]
  (with-redefs [bots/runtime-bindings (fn [_ _] {:bots [{:id "bot-native" :enabled? true}]})
                bots/send-stream! (fn [_ session id text run-id goal? event options]
                                    (deliver entered {:session session :id id :goal? goal? :options options})
                                    [{:role "bot" :text "ok"}])
                bots/latest-turn (fn [_ _] {:state "completed"})]
    (hermes/start-run! {} owner "bot-native" {:input "check" :response_mode "text-only" :context_mode "isolated"})
    (let [seen (deref entered 2000 :timeout)]
      (assert (= owner (:session seen)))
      (assert (= "bot-native" (:id seen)))
      (assert (false? (:goal? seen)))
      (assert (= {:text-only? true :concise? true :isolated? true} (:options seen))))))
(with-redefs [provider/model-context-window (fn [& _] 8192)]
  (let [p {:kind :openai-compatible :max-output-tokens 4096}
        request (#'bots/agent-request {} p {:bot/id "bot-native"}
                                     {:text-only? true :concise? true :messages [] :tools []} "mishima")
        body (#'provider/agent-request-body p (assoc request :tools [{:name "unused"}]))]
    (assert (= 4096 (:context-input-limit-tokens request)))
    (assert (= 768 (:max_tokens body)))
    (assert (= false (get-in body [:chat_template_kwargs :enable_thinking])))
    (assert (not (contains? body :tools)))))
(println "Native text-only smoke passed: same owner, no goal, no tools, bounded non-thinking response")
(shutdown-agents)
