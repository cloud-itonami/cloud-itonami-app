(require '[fleet-reward-contracts :as contracts]
         '["fs" :as fs] '["path" :as path] '["os" :as os])
(def root (fs/mkdtempSync (path/join (os/tmpdir) "reward-contract-test-")))
(def profile (path/join root "profiles/producer"))
(def backup (path/join root "backups"))
(fs/mkdirSync profile #js {:recursive true})
(def file (path/join profile "SOUL.md"))
(def original "Owner persona must survive.\n")
(fs/writeFileSync file original)
(assert (= 1 (get-in (contracts/rollout! root backup false) [:counts "planned"])))
(assert (= original (fs/readFileSync file "utf8")))
(assert (not (fs/existsSync backup)))
(assert (= 1 (get-in (contracts/rollout! root backup true) [:counts "applied"])))
(assert (= original (fs/readFileSync (path/join backup (str "producer-" (contracts/digest original) ".md")) "utf8")))
(assert (= 1 (get-in (contracts/rollout! root backup true) [:counts "current"])))
(fs/mkdirSync (path/join root "profiles/link"))
(fs/symlinkSync file (path/join root "profiles/link/SOUL.md"))
(assert (= 2 (get-in (contracts/rollout! root backup true) [:counts "skipped"])))
(println "Reward contract rollout passed: read-only plan, owner preservation, original backup, idempotence and symlink refusal")
