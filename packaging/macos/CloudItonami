#!/bin/bash
set -euo pipefail

contents_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
resources_dir="$contents_dir/Resources"
support_dir="${CLOUD_ITONAMI_DATA_DIR:-$HOME/Library/Application Support/Cloud Itonami}"
log_dir="$HOME/Library/Logs/Cloud Itonami"
server_pid=""

mkdir -p "$support_dir" "$log_dir"

pending_dir="$support_dir/updates/pending"
bundle_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$contents_dir/Info.plist")"
start_pending_update() {
  current_bundle="$(CDPATH= cd -- "$contents_dir/.." && pwd)"
  helper="$support_dir/apply-update-macos"
  cp "$resources_dir/ApplyUpdateMacos" "$helper"
  chmod 700 "$helper"
  nohup "$helper" "$$" "$current_bundle" "$pending_dir/package.zip" \
    "$pending_dir" "$log_dir/updater.log" >/dev/null 2>&1 &
}

if [[ -f "$pending_dir/pending.edn" && -f "$pending_dir/package.zip" &&
      -f "$pending_dir/package.sha256" && -f "$pending_dir/version.txt" ]]; then
  pending_version="$(/usr/bin/tr -d '[:space:]' < "$pending_dir/version.txt")"
  # An older helper opens the replacement before it archives `pending`.  When
  # this bundle already is that target version, start normally so the older
  # helper can observe health and finish instead of recursively applying the
  # same package.
  if [[ "$pending_version" != "$bundle_version" ]]; then
    start_pending_update
    exit 0
  fi
fi

healthy() {
  /usr/bin/curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1
}

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if ! healthy; then
  server_bin="$contents_dir/MacOS/cloud-itonami-server"
  if [[ ! -x "$server_bin" ]]; then
    server_bin="$resources_dir/cloud-itonami-server"
  fi
  if [[ ! -x "$server_bin" ]]; then
    /usr/bin/osascript -e 'display alert "Cloud Itonami host adapter missing" message "cloud-itonami-server was not packaged. This build does not start Java." as critical' || true
    exit 1
  fi
  CLOUD_ITONAMI_DATA_DIR="$support_dir" \
    "$server_bin" >>"$log_dir/server.log" 2>&1 &
  server_pid=$!

  for _ in {1..600}; do
    if healthy; then
      break
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
      /usr/bin/osascript -e 'display alert "Cloud Itonami could not start" message "See ~/Library/Logs/Cloud Itonami/server.log for details." as critical' || true
      exit 1
    fi
    sleep 0.1
  done
fi

if ! healthy; then
  /usr/bin/osascript -e 'display alert "Cloud Itonami timed out" message "The local server did not become ready." as critical' || true
  exit 1
fi

# `?surface=native` matches app.kotoba.edn: it is how the page learns it is
# inside the native webview. Without it the page treats this window as a
# browser, follows sign-in hrefs into the webview, and the person is stranded
# on a WebAuthn ceremony the webview cannot finish (RFC 8252; the packaged
# launcher shipped without the flag and that is exactly what happened).
window_status=0
"$contents_dir/MacOS/kotoba-shell-host" \
  --title "Cloud Itonami" \
  --icon "$resources_dir/icon.png" \
  --web-url 'http://localhost:1338/?surface=native&chrome=titlebar-overlay' \
  --titlebar-overlay \
  --width 1100 --height 760 --min-width 430 --min-height 640 || window_status=$?

# A Settings update ends by closing the native window.  The old launcher used
# to notice a staged package only on a later manual open, so the button could
# prepare an update but could not finish it.  Schedule the helper while this
# launcher still owns the exact bundle path; the helper waits for our trap to
# stop the server, replaces the bundle, health-checks it, and reopens it.
if [[ -f "$pending_dir/pending.edn" && -f "$pending_dir/package.zip" &&
      -f "$pending_dir/package.sha256" && -f "$pending_dir/version.txt" ]]; then
  start_pending_update
fi
exit "$window_status"
