#!/bin/bash
set -euo pipefail

contents_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
resources_dir="$contents_dir/Resources"
support_dir="${CLOUD_ITONAMI_DATA_DIR:-$HOME/Library/Application Support/Cloud Itonami}"
log_dir="$HOME/Library/Logs/Cloud Itonami"
server_pid=""

mkdir -p "$support_dir" "$log_dir"

pending_dir="$support_dir/updates/pending"
if [[ -f "$pending_dir/pending.edn" && -f "$pending_dir/package.zip" ]]; then
  current_bundle="$(CDPATH= cd -- "$contents_dir/.." && pwd)"
  helper="$support_dir/apply-update-macos"
  cp "$resources_dir/ApplyUpdateMacos" "$helper"
  chmod 700 "$helper"
  nohup "$helper" "$$" "$current_bundle" "$pending_dir/package.zip" \
    "$pending_dir" "$log_dir/updater.log" >/dev/null 2>&1 &
  exit 0
fi

healthy() {
  /usr/bin/curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1
}

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if ! healthy; then
  java_home="$(/usr/libexec/java_home -v 21 2>/dev/null || true)"
  if [[ -z "$java_home" || ! -x "$java_home/bin/java" ]]; then
    /usr/bin/osascript -e 'display alert "Cloud Itonami requires Java 21" message "Install Java 21 or later, then open Cloud Itonami again." as critical' || true
    exit 1
  fi
  CLOUD_ITONAMI_DATA_DIR="$support_dir" \
    "$java_home/bin/java" -cp "$resources_dir/cloud-itonami-app.jar" \
    clojure.main -m cloud.itonami.app.server \
    >>"$log_dir/server.log" 2>&1 &
  server_pid=$!

  for _ in {1..600}; do
    if healthy; then
      break
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
      /usr/bin/osascript -e 'display alert "Cloud Itonami could not start" message "See ~/Library/Logs/Cloud Itonami/server.log for details." as critical' || true
      exit 1
    fi
    sleep 0.1
  done
fi

if ! healthy; then
  /usr/bin/osascript -e 'display alert "Cloud Itonami timed out" message "The local server did not become ready." as critical' || true
  exit 1
fi

# `?surface=native` matches app.kotoba.edn: it is how the page learns it is
# inside the native webview. Without it the page treats this window as a
# browser, follows sign-in hrefs into the webview, and the person is stranded
# on a WebAuthn ceremony the webview cannot finish (RFC 8252; the packaged
# launcher shipped without the flag and that is exactly what happened).
"$contents_dir/MacOS/kotoba-shell-host" \
  --title "Cloud Itonami" \
  --icon "$resources_dir/icon.png" \
  --web-url 'http://localhost:1338/?surface=native&chrome=titlebar-overlay' \
  --titlebar-overlay \
  --width 430 --height 860 --min-width 360 --min-height 640
