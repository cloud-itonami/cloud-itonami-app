#!/bin/bash
set -euo pipefail

parent_pid="$1"
current_bundle="$2"
package="$3"
pending_dir="$4"
log_file="$5"

exec >>"$log_file" 2>&1
while kill -0 "$parent_pid" 2>/dev/null; do sleep 0.2; done

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
work_dir="${pending_dir}.apply-${stamp}"
extract_dir="$work_dir/extracted"
backup_bundle="${current_bundle}.previous"
failed_bundle="${current_bundle}.failed-${stamp}"
failed_update="${pending_dir}.failed-${stamp}"
completed=false

archive_failed_claim() {
  if [[ "$completed" != true && -d "$work_dir" ]]; then
    mv "$work_dir" "$failed_update"
  fi
}
trap archive_failed_claim EXIT

# Claim the pending update before the replacement app is opened.  Until this
# move, a freshly opened launcher can observe `updates/pending` and start a
# second helper while this one is still health-checking the first replacement.
# The move is atomic on the application-support volume and makes one helper the
# sole owner of this staged package.
if ! mv "$pending_dir" "$work_dir"; then
  echo "staged update was already claimed"
  exit 1
fi
package="$work_dir/package.zip"
mkdir -p "$extract_dir"

cd "$work_dir"
if ! /usr/bin/shasum -a 256 -c package.sha256; then
  echo "staged update digest changed after verification"
  exit 1
fi
expected_version="$(/usr/bin/tr -d '[:space:]' < version.txt)"
if [[ ! "$expected_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "staged update version is invalid"
  exit 1
fi

/usr/bin/ditto -x -k "$package" "$extract_dir"
new_bundle="$extract_dir/Cloud Itonami.app"

if [[ ! -d "$new_bundle" ]]; then
  echo "update archive contains no Cloud Itonami.app"
  exit 1
fi
/usr/bin/codesign --verify --deep --strict --verbose=2 "$new_bundle"
new_identifier="$(/usr/bin/codesign -dv --verbose=4 "$new_bundle" 2>&1 | /usr/bin/sed -n 's/^Identifier=//p')"
if [[ "$new_identifier" != "cloud.itonami.app" ]]; then
  echo "update has the wrong bundle identifier"
  exit 1
fi

current_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$current_bundle/Contents/Info.plist")"
new_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$new_bundle/Contents/Info.plist")"
if [[ "$new_version" != "$expected_version" ]]; then
  echo "update bundle version does not match the signed staging record"
  exit 1
fi
if ! /usr/bin/awk -v old="$current_version" -v new="$new_version" 'BEGIN {
  split(old,a,"."); split(new,b,".");
  for (i=1;i<=3;i++) { if ((b[i]+0)>(a[i]+0)) exit 0; if ((b[i]+0)<(a[i]+0)) exit 1 }
  exit 1
}'; then
  echo "update version does not advance the installed version"
  exit 1
fi

current_signature="$(/usr/bin/codesign -dv --verbose=4 "$current_bundle" 2>&1)"
signature_details="$(/usr/bin/codesign -dv --verbose=4 "$new_bundle" 2>&1)"
if [[ "$current_signature" == *"TeamIdentifier=3A5CBTEBFP"* ]]; then
  if [[ "$signature_details" != *"Authority=Developer ID Application:"* ||
        "$signature_details" != *"TeamIdentifier=3A5CBTEBFP"* ]]; then
    echo "a Developer ID installation cannot update to another publisher"
    exit 1
  fi
  /usr/sbin/spctl --assess --type execute --verbose=2 "$new_bundle"
elif [[ "$current_signature" == *"Signature=adhoc"* ]]; then
  if [[ "$signature_details" == *"TeamIdentifier=3A5CBTEBFP"* ]]; then
    /usr/sbin/spctl --assess --type execute --verbose=2 "$new_bundle"
  elif [[ "$signature_details" != *"Signature=adhoc"* ||
          "$signature_details" != *"TeamIdentifier=not set"* ]]; then
    echo "preview update changed publisher authority"
    exit 1
  fi
else
  echo "current installation has no admitted publisher authority"
  exit 1
fi

if [[ -e "$backup_bundle" ]]; then
  mv "$backup_bundle" "${backup_bundle}.${stamp}"
fi
if ! mv "$current_bundle" "$backup_bundle"; then
  echo "cannot replace $current_bundle; install the downloaded release manually"
  exit 1
fi
if ! mv "$new_bundle" "$current_bundle"; then
  mv "$backup_bundle" "$current_bundle"
  exit 1
fi

open "$current_bundle"
healthy=false
for _ in {1..240}; do
  if /usr/bin/curl -fsS http://127.0.0.1:1338/health >/dev/null 2>&1; then
    healthy=true
    break
  fi
  sleep 0.5
done

if [[ "$healthy" != true ]]; then
  echo "updated app did not become healthy; rolling back"
  /usr/bin/pkill -f "$current_bundle/Contents" 2>/dev/null || true
  sleep 1
  mv "$current_bundle" "$failed_bundle"
  mv "$backup_bundle" "$current_bundle"
  open "$current_bundle"
  exit 1
fi

printf '{:schema "cloud.itonami.applied-update.v1" :from-version "%s" :version "%s" :applied-at "%s"}\n' \
  "$current_version" "$new_version" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  > "${pending_dir%/pending}/last-applied.edn"
mv "$work_dir" "${pending_dir}.applied-${stamp}"
completed=true
echo "update applied successfully"
