(ns cloud.itonami.app.awai-bundle-node
  "Materialize one app entry from the active Node host's verified CID store.

  Every block is re-read through the private content-store adapter, which
  checks its CID and owner-only file boundary. This module never fetches
  network data and never returns a filesystem path. The HTTP host must still
  enforce the installation record and serve the returned bytes from an
  isolated app origin with a restrictive policy."
  (:require [clojure.string :as str]
            [ipld.dag-pb :as dag-pb]
            [protobuf.wire :as protobuf]
            [kotoba.protocol.cid :as cid]
            [cloud.itonami.app.awai-content-store-node :as content-store]))

(def maximum-entry-bytes (* 64 1024 1024))
(def maximum-entry-blocks 4096)
(def maximum-directory-depth 32)
(def maximum-file-depth 32)

(def ^:private unixfs-data-schema
  {1 {:name :type :type :enum}
   2 {:name :data :type :bytes}
   3 {:name :filesize :type :uint64}
   4 {:name :blocksizes :type :uint64 :repeated true}})

(def ^:private unixfs-directory-type 1)
(def ^:private unixfs-file-type 2)
(def ^:private content-types
  {".html" "text/html; charset=utf-8"
   ".htm" "text/html; charset=utf-8"
   ".css" "text/css; charset=utf-8"
   ".js" "text/javascript; charset=utf-8"
   ".mjs" "text/javascript; charset=utf-8"
   ".json" "application/json; charset=utf-8"
   ".wasm" "application/wasm"
   ".svg" "image/svg+xml"
   ".png" "image/png"
   ".jpg" "image/jpeg"
   ".jpeg" "image/jpeg"
   ".webp" "image/webp"
   ".woff2" "font/woff2"})

(defn- refuse! [reason data]
  (throw (ex-info (name reason) (assoc data :reason reason))))

(defn- cid-codec [block-cid]
  (when-not (string? block-cid)
    (refuse! :invalid-cid {:cid block-cid}))
  (let [{:keys [codec error]} (cid/parse-cid block-cid)]
    (when error
      (refuse! :invalid-cid {:cid block-cid}))
    codec))

(defn- read-block! [data-root block-cid budget]
  (let [next-count (swap! budget inc)]
    (when (> next-count maximum-entry-blocks)
      (refuse! :entry-block-limit {:maximum maximum-entry-blocks}))
    (let [result (content-store/read-verified-block data-root block-cid)
          bytes (:bytes result)]
      (when-not (and (= :verified (:decision result))
                     (= block-cid (:cid result))
                     (instance? js/Uint8Array bytes))
        (refuse! :verified-content-block-unavailable
                 {:cid block-cid :store-decision (:decision result)}))
      bytes)))

(defn- decode-unixfs-data [block-cid node-bytes]
  (let [node (try
               (dag-pb/decode node-bytes)
               (catch :default _
                 (refuse! :invalid-dag-pb-node {:cid block-cid})))
        data (try
               (protobuf/decode unixfs-data-schema (:data node))
               (catch :default _
                 (refuse! :invalid-unixfs-data {:cid block-cid})))]
    (assoc data :links (:links node))))

(defn- as-buffer [bytes]
  (cond
    (instance? js/Uint8Array bytes) (js/Buffer.from bytes)
    (sequential? bytes) (js/Buffer.from (clj->js bytes))
    :else (refuse! :invalid-unixfs-inline-data {})))

(defn- valid-entry-path? [entry]
  (and (string? entry)
       (not-empty entry)
       (<= (.byteLength js/Buffer entry "utf8") 2048)
       (not (str/starts-with? entry "/"))
       (not (str/ends-with? entry "/"))
       (not (str/includes? entry "\\"))
       (every? (fn [segment]
                 (and (not-empty segment)
                      (not (#{"." ".."} segment))
                      (<= (.byteLength js/Buffer segment "utf8") 255)
                      (not (re-find #"[/\\\u0000-\u001f\u007f]" segment))))
               (str/split entry #"/" -1))))

(defn- directory-links [directory-cid directory-bytes]
  (let [data (decode-unixfs-data directory-cid directory-bytes)
        links (:links data)
        names (mapv :name links)]
    (when-not (= unixfs-directory-type (:type data))
      (refuse! :bundle-root-or-path-component-not-directory
               {:cid directory-cid :unixfs-type (:type data)}))
    (when-not (and (vector? links)
                   (every? (fn [{:keys [cid name]}]
                             (and (string? cid) (not-empty cid)
                                  (string? name) (not-empty name)
                                  (not (#{"." ".."} name))
                                  (not (re-find #"[/\\\u0000-\u001f\u007f]" name))))
                           links)
                   (= (count names) (count (set names))))
      (refuse! :invalid-unixfs-directory-links {:cid directory-cid}))
    links))

(defn- resolve-entry-cid [data-root bundle-cid entry-path budget]
  (when-not (= :dag-pb (cid-codec bundle-cid))
    (refuse! :bundle-root-must-be-dag-pb-directory {:cid bundle-cid}))
  (let [segments (vec (str/split entry-path #"/" -1))]
    (loop [current-cid bundle-cid
           remaining segments
           depth 0]
      (when (> depth maximum-directory-depth)
        (refuse! :bundle-directory-depth-limit
                 {:maximum maximum-directory-depth}))
      (let [node-bytes (read-block! data-root current-cid budget)
            links (directory-links current-cid node-bytes)
            child-name (first remaining)
            matches (filter #(= child-name (:name %)) links)]
        (when-not (= 1 (count matches))
          (refuse! :bundle-entry-path-not-found {:segment child-name}))
        (let [child-cid (:cid (first matches))]
          (if (= 1 (count remaining))
            child-cid
            (recur child-cid (subvec remaining 1) (inc depth))))))))

(defn- append-file! [data-root chunks total file-cid budget depth]
  (when (> depth maximum-file-depth)
    (refuse! :unixfs-file-depth-limit {:maximum maximum-file-depth}))
  (let [codec (cid-codec file-cid)
        block-bytes (read-block! data-root file-cid budget)]
    (case codec
      :raw
      (let [next-size (+ @total (.-byteLength block-bytes))]
        (when (> next-size maximum-entry-bytes)
          (refuse! :entry-size-limit {:maximum maximum-entry-bytes}))
        (swap! chunks conj block-bytes)
        (reset! total next-size))

      :dag-pb
      (let [data (decode-unixfs-data file-cid block-bytes)
            inline (as-buffer (or (:data data) []))
            links (:links data)
            block-sizes (vec (or (:blocksizes data) []))
            declared-size (:filesize data)
            start-size @total]
        (when-not (= unixfs-file-type (:type data))
          (refuse! :unixfs-entry-is-not-a-file
                   {:cid file-cid :unixfs-type (:type data)}))
        (when-not (and (vector? links)
                       (= (count links) (count block-sizes))
                       (every? #(and (integer? %) (not (neg? %))) block-sizes)
                       (integer? declared-size) (not (neg? declared-size))
                       (<= declared-size maximum-entry-bytes)
                       (= declared-size (+ (.-byteLength inline)
                                           (reduce + 0 block-sizes))))
          (refuse! :invalid-unixfs-file-size-metadata {:cid file-cid}))
        (when (> (+ start-size declared-size) maximum-entry-bytes)
          (refuse! :entry-size-limit {:maximum maximum-entry-bytes}))
        (when (pos? (.-byteLength inline))
          (swap! chunks conj inline)
          (swap! total + (.-byteLength inline)))
        (doseq [[link expected-size] (map vector links block-sizes)]
          (let [before @total]
            (append-file! data-root chunks total (:cid link) budget (inc depth))
            (when-not (= expected-size (- @total before))
              (refuse! :unixfs-child-size-mismatch
                       {:cid (:cid link) :expected expected-size}))))
        (when-not (= declared-size (- @total start-size))
          (refuse! :unixfs-file-size-mismatch {:cid file-cid})))

      (refuse! :unsupported-unixfs-file-codec {:cid file-cid :codec codec}))))

(defn materialize-entry
  "Read one manifest entry from previously staged UnixFS blocks.

  A raw bundle is one manifest entry. A DAG-PB bundle is a regular UnixFS
  directory. Only normal directories and raw/DAG-PB files are supported;
  HAMT directories and symlinks are refused."
  [data-root bundle-cid entry]
  (if-not (valid-entry-path? entry)
    {:decision :refuse :error :invalid-entry-path}
    (let [budget (atom 0)
          chunks (atom [])
          total (atom 0)]
      (try
        (let [codec (cid-codec bundle-cid)
              entry-cid (if (= :raw codec)
                          bundle-cid
                          (resolve-entry-cid data-root bundle-cid entry budget))
              bytes (if (= :raw codec)
                      (read-block! data-root entry-cid budget)
                      (do
                        (append-file! data-root chunks total entry-cid budget 0)
                        (.concat js/Buffer (clj->js @chunks) @total)))
              extension (some->> (last (str/split entry #"/" -1))
                                 (re-find #"\.[^.]+$")
                                 str/lower-case)]
          (when-not (contains? #{:raw :dag-pb} codec)
            (refuse! :unsupported-bundle-codec {:codec codec}))
          (when (> (.-byteLength bytes) maximum-entry-bytes)
            (refuse! :entry-size-limit {:maximum maximum-entry-bytes}))
          {:decision :materialized
           :bundle-cid bundle-cid
           :entry entry
           :entry-cid entry-cid
           :content-type (get content-types extension
                              "application/octet-stream")
           :byte-count (.-byteLength bytes)
           :block-count @budget
           :bytes bytes})
        (catch :default error
          {:decision :refuse
           :error (or (:reason (ex-data error)) :bundle-entry-unavailable)})))))
