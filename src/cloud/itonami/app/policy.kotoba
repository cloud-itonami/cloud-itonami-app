;; The routing policy's DECISION CORE — the part that is a judgement rather
;; than a lookup.
;;
;; `policy.cljc` keeps the halves that are not decisions: reading a provider out
;; of a config map, walking `:providers`, comparing ids. Those need maps and a
;; closure, and both are deliberately absent here. What is left is exactly two
;; questions — is this host loopback, and may this provider be used — and both
;; answer from scalars.
;;
;; `policy.cljc` CALLS this file (through `cloud.itonami.app.kotoba-oracle`,
;; from the shipped `resources/cloud/itonami/app/oracle/policy.kir.edn`), so
;; there is one implementation, not two kept in step. It was two until
;; 2026-08-11, bound by `policy-kotoba-parity-test`; before that test existed,
;; `policy.cljc` merely CLAIMED in a docstring to be
;; "the host-side mirror of policy.kotoba", while the two files did not share a
;; single function — this one exported a `select-provider-tier` that no caller
;; anywhere referenced, and the cljc's `provider-allowed?` had no counterpart.
;; A claimed mirror that nothing checks is two implementations, and only one of
;; them gets fixed.
;;
;; ## Why it is written this narrowly
;;
;; Everything here stays inside the native word-typed slice
;; (`kotoba.kir/only-native-word-typed-features?`): `:string` and `:bool`
;; scalars, a sealed all-scalar record, `string=?`, `or`, and `if`.
;;
;; Two things are avoided, and only two. **A set literal** — the three loopback
;; names would naturally be `#{...}` with `contains?`, and that is refused
;; (measured 2026-08-08: `operation has no admitted lowering`). **A bare
;; `:bool` parameter** — hence the record, rather than four boolean arguments;
;; compiler ADR 0219 records that refusal as "a real gap … in the INTERPRETER,
;; not in either backend".
;;
;; **Both are temporary, not a house style.** map, set and closure are
;; `:implemented-partial` on `#{:compiler :kotoba-wasm :kotoba-cljs}` and absent
;; on native only because the backend has not reached them (ADR-2608650000).
;;
;; `and` / `or` are NOT among the restrictions — they desugar to nested
;; `let`/`if` and compile on both native ISAs. Measured, because the first draft
;; of this file assumed otherwise and spelled both functions as `if` chains for
;; no reason. **Do not add a self-restriction here without compiling for
;; `:x86_64-kotoba-v1` first.** They return `:bool`, so a `:bool`-declared
;; function may return them directly.
;;
;; **Removal condition**: when the native backend admits set literals,
;; `loopback-host?` becomes a membership test, and when a bare `:bool`
;; parameter is admitted, `provider-allowed?` can take its four booleans
;; directly and the record goes away. Neither rewrite changes the decision, and
;; the parity test is what makes that safe to check.

(ns cloud.itonami.app.policy
  (:schemas {;; Everything `provider-allowed?` needs, flattened out of the maps
             ;; the cljc reads it from.
             ;;
             ;; `reviewed` is per PROVIDER and positive: somebody looked at
             ;; this destination and said yes. It replaced a global
             ;; `:allow-cloud-without-review?`, which could only ever express
             ;; the opposite — an operator who had actually reviewed one cloud
             ;; provider had no way to say so, and had to switch review off for
             ;; everything to use it. A gate whose only setting is "skip me" is
             ;; not a review gate.
             ;;
             ;; `no-egress` is the honest name for what used to be `local`. It
             ;; says the bytes do not leave this machine, which is a property;
             ;; "local" had come to mean "therefore trusted", which is not one.
             ;;
             ;; `egress-permitted` is the deployment-wide switch
             ;; (`[:routing :cloud-enabled?]`). Kept so an operator can forbid
             ;; ALL egress in one place regardless of what any provider claims.
             :policy/provider
             [:record :policy/provider
              [[:enabled :bool] [:reviewed :bool] [:no-egress :bool]
               [:egress-permitted :bool] [:confidential :bool]
               [:authenticated :bool]]]})
  (:export [loopback-host? provider-allowed?]))

;; The three spellings of "this machine". A set literal would be the natural
;; form; see the header for why it is a disjunction instead.
(defn loopback-host? [host :string] :bool
  (or (string=? host "127.0.0.1")
      (string=? host "localhost")
      (string=? host "::1")))

;; SECURITY FIRST — locality is evidence, not permission.
;;
;; Review is universal. Every provider needs somebody to have said yes to it,
;; including one on this machine: a process listening on 127.0.0.1 is not
;; trustworthy for being there, it is merely close. The previous rule admitted
;; any enabled loopback provider outright, which is the substitution this
;; application decided to stop making — "it did not leave the machine" and "it
;; is safe" are different sentences.
;;
;; Egress then adds what egress needs: the deployment permits it at all, the
;; transport is encrypted, and the request carries a credential. The last is
;; not about confidentiality — TLS already has that — but about the
;; destination being an account somebody holds rather than a URL somebody
;; typed.
;;
;; There is still no fallback from one provider to another: a provider that
;; fails any of this denies, it does not escalate.
(defn provider-allowed? [p [:ref :policy/provider]] :bool
  (and (record-get p :enabled)
       (record-get p :reviewed)
       (or (record-get p :no-egress)
           (and (record-get p :egress-permitted)
                (record-get p :confidential)
                (record-get p :authenticated)))))
