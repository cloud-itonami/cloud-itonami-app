;; Loopback server ENTRY — word-typed admission, not the HTTP listen.
;;
;; Public-language compile is wasm|web only (lang/cli.edn). Native sealed
;; KEXE is `amu compile --target aarch64-macos --jvm-free`. This file is
;; that entry. It does not listen: amu http-ingress is host-listen /
;; guest-poll and `:native-aot` is still pending (ADR-0038). The nbb host
;; in `bin/cloud-itonami-server` owns the socket and LOADS this wasm.
;;
;; Guest grammar is not Clojure. `server.clj` stays a leftover JVM
;; namespace; it is not admitted by rename.
;;
;; Production `deps.edn` still pins `io.github.kotoba-lang/kotoba` at
;; `:git/tag v0.6.29`. This entry is compiled by the public `bin/kotoba`
;; launcher (amu `--jvm-free` under it), not by bumping that pin.

(ns cloud.itonami.app.server-main
  (:export [main health-route? app-registry-route? platform-status-route?
            app-domain-proof-route? app-install-plan-route?
            app-content-stage-route? app-install-route? app-launch-route?
            app-operation-route? app-static-route? launcher-route?]))

(defn health-route? [method :string path :string] :bool
  (and (string=? method "GET")
       (string=? path "/health")))

(defn app-registry-route? [method :string path :string] :bool
  (and (string=? method "GET")
       (string=? path "/api/awai/app-registry")))

(defn platform-status-route? [method :string path :string] :bool
  (and (string=? method "GET")
       (string=? path "/api/awai/platform-status")))

(defn app-domain-proof-route? [method :string path :string] :bool
  (and (string=? method "GET")
       (string=? path "/api/awai/domain-proof")))

(defn app-install-plan-route? [method :string path :string] :bool
  (and (string=? method "POST")
       (string=? path "/api/awai/install-plan")))

(defn app-content-stage-route? [method :string path :string] :bool
  (and (string=? method "POST")
       (string=? path "/api/awai/install-content")))

(defn app-install-route? [method :string path :string] :bool
  (and (string=? method "POST")
       (string=? path "/api/awai/install")))

(defn app-launch-route? [method :string path :string] :bool
  (and (string=? method "POST")
       (string=? path "/api/awai/app-launch")))

(defn app-operation-route? [method :string path :string] :bool
  (and (string=? method "POST")
       (string=? path "/api/awai/app-operation")))

;; The Node host applies this guest admission only after recognizing an
;; app-id.localhost Host on its loopback listener. Any GET path is then
;; resolved through the installed, CID-verified app bundle; no API methods or
;; host effects are admitted on this separate app origin.
(defn app-static-route? [method :string path :string] :bool
  (string=? method "GET"))

(defn launcher-route? [method :string path :string] :bool
  (and (string=? method "GET")
       (or (string=? path "/")
           (string=? path "/awai-launcher.js"))))

;; Process start token the host already bound. Not guest listen.
;; 1338 is the loopback port the nbb host adapter opens.
;; Must not stay 0 — a zero main is an unused guest.
(defn main [] :i64
  1338)
