;; The Kanban transition table's DECISION CORE — which moves are legal, and
;; which states nothing leaves.
;;
;; `work_governance.cljc` keeps everything around it: `work-item` validation,
;; the `merge` that carries the caller's receipt or approval evidence, and the
;; `throw`. An exception is an effect and the core does not have effects — the
;; core decides, the host raises, which is the shape every extraction in this
;; repository takes.
;;
;; What is here is the table itself. It is a safety rule, not bookkeeping:
;; `done`, `rejected` and `cancelled` are terminal, and one wrong entry would
;; let a finished work item be leased and run again.
;;
;; Status codes are the host's translation of the keyword, in the order
;; `work-governance/work-statuses` declares them. The mapping stays cljc;
;; keywords do not cross this boundary.
;;
;; Written as one predicate per source state rather than a folded table, so
;; that adding a state is a visible edit here and in the parity corpus instead
;; of a silent omission from a chain.
;;
;; Parity: test/cloud/itonami/app/work_transitions_kotoba_parity_test.clj

(ns work-transitions-core
  (:export [status-backlog status-ready status-leased status-running
            status-held status-review status-done status-failed
            status-rejected status-cancelled
            status-count status-known? terminal? transition-legal?]))

(defn status-backlog [] :i64 0)
(defn status-ready [] :i64 1)
(defn status-leased [] :i64 2)
(defn status-running [] :i64 3)
(defn status-held [] :i64 4)
(defn status-review [] :i64 5)
(defn status-done [] :i64 6)
(defn status-failed [] :i64 7)
(defn status-rejected [] :i64 8)
(defn status-cancelled [] :i64 9)

(defn status-count [] :i64 10)

(defn status-known? [code :i64] :bool
  (and (>= code 0) (< code (status-count))))

(defn terminal? [code :i64] :bool
  ;; Nothing leaves these. An unknown code is NOT terminal -- it is unknown,
  ;; and `transition-legal?` refuses it on that ground instead, so the two
  ;; questions stay separate.
  (or (= code (status-done))
      (= code (status-rejected))
      (= code (status-cancelled))))

(defn- from-backlog? [to :i64] :bool
  (or (= to (status-ready)) (= to (status-cancelled))))

(defn- from-ready? [to :i64] :bool
  (or (= to (status-leased))
      (= to (status-held))
      (= to (status-cancelled))))

(defn- from-leased? [to :i64] :bool
  (or (= to (status-running))
      (= to (status-ready))
      (= to (status-failed))
      (= to (status-cancelled))))

(defn- from-running? [to :i64] :bool
  (or (= to (status-held))
      (= to (status-review))
      (= to (status-done))
      (= to (status-failed))
      (= to (status-cancelled))))

(defn- from-held? [to :i64] :bool
  (or (= to (status-ready))
      (= to (status-leased))
      (= to (status-running))
      (= to (status-rejected))
      (= to (status-cancelled))))

(defn- from-review? [to :i64] :bool
  (or (= to (status-done))
      (= to (status-held))
      (= to (status-failed))
      (= to (status-cancelled))))

(defn- from-failed? [to :i64] :bool
  (or (= to (status-ready)) (= to (status-cancelled))))

(defn transition-legal? [from :i64 to :i64] :bool
  ;; Unknown codes on either side are refused before the table is consulted --
  ;; a state nobody declared has no legal moves, in or out.
  (if (status-known? from)
    (if (status-known? to)
      (if (= from (status-backlog))
        (from-backlog? to)
        (if (= from (status-ready))
          (from-ready? to)
          (if (= from (status-leased))
            (from-leased? to)
            (if (= from (status-running))
              (from-running? to)
              (if (= from (status-held))
                (from-held? to)
                (if (= from (status-review))
                  (from-review? to)
                  (if (= from (status-failed))
                    (from-failed? to)
                    ;; done / rejected / cancelled
                    false)))))))
      false)
    false))
