;; The loopback workspace's appearance DECISION CORE — the three string
;; judgements inside `cloud.itonami.app.appearance` (`normalize`,
;; `next-mode`, `residency-plane`).
;;
;; `appearance.cljc` is mostly data and mechanism the native word-typed slice
;; deliberately refuses: the palette maps, the CSS layers (`css`,
;; `grok-css`), the hiccup `toggle-button`, the `modes` vector, and the
;; string PREPARATION steps (`keyword?` / `name`, `str`, `str/trim`,
;; `str/lower-case` — the case folding lives in the host, ADR-2609081000
;; note on mail_domain_records). All of that stays host.
;;
;; What moves here are the three DECISIONS about plain strings:
;;
;;   mode-of       — the normalize case table: which appearance a
;;                   (trimmed, lower-cased) name denotes, or none. The cljc's
;;                   `(case s ...)` group IS this function.
;;
;;   next-of       — the toggle cycle: light <-> dark, with unknown input
;;                   answering dark (the cycle restarts from light — the
;;                   cljc's `(or (normalize mode) default-mode)` with the
;;                   light successor IS this fallback). The authored
;;                   appearances are pruned from the cycle (owner instruction
;;                   2026-09-14); mode-of still recognises their spellings.
;;
;;   plane-cloud?  — the residency judgement: is this (trimmed, lower-cased)
;;                   plane name the cloud plane? The cljc's `(= "cloud" s)`
;;                   IS this predicate; the host maps the boolean to the
;;                   `:cloud` / `:local` keyword.
;;
;; The host prepares (keyword->name, trim, lower-case), the core decides.
;; Nil discipline (ADR-2609081000): a name the table does not contain
;; answers none for mode-of and false for plane-cloud? — never a throw and
;; never a guessed mode. A guessed appearance would render a mode the
;; stylesheet does not define; the core invents nothing.
;;
;; Parity: test/cloud/itonami/app/appearance_kotoba_parity_test.cljk
;; and ADR-2609082000.
(ns cloud.itonami.app.appearance-core
  (:export [mode-of next-of plane-cloud?]))

;; One `:string` name in, `[:option :string]` out: some of the canonical mode
;; that names it, none otherwise. `if` / `string=?` are the admitted scalar
;; vocabulary, and all fifteen spellings are written out as a total function
;; so the table needs no map. The host already trimmed and lower-cased.
;;
;; `dark` is the DADS palette inverted (`jp-go-dds.dark`), not a hand-drawn
;; theme, so it belongs to the same appearance axis as `light`. The authored
;; appearances (`8bit`, `grok` and their spellings, including `dark-chat` /
;; `chat-dark`) answer none since 2026-09-14 (owner instruction): a document
;; that names them still carries their CSS layers, but the configured mode
;; falls back to light and the toggle cycles light<->dark only.
(defn mode-of [name :string] [:option :string]
  (if (string=? name "dark")
    (option-some-of [:option :string] "dark")
    (if (string=? name "night")
      (option-some-of [:option :string] "dark")
  (if (string=? name "8bit")
    (option-none-of [:option :string])
    (if (string=? name "8-bit")
      (option-none-of [:option :string])
      (if (string=? name "eightbit")
        (option-none-of [:option :string])
        (if (string=? name "eight-bit")
          (option-none-of [:option :string])
          (if (string=? name "pixel")
            (option-none-of [:option :string])
            (if (string=? name "retro")
              (option-none-of [:option :string])
              (if (string=? name "grok")
                (option-none-of [:option :string])
                (if (string=? name "grob")
                  (option-none-of [:option :string])
                  (if (string=? name "dark-chat")
                    (option-none-of [:option :string])
                    (if (string=? name "chat-dark")
                      (option-none-of [:option :string])
                      (if (string=? name "light")
                        (option-some-of [:option :string] "light")
                        (if (string=? name "default")
                          (option-some-of [:option :string] "light")
                          (if (string=? name "dads")
                            (option-some-of [:option :string] "light")
                            (option-none-of [:option :string])))))))))))))))))

;; The toggle cycle as a total function: the mode AFTER the given canonical
;; mode, with the unknown-name fallback answering dark (host feeds
;; `(or (normalize mode) default-mode)` = "light", whose successor is "dark").
;;
;; `dark` sits directly after `light` because the two are one palette and its
;; inversion: one press answers the question a person actually has at night,
;; and the two authored appearances stay further along the cycle where they
;; were. Moving them would change what an existing press does.
(defn next-of [mode :string] :string
  (if (string=? mode "light")
    "dark"
    "light"))

;; The residency-plane judgement: a (trimmed, lower-cased) plane name is the
;; cloud plane exactly when it is "cloud". Anything else — absent, a typo,
;; empty — is local, not a crash. The host maps this boolean to the
;; `:cloud` / `:local` keyword the workspace renders.
(defn plane-cloud? [name :string] :bool
  (string=? name "cloud"))