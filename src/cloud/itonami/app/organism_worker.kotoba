;; The organism worker's DECISION CORE — the ORDER in which an intent is
;; refused, and what "required" means for a field.
;;
;; `organism_worker.cljc` keeps everything that touches a map or a set:
;; `assignment` (which validates authority declarations against
;; `organism-owned-authorities`), `public-assignment` (a `select-keys`
;; projection), and the assembly of the returned intent map. It also keeps every
;; `throw`. The core decides; the host raises.
;;
;; ## Why the order is the thing worth extracting
;;
;; `intent-decision` refuses for six different reasons, and the `cond` that
;; picks between them is ordered. Reorder two clauses and every rejected intent
;; is still rejected — the caller still sees `:intent/status :rejected` — but
;; the REASON changes, and the reason is what an operator reads to decide
;; whether a worker is misconfigured, out of scope, or simply expired. That is a
;; defect no status-level test would see, which is exactly what a parity gate is
;; for. `rejection-reason` is covered over the full cross-product in
;; `organism-worker-kotoba-parity-test`.
;;
;; ## What crosses the boundary
;;
;; The core takes ALREADY-DECIDED predicates, not the maps they came from:
;; `capability-granted` is a set membership the cljc performs, and
;; `organization-matches` / `worker-matches` are string comparisons it performs.
;; The core does not re-derive them, so it is not a second implementation of
;; them — it owns the precedence and nothing else. `expires-at` and `now-ms`
;; cross as `:i64` because the comparison between them IS part of the
;; precedence: an intent with no expiry and an intent already past it are the
;; same reason, and that equivalence lives here.
;;
;; ## The native slice
;;
;; Compiles for `:wasm32-kotoba-v1`, `:js-kotoba-v1`, `:x86_64-kotoba-v1` and
;; `:aarch64-kotoba-v1`. A `:keyword` result is a native word (a pair handle
;; over its printed text), which is what lets the reason stay a reason rather
;; than becoming an integer code the host has to map back.
;;
;; Temporary spellings, as everywhere in this migration (ADR-2608650000):
;; `option-some?-of` / `option-value-of` carry an explicit `[:option :string]`
;; because the bare forms are typed `option-i64`, and `and` is folded through
;; `if` because it produces `:i64` rather than `:bool`.

(ns cloud.itonami.app.organism-worker
  (:schemas {;; Not the assignment and not the intent — the predicates the
             ;; precedence is over. Keeping this record narrow is what stops it
             ;; becoming a third copy of the assignment schema.
             :ao/intent-check
             [:record :ao/intent-check
              [[:status-active :bool]
               [:has-id :bool]
               [:has-issued-by :bool]
               [:organization-matches :bool]
               [:worker-matches :bool]
               [:capability-granted :bool]
               [:has-expires-at :bool]
               [:expires-at :i64]
               [:now-ms :i64]]]})
  (:export [required-value-present? rejection-reason]))

;; `require-value` in the cljc refuses nil and the empty string, and accepts
;; anything else. This is the string half of that rule, and since 2026-08-11
;; the cljc CALLS it (through `cloud.itonami.app.kotoba-oracle`) rather than
;; repeating it; the cljc keeps the `throw`, which is not a decision, and keeps
;; accepting non-string values, which do not reach here.
(defn required-value-present? [v [:option :string]] :bool
  (if (option-some?-of [:option :string] v)
    (if (string=? (option-value-of [:option :string] v "") "")
      false
      true)
    false))

;; The precedence, in the cljc's order. `:admitted` rather than a nil-shaped
;; absence, because a keyword result has no nil.
;;
;; Expiry is last on purpose: an intent that is out of scope for this worker
;; should say so even when it also happens to be expired.
(defn rejection-reason [c [:ref :ao/intent-check]] :keyword
  (if (record-get c :status-active)
    (if (and (record-get c :has-id) (record-get c :has-issued-by))
      (if (record-get c :organization-matches)
        (if (record-get c :worker-matches)
          (if (record-get c :capability-granted)
            (if (and (record-get c :has-expires-at)
                     (> (record-get c :expires-at) (record-get c :now-ms)))
              :admitted
              :intent-expired)
            :capability-not-granted)
          :worker-boundary)
        :organization-boundary)
      :invalid-intent)
    :worker-not-active))
