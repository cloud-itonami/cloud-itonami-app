;; PEER Bots' DECISION CORE — named durable teammates, not subagents.
;;
;; Grok Bots' public semantics (not an internal protocol): each Bot is a
;; named persistent peer with its own conversation and memory, and they
;; coordinate by message. The computer is shared; cognition is not.
;; `handoff_core.kotoba` is the other door — a bounded work-transfer with a
;; depth ceiling. This file is the peer door. A message is not a chain hop.
;;
;; ## The mechanism is an absence
;;
;; `:peer/pair` has no tool, no grant, no scope, no account, no task text,
;; and no depth. Handing a colleague a note must not hand them your reach,
;; and it must not be budgeted as if it were delegation: two Bots talking
;; is the point of having two, and a depth ceiling on talk would make
;; persistent peers into a finite subroutine. Grants stay out of the record
;; for the same reason they stay out of a handoff — there is nothing here
;; to copy.
;;
;; ## The four judgements
;;
;;   - `may-message?` — a note crossing between two people's Bots, or to a
;;     Bot that is not actually another Bot. `same-owner` is first because
;;     it is the boundary that is not recoverable.
;;   - `computer-shared?` — the work environment. Same person, same
;;     computer (files, cookies, logins). Different people stay apart.
;;     Enabled-ness is not an input: a paused Bot's sign-in is still that
;;     person's sign-in.
;;   - `foreign-memory?` — cognition. Distinct Bots do not read each
;;     other's memory. The computer being shared is exactly why this
;;     refusal has to exist; without it, shared files would be the honest
;;     path and memory the silent one.
;;   - `may-approve?` — restated on this path so a Bot cannot approve by
;;     DMing a held run to a second Bot and having that one say yes.
;;
;; Same native word-typed slice as `handoff_core.kotoba`.
;;
;; Parity: test/cloud/itonami/app/peer_kotoba_parity_test.clj

(ns peer-core
  (:schemas {;; What the host has established about two Bots.
             ;;
             ;; Deliberately absent: tools, grants, accounts, task text,
             ;; depth. `distinct-bots` is a host fact, not derived from
             ;; ids, because no id crosses this boundary either.
             :peer/pair
             [:record :peer/pair
              [[:same-owner :bool]
               [:source-enabled :bool]
               [:target-enabled :bool]
               [:distinct-bots :bool]]]
             :peer/decision
             [:record :peer/decision
              [[:human :bool]
               [:identified :bool]
               [:authorized :bool]]]
             ;; Where a Bot is, when the owner has more than one machine
             ;; (ADR-0062). Same five absences as `:peer/pair` -- no tool, no
             ;; grant, no account, no task text -- plus one more that is the
             ;; whole point: there is no field for the REMOTE machine's policy,
             ;; because nothing here decides what may happen there.
             ;;
             ;; `device-known` is registration on the messenger plane, which
             ;; means the device already published Signal material under this
             ;; principal. A device nobody registered is not addressable: there
             ;; is no discovery step, and a handle is not a guess.
             :peer/reach
             [:record :peer/reach
              [[:same-owner :bool]
               [:target-enabled :bool]
               [:device-known :bool]
               [:device-is-local :bool]
               [:remote-enabled :bool]]]})
  (:export [may-message? computer-shared? foreign-memory? may-approve?
            may-address? reaches-another-machine? main]))

(defn may-message? [r [:ref :peer/pair]] :bool
  ;; Ownership first and alone, then both live, then the two are actually
  ;; two. Nested `if` rather than one conjunction so each refusal is a
  ;; separate line.
  (if (record-get r :same-owner)
    (if (record-get r :source-enabled)
      (if (record-get r :target-enabled)
        (record-get r :distinct-bots)
        false)
      false)
    false))

(defn computer-shared? [r [:ref :peer/pair]] :bool
  ;; Same person, same computer. A disabled Bot does not get a private
  ;; cookie jar; the computer belongs to the owner.
  (record-get r :same-owner))

(defn foreign-memory? [r [:ref :peer/pair]] :bool
  ;; Distinct Bots. The host refuses to let one read the other's durable
  ;; notes. Same Bot asking about itself is not foreign.
  (record-get r :distinct-bots))

(defn may-approve? [d [:ref :peer/decision] actor-kind :string] :bool
  ;; Identical construction to `handoff_core/may-approve?`. The actor kind
  ;; is tested FIRST and ALONE.
  ;;
  ;; This is NOT the judgement ADR-0060 lifted, and the flat `false` here is
  ;; deliberate rather than left behind. `bot_core/may-approve?` answers "may
  ;; this actor decide a card on the Bot it is acting as", and since ADR-0060 a
  ;; delegated agent may. This one answers a different question: may a message
  ;; that ARRIVED FROM ANOTHER BOT stand in for approval of this Bot's held run.
  ;; No delegation makes that true. A person delegates to one Bot, not to
  ;; whatever that Bot is willing to relay -- and a peer path that accepted it
  ;; would turn one delegation into a way to approve every Bot the owner has.
  (if (string=? actor-kind "agent")
    false
    (and (record-get d :human)
         (record-get d :identified)
         (record-get d :authorized))))

(defn reaches-another-machine? [r [:ref :peer/reach]] :bool
  ;; A handle that names a device other than this one. Separate from
  ;; `may-address?` because the host needs the fact even when the answer to
  ;; addressing is no -- "that Bot is on your other machine" and "there is no
  ;; such Bot" are different things to tell a person.
  (not (record-get r :device-is-local)))

(defn may-address? [r [:ref :peer/reach]] :bool
  ;; Ownership first and alone, as everywhere on this path. Then the target is
  ;; live. Then, and only then, where it is.
  ;;
  ;; `device-is-local` is asked BEFORE `device-known`, and the first order did
  ;; it the other way. The parity corpus caught it: the host never produces
  ;; `device-known false` with `device-is-local true`, because the machine you
  ;; are on is known by being the machine you are on -- so the core was
  ;; refusing a combination the host could not hand it, which is a trap for the
  ;; next host rather than a rule. Registration is a question about somewhere
  ;; else.
  ;;
  ;; The deployment switch is read LAST and only on the remote branch, so
  ;; turning remote addressing on cannot rescue a handle that failed anything
  ;; before it, and turning it off cannot stop a person addressing the Bots on
  ;; the machine they are sitting at.
  (if (record-get r :same-owner)
    (if (record-get r :target-enabled)
      (if (record-get r :device-is-local)
        true
        (if (record-get r :device-known)
          (record-get r :remote-enabled)
          false))
      false)
    false))

(defn main [] :i64
  0)
