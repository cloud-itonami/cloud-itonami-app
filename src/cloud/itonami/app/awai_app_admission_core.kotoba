;; Shared admission precedence for externally published Awai apps.
;;
;; DNSSEC, registry/current-ref verification, content CID reads, local storage,
;; and user consent remain host ports. This core makes the final lifecycle
;; admission decision from their normalized facts so every product app uses
;; the same rule.
(ns cloud.itonami.app.awai-app-admission-core
  (:schemas {:awai-app-admission/resolve
             [:record :awai-app-admission/resolve
              [[:dns-proof-fresh :bool]
               [:amano-state :i64]]]
             :awai-app-admission/finish-install
             [:record :awai-app-admission/finish-install
              [[:prepared :bool]
               [:install-lock-valid :bool]
               [:runtime-inputs-valid :bool]
               [:clock-valid :bool]
               [:dns-proof-valid :bool]
               [:amano-state :i64]
               [:content-complete :bool]
               [:capabilities-approved :bool]]]})
  (:export [resolve-admission-code finish-install-admission-code main]))

;; Result codes are stable host ABI values:
;; resolve: 0 admitted, 1 DNS proof invalid, 2 Amano proof unavailable,
;;          3 Amano proof invalid.
(defn resolve-admission-code
  [input [:ref :awai-app-admission/resolve]] :i64
  (if (not (record-get [:ref :awai-app-admission/resolve] input :dns-proof-fresh))
    1
    (if (= 0 (record-get [:ref :awai-app-admission/resolve] input :amano-state))
      2
      (if (= 1 (record-get [:ref :awai-app-admission/resolve] input :amano-state))
        3
        (if (= 2 (record-get [:ref :awai-app-admission/resolve] input :amano-state))
          0
          3)))))

;; Result codes preserve the lifecycle's established fail-closed precedence:
;; 0 admitted, 1 not prepared, 2 bad install lock, 3 bad runtime inputs,
;; 4 bad clock, 5 expired/mismatched DNS proof, 6 Amano proof unavailable,
;; 7 Amano proof invalid, 8 content incomplete, 9 unapproved capability.
(defn finish-install-admission-code
  [input [:ref :awai-app-admission/finish-install]] :i64
  (if (not (record-get [:ref :awai-app-admission/finish-install] input :prepared))
    1
    (if (not (record-get [:ref :awai-app-admission/finish-install] input :install-lock-valid))
      2
      (if (not (record-get [:ref :awai-app-admission/finish-install] input :runtime-inputs-valid))
        3
        (if (not (record-get [:ref :awai-app-admission/finish-install] input :clock-valid))
          4
          (if (not (record-get [:ref :awai-app-admission/finish-install] input :dns-proof-valid))
            5
            (if (= 0 (record-get [:ref :awai-app-admission/finish-install] input :amano-state))
              6
              (if (= 1 (record-get [:ref :awai-app-admission/finish-install] input :amano-state))
                7
                (if (not (= 2 (record-get [:ref :awai-app-admission/finish-install] input :amano-state)))
                  7
                  (if (not (record-get [:ref :awai-app-admission/finish-install] input :content-complete))
                    8
                    (if (not (record-get [:ref :awai-app-admission/finish-install] input :capabilities-approved))
                      9
                      0)))))))))))

(defn main [] :i64 0)
