;; Pure authorization policy ported from aozora.pds.agent-biscuit/authorize-op.
;; The host supplies facts only after Biscuit verification and capability
;; normalization. This kernel does not parse tokens, verify signatures, or
;; perform XRPC/storage effects.
;;
;; ABI: repo-post, repo-write, account-bind, op, repo-match, collection.
;; Capability and repo-match values are 0/1. Operation codes:
;; 0 createRecord, 1 putRecord, 2 deleteRecord, 3 applyWrites,
;; 4 uploadBlob, 5 createAccount, 6 updateHandle; collection 1 is
;; app.bsky.feed.post. Result: 0 allow, 1 unsupported route,
;; 2 repo mismatch, 3 capability/collection refusal.
(ns aozora.pds.agent-biscuit-admission-core
  (:schemas {:aozora/authorization-input
             [:record :aozora/authorization-input
              [[:repo-post :i64]
               [:repo-write :i64]
               [:account-bind :i64]
               [:op-code :i64]
               [:repo-match :i64]
               [:collection-code :i64]]]})
  (:export [authorize-op-code main]))

(defn- binary-code? [value]
  (or (= value 0) (= value 1)))

(defn- repo-bound-op? [op-code]
  (and (not= op-code 4)
       (not= op-code 5)
       (not= op-code 6)))

(defn- operation-allowed? [repo-post repo-write account-bind op-code]
  (cond
    (= op-code 0) (or (= repo-post 1) (= repo-write 1))
    (or (= op-code 1) (= op-code 2) (= op-code 3)) (= repo-write 1)
    (= op-code 4) (or (= repo-post 1) (= repo-write 1))
    (or (= op-code 5) (= op-code 6)) (= account-bind 1)
    :else false))

(defn authorize-op-code
  [input [:ref :aozora/authorization-input]] :i64
  (let [repo-post (record-get [:ref :aozora/authorization-input] input :repo-post)
        repo-write (record-get [:ref :aozora/authorization-input] input :repo-write)
        account-bind (record-get [:ref :aozora/authorization-input] input :account-bind)
        op-code (record-get [:ref :aozora/authorization-input] input :op-code)
        repo-match (record-get [:ref :aozora/authorization-input] input :repo-match)
        collection-code (record-get [:ref :aozora/authorization-input] input :collection-code)]
    (cond
      (or (< op-code 0) (> op-code 6)) 1
      (or (not (binary-code? repo-post))
          (not (binary-code? repo-write))
          (not (binary-code? account-bind))
          (not (binary-code? repo-match))) 3
      (and (repo-bound-op? op-code) (= repo-match 0)) 2
      (not (operation-allowed? repo-post repo-write account-bind op-code)) 3
      (and (= op-code 0)
           (= repo-post 1)
           (= repo-write 0)
           (not= collection-code 1)) 3
      :else 0)))

(defn main [] :i64 0)
