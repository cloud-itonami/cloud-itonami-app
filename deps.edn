  ;; The suite writes through cloud.itonami.app.store, which persists to
  ;; `cloud.itonami.app.config/data-dir`. Without this it defaults to `./data`
  ;; and the tests overwrite the real store -- measured on 2026-07-30, when a
  ;; fixture replaced a developer's identity state and broke Passkey
  ;; registration. The property beats the environment variable on purpose, so
  ;; an exported CLOUD_ITONAMI_DATA_DIR cannot redirect the suite back onto a
  ;; real store.
  ;; Regenerate the shipped decision-core KIR. Combine with :test, which
  ;; carries the compiler; a later alias's :main-opts wins:
  ;;
  ;;   clojure -M:test:gen
  :gen {:main-opts ["-m" "cloud.itonami.app.kotoba-oracle-gen"]}
  :test {:extra-paths ["test"]
         :extra-deps {datascript/datascript {:mvn/version "1.7.8"}
                      ;; JVM host for kexe artifacts. TEST-ONLY: the default
                      ;; suite now runs a one-core native canary
                      ;; (`native-canary-test`). `native-exec` resolves
                      ;; `kototama.native.executor` at call time, so nothing
                      ;; that only runs the KIR interpreter inherits it.
                      ;; Production `kotoba-oracle/call` stays on the
                      ;; interpreter (ADR-0037). `tender-native` redirects here.
                      io.github.kotoba-lang/kototama-native
                      {:git/url "https://github.com/kotoba-lang/kototama-native.git"
                       :git/sha "e52b41a68481033f40a511185e3347633612169a"}}
         ;; `kotoba-lang/compiler` is TEST-ONLY here, for the decision-core
         ;; parity gate (`policy-kotoba-parity-test` over
         ;; `src/cloud/itonami/app/policy.kotoba`). No `src/` namespace requires
         ;; the COMPILER, so this override cannot change what the application
         ;; does.
         ;;
         ;; The 2026-08-08 measurement that used to be quoted here said "zero
         ;; matches for `kotoba.compiler` / `kotoba.kir` outside the test". Half
         ;; of that stopped being true on 2026-08-11: `kotoba-oracle` requires
         ;; `kotoba.kir` from `src/`, so the INTERPRETER is a production
         ;; dependency and lives in `:deps` above. Only the compiler is
         ;; test-only. Left corrected rather than deleted because the same
         ;; sentence, still believed, is why `services/app-edge` was not given
         ;; the interpreter and could not build for a day.
         ;;
         ;; It is an OVERRIDE rather than an addition because `kotoba` already
         ;; brings a compiler transitively, at `94f29b24`. That pin is profile-4
         ;; era and CANNOT express the decision core: `:schemas` is refused in ns
         ;; clauses ("only a bounded :export vector is admitted"), entryless
         ;; libraries are refused off the kotoba-script web target, and
         ;; `string=?` still returns i64 so a `:bool` result is a type mismatch.
         ;; All three measured directly against it on 2026-08-08.
         ;;
         ;; Pinned to amu `1644b32`, which carries kotoba-sema `1b83233`.
         ;; That rewrite lets `fleet_core.kotoba` write `option-some?` on
         ;; `[:option :string]` instead of `option-some?-of`. `compiler.git`
         ;; redirects at GitHub to `kotoba-lang/amu`.
         ;;
         ;; `io-multiformats` is named here for a reason that is not optional.
         ;; The compiler pin above drags its own, OLDER `io-multiformats`
         ;; (`b3b157e6`) into the tree, and resolution silently preferred it over
         ;; the `dc520032` this app already resolves — which removed
         ;; `mf/sha384` and made `org-w3-rdf-canon` fail to LOAD, so the entire
         ;; test suite died before a single assertion ran. Measured 2026-08-08:
         ;; `clojure -M:test -e "(println :ok)"` → `No such var: mf/sha384`.
         ;; Holding it at the app's own pin keeps the parity gate from changing
         ;; what every other test in this repo is compiled against.
         ;;
         ;; `io-ipld` is the same class of hold. Compiler 1644b32 names
         ;; `14b53ae` (`ipld.link` → `multiformats.base32`). Newest-wins
         ;; would replace chain's hasher pin `45917645` (uses
         ;; `multiformats.core`). `14b53ae` cannot load against the
         ;; `dc520032` override: that pin folded base32 into core and has
         ;; no `multiformats.base32` ns. Compiler source does not require
         ;; ipld; chain.core/commit! does.
         :override-deps
         {io.github.kotoba-lang/compiler
          {:git/url "https://github.com/kotoba-lang/compiler.git"
           :git/sha "1644b326eefa0951a6343cee9aff88fe9ba745e2"}
          ;; kototama-native's own deps.edn names a newer kir. Newest-wins
          ;; would silently upgrade the interpreter every test loads, and
          ;; the shipped `*.kir.edn` were emitted for this pin. Hold it.
          io.github.kotoba-lang/kotoba-kir
          {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
           :git/sha "da24cae65e82f91352c5b96b0c58f21a52911277"}
          io.github.kotoba-lang/io-multiformats
          {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
           :git/sha "e7ae323d3ccbb9aacc92edfd2f3dda20d9b90eed"}
          io.github.kotoba-lang/io-ipld
          {:git/url "https://github.com/kotoba-lang/io-ipld.git"
           :git/sha "c7b8f76b707ec22fa1692907201d44db54d98f13"}}
         :jvm-opts ["-Dcloud.itonami.data-dir=target/test-data"]
         :main-opts ["-m" "cloud.itonami.app.test-runner"]}
