{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/data.json {:mvn/version "2.5.1"}
  com.fasterxml.jackson.dataformat/jackson-dataformat-cbor
  {:mvn/version "2.22.1"}
  com.yubico/webauthn-server-core {:mvn/version "2.9.0"}

  io.github.kotoba-lang/shell
  {:git/url "https://github.com/kotoba-lang/shell.git"
   :git/sha "b2118bafb83f74a1d3c67e91314f67be87125df2"}
  io.github.kotoba-lang/kotoba
  {:git/url "https://github.com/kotoba-lang/kotoba.git"
   :git/tag "v0.6.29"
   :git/sha "42ae4941089a5be3d06e46d440680589e781f19f"}
  io.github.kotoba-lang/calendar
  {:git/url "https://github.com/kotoba-lang/calendar.git"
   :git/sha "2d9b9fc5efe80ea42afaa30bbdf8915fe4d9540f"}
  io.github.kotoba-lang/mail
  {:git/url "https://github.com/kotoba-lang/mail.git"
   :git/sha "2a00bd8d63842dd2d1cf38d35bfb66ae377e98dc"}
  ;; advanced from 90eac285 (fast-forward): that pin predates
  ;; drive/object.cljc, which is the IObjectStore seam this app now fills. The
  ;; :dev alias overrides this to a :local/root, so this gap only appears in a
  ;; plain `-M:test` run — which is how it appeared: filecoin.clj is already on
  ;; main (landed as untracked WIP) and cannot load there.
  io.github.kotoba-lang/drive
  {:git/url "https://github.com/kotoba-lang/drive.git"
   :git/sha "54d7aeface7135b572c9cccfc03ef7a31a7344be"}

  ;; The three document surfaces the Drive can create. Each is a portable
  ;; model plus an office-envelope wire namespace, and nothing in any of them
  ;; knows about drive — `cloud.itonami.app.documents` is where they meet,
  ;; which is the same arrangement as the object stores above.
  io.github.kotoba-lang/sheets
  {:git/url "https://github.com/kotoba-lang/sheets.git"
   :git/sha "998a4da40d2acf3e652a1d0193ef491a54a57345"}
  io.github.kotoba-lang/docs
  {:git/url "https://github.com/kotoba-lang/docs.git"
   :git/sha "baa1308f31925a44c904ae63d3eeb17024252834"}
  io.github.kotoba-lang/forms
  {:git/url "https://github.com/kotoba-lang/forms.git"
   :git/sha "531d4fc9dc429e1685d070ea56d5dbdaf3a0dd00"}
  ;; The fourth surface. Heavier than its siblings — it brings office, ooxml,
  ;; drawingml, presentationml, office-style, canvaskit, css, xml and the
  ;; kotoba-ui stack, because `slides` is also a Pages application and not
  ;; only a model. This app requires three of its namespaces (model, wire,
  ;; validate) and none of the rest; the cost is fetch time and classpath,
  ;; not code that runs.
  io.github.kotoba-lang/slides
  {:git/url "https://github.com/kotoba-lang/slides.git"
   :git/sha "f6a0f9cdea18519af2feb17d16d014c894ba04c5"}
  ;; Named directly even though all three now agree on it. They agree because
  ;; sheets and docs were advanced off 77e3ce7d for the rehydrate work; before
  ;; that they pinned the last commit before the wire moved to plain JSON and
  ;; forms pinned the current one, and resolution picked a winner without
  ;; being asked. Saying which one means that does not happen again silently.
  io.github.kotoba-lang/transit
  {:git/url "https://github.com/kotoba-lang/transit.git"
   :git/sha "ab5d9d956e088d77d7f91357f36a4a0c6bdfcadc"}

  ;; The records-and-reachability authorities the authority adapters pre-check
  ;; against. The app is a consent surface, so it must be able to answer "is this
  ;; even reachable?" locally and deterministically -- and it must answer it with
  ;; the SAME table the governed actor enforces, not a second copy. esim brings
  ;; card and phone transitively; card is named directly because
  ;; cloud.itonami.app.authority.card requires it by itself.
  io.github.kotoba-lang/esim
  {:git/url "https://github.com/kotoba-lang/esim.git"
   :git/sha "7bfa343adad0c60282c5fde104e45c083d1df57d"}
  io.github.kotoba-lang/card
  {:git/url "https://github.com/kotoba-lang/card.git"
   :git/sha "488ec3252086380aeaad46d94d47766500ecb425"}
  ;; Storj as an IObjectStore. Its store-fns produce exactly the four-function
  ;; map drive.object/store-of takes, and neither library depends on the other
  ;; — this app depends on both, which is the arrangement both docstrings name.
  io.github.kotoba-lang/io-storj
  {:git/url "https://github.com/kotoba-lang/io-storj.git"
   :git/sha "daa038ba72fd515452d0f4091298568755a39ec9"}
  ;; the other end: running a node rather than using a bucket. See
  ;; cloud.itonami.app.storj-node for the two gates before it can join the
  ;; public network — neither of them is code.
  io.github.kotoba-lang/io-storj-node
  {:git/url "https://github.com/kotoba-lang/io-storj-node.git"
   :git/sha "a9c81cc4a8704f87f059a1972fcf1ac49f9e10b1"}
  io.github.kotoba-lang/identity
  {:git/url "https://github.com/kotoba-lang/identity.git"
   :git/sha "5cf94e38c816ced6857ef62de344f6adea9fc050"}
  ;; The MCP protocol kernel (manifest model + pure JSON-RPC dispatcher) behind
  ;; `cloud.itonami.app.mcp`. Zero runtime deps of its own, so this adds the
  ;; protocol and nothing else; the tools it serves are already in `fleet`.
  io.github.kotoba-lang/org-anthropic-mcp
  {:git/url "https://github.com/kotoba-lang/org-anthropic-mcp.git"
   :git/sha "9b343e64139763d66c2a3969669bc03f73b32a46"}
  io.github.kotoba-lang/oauth
  {:git/url "https://github.com/kotoba-lang/oauth.git"
   :git/sha "e47999a48cbc79e831c0690bac6681bda0b52785"}
  io.github.kotoba-lang/com-github
  {:git/url "https://github.com/kotoba-lang/com-github.git"
   :git/sha "5beea7514b4791f6aae33cb0b75d49f0ec53437c"}
  io.github.kotoba-lang/jp-go-digital-design-system
  {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
   :git/sha "277e8c38648a3030014637d11fcbefc4f5535ae7"}

  ;; Filecoin: PieceCID v2 addressing + the on-chain read surface + the
  ;; provider transfer surface. Deliberately NOT a storage backend — see
  ;; cloud.itonami.app.filecoin for exactly what is and is not implemented.
  ;; `drive` depends on neither and neither depends on `drive`; this app
  ;; depends on both, which is what drive.object/store-of's docstring
  ;; prescribes.
  io.github.kotoba-lang/cloud-filecoin
  {:git/url "https://github.com/kotoba-lang/cloud-filecoin.git"
   :git/sha "67147752a8486715f2e049756446a92ffe0816f5"}
  io.github.kotoba-lang/io-filecoin-transport
  {:git/url "https://github.com/kotoba-lang/io-filecoin-transport.git"
   :git/sha "b0f434c81f778c00321af9572da2346a5e0fc5c7"}}

 :aliases
 {:server {:main-opts ["-m" "cloud.itonami.app.server"]}
  ;; The MCP server speaks JSON-RPC on stdout, so nothing else may print there:
  ;; run it with this alias, never alongside :server in one process.
  :mcp {:main-opts ["-m" "cloud.itonami.app.mcp"]}
  ;; The suite writes through cloud.itonami.app.store, which persists to
  ;; `cloud.itonami.app.config/data-dir`. Without this it defaults to `./data`
  ;; and the tests overwrite the real store -- measured on 2026-07-30, when a
  ;; fixture replaced a developer's identity state and broke Passkey
  ;; registration. The property beats the environment variable on purpose, so
  ;; an exported CLOUD_ITONAMI_DATA_DIR cannot redirect the suite back onto a
  ;; real store.
  :test {:extra-paths ["test"]
         :jvm-opts ["-Dcloud.itonami.data-dir=target/test-data"]
         :main-opts ["-m" "cloud.itonami.app.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  ;; West/sibling workspace development only. Release and CI never use this.
  :dev
  {:override-deps
   {io.github.kotoba-lang/shell {:local/root "../../kotoba-lang/shell"}
    io.github.kotoba-lang/kotoba {:local/root "../../kotoba-lang/kotoba"}
    io.github.kotoba-lang/calendar {:local/root "../../kotoba-lang/calendar"}
    io.github.kotoba-lang/mail {:local/root "../../kotoba-lang/mail"}
    io.github.kotoba-lang/drive {:local/root "../../kotoba-lang/drive"}
    io.github.kotoba-lang/sheets {:local/root "../../kotoba-lang/sheets"}
    io.github.kotoba-lang/esim {:local/root "../../kotoba-lang/esim"}
    io.github.kotoba-lang/card {:local/root "../../kotoba-lang/card"}
    io.github.kotoba-lang/docs {:local/root "../../kotoba-lang/docs"}
    io.github.kotoba-lang/forms {:local/root "../../kotoba-lang/forms"}
    io.github.kotoba-lang/transit {:local/root "../../kotoba-lang/transit"}
    io.github.kotoba-lang/identity {:local/root "../../kotoba-lang/identity"}
    io.github.kotoba-lang/oauth {:local/root "../../kotoba-lang/oauth"}
    io.github.kotoba-lang/com-github {:local/root "../../kotoba-lang/com-github"}
    io.github.kotoba-lang/jp-go-digital-design-system
    {:local/root "../../kotoba-lang/jp-go-digital-design-system"}}}}}
