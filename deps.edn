  ;; scripts/verify-itonami-run-path.cljs: configured-launch-alias-absent).
  ;; These aliases name the production run path until the nbb host is actually
  ;; proven live; delete them again only after that flip is real.
  :server {:main-opts ["-m" "cloud.itonami.app.server"]}
  ;; The MCP server speaks JSON-RPC on stdout, so nothing else may print there:
  ;; run it with this alias, never alongside :server in one process.
  :mcp {:main-opts ["-m" "cloud.itonami.app.mcp"]}
  ;; The launcher test asserts these aliases are gone; the restore above is
  ;; deliberate and documented. Keep the two facts from contradicting each
